---
import { business } from '@/data/business';
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-grid">
      <!-- Col 1: Brand & Bio -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo">
          <div class="logo-crest">
            <img src="/assets/images/siddhu-logo-new.jpg" alt="SIDDHU Logo" width="38" height="38" />
          </div>
          <div class="logo-text">
            <span class="logo-brand">SIDDHU <span class="highlight-gold">PROPERTY</span></span>
            <span class="logo-sub">REAL ESTATE ADVISOR</span>
          </div>
        </a>
        <p class="footer-bio">
          Independent local real estate advisory in Tehsil Chichawatni, Punjab. Led by <strong>Naeem Siddhu</strong>, connecting genuine buyers and sellers with verified land records, on-ground inspections, and honest consultation.
        </p>
        <div class="footer-socials">
          <a href={business.whatsappUrl} target="_blank" rel="noopener" aria-label="WhatsApp Naeem Siddhu" class="social-link whatsapp">
            <i class="fa-brands fa-whatsapp"></i>
          </a>
          <a href={business.facebookUrl} target="_blank" rel="noopener" aria-label="Facebook Page" class="social-link facebook">
            <i class="fa-brands fa-facebook-f"></i>
          </a>
          <a href={business.googleBusinessProfileUrl} target="_blank" rel="noopener" aria-label="Google Business Profile" class="social-link google">
            <i class="fa-brands fa-google"></i>
          </a>
        </div>
      </div>

      <!-- Col 2: Real Estate Quick Links -->
      <div class="footer-col">
        <h4 class="footer-heading">Properties & Market</h4>
        <ul class="footer-links">
          <li><a href="/#properties">Residential Houses for Sale</a></li>
          <li><a href="/#areas">Interactive Market Map</a></li>
          <li><a href="/sell-my-property/index.html">List Your House / Plot</a></li>
          <li><a href="/chichawatni-property-directory/index.html">Property & Colony Directory</a></li>
          <li><a href="/areas/hayat-abad-chichawatni.html">Hayat Abad Properties</a></li>
          <li><a href="/areas/model-town-chichawatni.html">Model Town Properties</a></li>
          <li><a href="/areas/housing-scheme-chichawatni.html">Housing Colony Properties</a></li>
          <li><a href="/areas/civil-lines-chichawatni.html">Civil Lines Properties</a></li>
        </ul>
      </div>

      <!-- Col 3: Local Guides & Land Records -->
      <div class="footer-col">
        <h4 class="footer-heading">Verification & Guides</h4>
        <ul class="footer-links">
          <li><a href="/property-buying-guide.html">5-Step Due Diligence Guide</a></li>
          <li><a href="/chichawatni-land-records-plra-guide.html">PLRA Computerized Fard Guide</a></li>
          <li><a href="/fbr-property-valuation-chichawatni.html">FBR Property Valuation Rates</a></li>
          <li><a href="/chichawatni-city-guide.html">Chichawatni Master City Guide</a></li>
          <li><a href="/chichawatni-overseas-investor-guide.html">Overseas Pakistani Investor Guide</a></li>
          <li><a href="/chichawatni-commercial-property-guide.html">Commercial Plots & Shops Guide</a></li>
          <li><a href="/blog/index.html">Property Blog & Construction Costs</a></li>
          <li><a href="/chichawatni-city-facts.html">Tehsil Encyclopedia & Facts</a></li>
        </ul>
      </div>

      <!-- Col 4: Office Contact -->
      <div class="footer-col contact-col">
        <h4 class="footer-heading">Chichawatni Office</h4>
        <div class="contact-item">
          <i class="fa-solid fa-location-dot highlight-gold"></i>
          <span>{business.address.street}, {business.address.locality}, {business.address.city} {business.address.postalCode}, Punjab, Pakistan</span>
        </div>
        <div class="contact-item">
          <i class="fa-solid fa-phone highlight-gold"></i>
          <a href={`tel:${business.phone}`}>{business.phoneFormatted}</a>
        </div>
        <div class="contact-item">
          <i class="fa-solid fa-envelope highlight-gold"></i>
          <a href={`mailto:${business.email}`}>{business.email}</a>
        </div>
        <div class="contact-item">
          <i class="fa-solid fa-clock highlight-gold"></i>
          <span>Mon – Sat: 9:00 AM – 8:00 PM (Appointments Preferred)</span>
        </div>
        <div class="footer-cta-box">
          <a href={business.whatsappUrl} target="_blank" rel="noopener" class="btn-whatsapp" style="width: 100%;">
            <i class="fa-brands fa-whatsapp"></i> Chat on WhatsApp
          </a>
        </div>
      </div>
    </div>

    <!-- Legal & Disclaimer Row -->
    <div class="footer-disclaimer">
      <p>
        <strong>Legal Disclaimer:</strong> SIDDHU Property Advisor is an independent real estate advisory and facilitation service in Tehsil Chichawatni. We assist clients with on-ground property discovery, site visits, and guidance through the Punjab Land Records Authority (PLRA) Arazi Record Center and Sub-Registrar revenue procedures. We are not a government agency; all property purchases must be independently verified through official land registries prior to financial commitment.
      </p>
    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom">
      <p class="copyright">
        &copy; {new Date().getFullYear()} {business.name}. All rights reserved. Registered Advisor: {business.advisor}.
      </p>
      <ul class="legal-links">
        <li><a href="/policy-pages.html#privacy">Privacy Policy</a></li>
        <li><a href="/policy-pages.html#terms">Terms of Service</a></li>
        <li><a href="/policy-pages.html#disclaimer">Disclaimer</a></li>
        <li><a href="/policy-pages.html#verification">Verification Policy</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #080E16;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 70px 0 30px;
    margin-top: 80px;
    color: #94A3B8;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1.2fr;
    gap: 40px;
    margin-bottom: 50px;
  }

  /* Brand Col */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    text-decoration: none;
  }

  .logo-crest {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: #000;
  }

  .logo-crest img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-brand {
    font-size: 1.15rem;
    font-weight: 800;
    color: #FFFFFF;
  }

  .logo-sub {
    font-size: 0.62rem;
    letter-spacing: 1.8px;
    color: #C39A52;
    font-weight: 700;
  }

  .footer-bio {
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 20px;
    color: #94A3B8;
  }

  .footer-bio strong {
    color: #FFFFFF;
  }

  .footer-socials {
    display: flex;
    gap: 12px;
  }

  .social-link {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-control);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    color: #CBD5E1;
    transition: var(--transition);
  }

  .social-link:hover {
    transform: translateY(-3px);
  }

  .social-link.whatsapp:hover {
    background: #25D366;
    color: #0D1723;
    border-color: #25D366;
  }

  .social-link.facebook:hover {
    background: #1877F2;
    color: #FFFFFF;
    border-color: #1877F2;
  }

  .social-link.google:hover {
    background: #EA4335;
    color: #FFFFFF;
    border-color: #EA4335;
  }

  /* Headings & Links */
  .footer-heading {
    font-size: 1.15rem;
    color: #FFFFFF;
    font-weight: 700;
    margin-bottom: 20px;
    position: relative;
    padding-bottom: 8px;
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 28px;
    height: 2px;
    background: #C39A52;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links li a {
    font-size: 0.88rem;
    color: #94A3B8;
    text-decoration: none;
    transition: color 0.2s, transform 0.2s;
    display: inline-block;
  }

  .footer-links li a:hover {
    color: #FBBF24;
    transform: translateX(4px);
  }

  /* Contact Items */
  .contact-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact-item {
    display: flex;
    gap: 12px;
    font-size: 0.88rem;
    line-height: 1.5;
    color: #94A3B8;
  }

  .contact-item i {
    margin-top: 3px;
    flex-shrink: 0;
    color: #C39A52;
  }

  .contact-item a {
    color: #CBD5E1;
    text-decoration: none;
    transition: color 0.2s;
  }

  .contact-item a:hover {
    color: #FBBF24;
  }

  .footer-cta-box {
    margin-top: 8px;
  }

  /* Disclaimer */
  .footer-disclaimer {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 20px 0;
    margin-bottom: 24px;
    font-size: 0.8rem;
    line-height: 1.6;
    color: #64748B;
  }

  .footer-disclaimer strong {
    color: #94A3B8;
  }

  /* Bottom */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 0.82rem;
    color: #64748B;
  }

  .copyright {
    color: #64748B;
  }

  .legal-links {
    display: flex;
    gap: 20px;
    list-style: none;
  }

  .legal-links li a {
    color: #94A3B8;
    text-decoration: none;
    transition: color 0.2s;
  }

  .legal-links li a:hover {
    color: #FBBF24;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }

    .legal-links {
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
    }
  }
</style>
