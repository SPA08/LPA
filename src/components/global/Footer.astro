---
import { business } from '@/data/business';
---

<footer class="site-footer">
  <div class="container footer-content">
    
    <!-- TIER 1: Sleek Executive Pre-Footer CTA Bar -->
    <div class="pre-footer-cta-card">
      <div class="pre-cta-content">
        <div class="pre-cta-text">
          <span class="pre-cta-badge">
            <i class="fa-solid fa-shield-halved highlight-gold"></i>
            <span>100% TITLE &amp; PLRA VERIFIED DEALS</span>
          </span>
          <h3 class="pre-cta-title">
            Looking to Buy or Sell Property in <span class="highlight-gold">Chichawatni</span>?
          </h3>
          <p class="pre-cta-desc">
            Direct owner deals, computerized Fard verification, and on-ground plot inspection led by Naeem Siddhu.
          </p>
        </div>
        <div class="pre-cta-actions">
          <a
            href="https://wa.me/923063996764?text=Assalam-o-Alaikum%20Naeem%20Sahab%2C%20I%20want%20to%20consult%20regarding%20buying%20or%20selling%20property%20in%20Chichawatni."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-pre-whatsapp"
          >
            <i class="fa-brands fa-whatsapp"></i>
            <span>WhatsApp Naeem Siddhu</span>
          </a>
          <a href={`tel:${business.phone}`} class="btn-pre-call">
            <i class="fa-solid fa-phone"></i>
            <span>Call: {business.phoneFormatted}</span>
          </a>
        </div>
      </div>
    </div>

    <!-- TIER 2: Ultra-Clean Executive 4-Column Grid -->
    <div class="footer-grid-4col">
      
      <!-- Col 1: Brand Identity & Advisory Badge -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo" aria-label="SIDDHU Property Advisor">
          <div class="logo-crest">
            <img src="/assets/images/siddhu-logo-new.jpg" alt="SIDDHU Logo" width="40" height="40" loading="lazy" decoding="async" />
          </div>
          <div class="logo-text">
            <span class="logo-brand">SIDDHU <span class="highlight-gold">PROPERTY</span></span>
            <span class="logo-sub">REAL ESTATE ADVISOR • CHICHAWATNI</span>
          </div>
        </a>

        <p class="footer-mission">
          Sovereign title verification and direct-to-owner real estate infrastructure.
        </p>

        <div class="plra-verified-badge">
          <i class="fa-solid fa-file-shield highlight-gold"></i>
          <span>PLRA &amp; Sub-Registrar Verified Advisory</span>
        </div>

        <div class="footer-socials">
          <a href={business.whatsappUrl} target="_blank" rel="noopener" aria-label="WhatsApp Support" class="social-link whatsapp">
            <i class="fa-brands fa-whatsapp"></i>
          </a>
          <a href={business.facebookUrl} target="_blank" rel="noopener" aria-label="Facebook Page" class="social-link facebook">
            <i class="fa-brands fa-facebook-f"></i>
          </a>
          <a href={business.googleBusinessProfileUrl} target="_blank" rel="noopener" aria-label="Google Business Profile" class="social-link google">
            <i class="fa-brands fa-google"></i>
          </a>
        </div>
      </div>

      <!-- Col 2: Platform Navigation (Strictly 5 Clean Links) -->
      <div class="footer-col">
        <h4 class="footer-heading">Platform Navigation</h4>
        <ul class="footer-links">
          <li>
            <a href="/"><i class="fa-solid fa-chevron-right link-arrow"></i> Home</a>
          </li>
          <li>
            <a href="/properties.html"><i class="fa-solid fa-chevron-right link-arrow"></i> Browse Properties</a>
          </li>
          <li>
            <a href="/#areas"><i class="fa-solid fa-chevron-right link-arrow"></i> Interactive Map</a>
          </li>
          <li>
            <a href="/chichawatni-property-directory/index.html"><i class="fa-solid fa-chevron-right link-arrow"></i> Chichawatni Rakba Directory</a>
          </li>
          <li>
            <a href="/sell-my-property/index.html"><i class="fa-solid fa-chevron-right link-arrow"></i> List Your Property</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Buyer & Seller Guides (Strictly 4 Clean Links) -->
      <div class="footer-col">
        <h4 class="footer-heading">Buyer &amp; Seller Guides</h4>
        <ul class="footer-links">
          <li>
            <a href="/chichawatni-land-records-plra-guide.html"><i class="fa-solid fa-chevron-right link-arrow"></i> PLRA Fard Verification</a>
          </li>
          <li>
            <a href="/fbr-property-valuation-chichawatni.html"><i class="fa-solid fa-chevron-right link-arrow"></i> FBR Valuation Guide</a>
          </li>
          <li>
            <a href="/property-buying-guide.html"><i class="fa-solid fa-chevron-right link-arrow"></i> Safe Buying Checklist</a>
          </li>
          <li>
            <a href="/chichawatni-overseas-investor-guide.html"><i class="fa-solid fa-chevron-right link-arrow"></i> Overseas Investor Guide</a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Chichawatni Office (Executive Contact Card) -->
      <div class="footer-col office-col">
        <h4 class="footer-heading">Chichawatni Office</h4>
        <div class="clean-contact-card">
          <div class="contact-item">
            <i class="fa-solid fa-location-dot contact-icon" style="color: #EF4444 !important;"></i>
            <div>
              <span class="contact-label">Office Address</span>
              <p class="contact-val">Street 08, Tower Road Side, Hayat Abad, Chichawatni</p>
            </div>
          </div>

          <div class="contact-item">
            <i class="fa-solid fa-phone contact-icon" style="color: #10B981 !important;"></i>
            <div>
              <span class="contact-label">Direct Phone</span>
              <a href="tel:+923063996764" class="contact-link">0306 3996764</a>
            </div>
          </div>

          <div class="contact-item">
            <i class="fa-solid fa-clock contact-icon" style="color: #F59E0B !important;"></i>
            <div>
              <span class="contact-label">Consultation Hours</span>
              <p class="contact-val">Mon–Sat: 9AM–8PM</p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- TIER 3: Minimal Executive Bottom Bar -->
    <div class="footer-bottom-bar">
      <p class="legal-regulatory-note">
        <strong>Official Legal Due Diligence:</strong> SIDDHU Property Advisor provides authorized real estate consultancy and cadastral record verification across Tehsil Chichawatni. Fard Malkiat verification via Punjab Land Records Authority (PLRA) is strictly conducted before any transaction.
      </p>

      <div class="bottom-bar-flex">
        <p class="copyright-text">
          &copy; 2026 <strong>SIDDHU Property Advisor</strong>. All rights reserved.
        </p>

        <ul class="bottom-legal-links">
          <li><a href="/policy-pages.html#privacy">Privacy Policy</a></li>
          <li class="bullet-dot">•</li>
          <li><a href="/policy-pages.html#terms">Terms of Service</a></li>
          <li class="bullet-dot">•</li>
          <li><a href="/policy-pages.html#disclaimer">Legal Disclaimer</a></li>
          <li class="bullet-dot">•</li>
          <li><a href="/sitemap-index.xml">Sitemap</a></li>
        </ul>
      </div>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    background: #132A1F;
    color: #FFFFFF;
    border-top: 1px solid rgba(212, 175, 55, 0.25);
    padding: 0 0 35px;
    margin-top: 90px;
    position: relative;
    font-family: inherit;
  }

  /* TIER 1: Floating Pre-Footer CTA Card */
  .pre-footer-cta-card {
    position: relative;
    top: -45px;
    background: linear-gradient(135deg, #183527 0%, #0F2319 100%);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 18px;
    padding: 30px 38px;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6);
    margin-bottom: -15px;
  }
  .pre-cta-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
  }
  .pre-cta-text {
    max-width: 620px;
  }
  .pre-cta-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(212, 175, 55, 0.15);
    border: 1px solid rgba(212, 175, 55, 0.35);
    color: #FBBF24;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 9999px;
    letter-spacing: 0.05em;
    margin-bottom: 10px;
  }
  .pre-cta-title {
    font-size: 1.55rem;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.25;
    margin: 0 0 6px;
  }
  .pre-cta-desc {
    font-size: 0.9rem;
    color: #CBD5E1;
    margin: 0;
    line-height: 1.5;
  }
  .pre-cta-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn-pre-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: #25D366;
    color: #FFFFFF;
    padding: 12px 20px;
    border-radius: 10px;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
    transition: all 0.2s ease;
  }
  .btn-pre-whatsapp:hover {
    background: #1EBE5D;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.5);
  }
  .btn-pre-call {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: rgba(255, 255, 255, 0.07);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.18);
    padding: 12px 18px;
    border-radius: 10px;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-pre-call:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: #D4AF37;
    color: #FFFFFF;
  }

  /* TIER 2: Ultra-Clean Executive 4-Column Grid */
  .footer-grid-4col {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1.2fr;
    gap: 40px;
    padding: 40px 0 45px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Col 1: Brand */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    margin-bottom: 14px;
  }
  .logo-crest img {
    border-radius: 8px;
    border: 1px solid rgba(212, 175, 55, 0.4);
    display: block;
  }
  .logo-text {
    display: flex;
    flex-direction: column;
  }
  .logo-brand {
    font-size: 1.15rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.01em;
  }
  .logo-sub {
    font-size: 0.65rem;
    color: #A3B899;
    letter-spacing: 0.08em;
    font-weight: 600;
  }
  .footer-mission {
    font-size: 0.86rem;
    color: #CBD5E1;
    line-height: 1.55;
    margin: 0 0 16px;
  }
  .plra-verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 0.74rem;
    font-weight: 700;
    color: #FDE68A;
    margin-bottom: 18px;
  }
  .footer-socials {
    display: flex;
    gap: 10px;
  }
  .social-link {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    color: #CBD5E1;
    transition: all 0.2s ease;
    text-decoration: none;
  }
  .social-link:hover {
    transform: translateY(-2px);
    color: #FFFFFF;
  }
  .social-link.whatsapp:hover {
    background: #25D366;
    border-color: #25D366;
  }
  .social-link.facebook:hover {
    background: #1877F2;
    border-color: #1877F2;
  }
  .social-link.google:hover {
    background: #EA4335;
    border-color: #EA4335;
  }

  /* Headings & Links */
  .footer-heading {
    font-size: 0.95rem;
    color: #FFFFFF;
    font-weight: 700;
    margin-bottom: 18px;
    position: relative;
    padding-bottom: 8px;
    letter-spacing: 0.02em;
  }
  .footer-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 20px;
    height: 2px;
    background: #D4AF37;
    border-radius: 2px;
  }
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .footer-links li a {
    color: #CBD5E1;
    font-size: 0.86rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.15s ease;
  }
  .link-arrow {
    font-size: 0.65rem;
    color: #D4AF37;
    opacity: 0.7;
    transition: transform 0.15s;
  }
  .footer-links li a:hover {
    color: #D4AF37;
    transform: translateX(3px);
  }
  .footer-links li a:hover .link-arrow {
    opacity: 1;
  }

  /* Col 4: Contact Card */
  .clean-contact-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .contact-icon {
    font-size: 0.95rem;
    margin-top: 3px;
    flex-shrink: 0;
  }
  .contact-label {
    display: block;
    font-size: 0.68rem;
    color: #94A3B8;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 2px;
  }
  .contact-val {
    margin: 0;
    font-size: 0.84rem;
    color: #E2E8F0;
    line-height: 1.45;
  }
  .contact-link {
    font-size: 0.92rem;
    font-weight: 700;
    color: #34D399;
    text-decoration: none;
    transition: color 0.15s;
    letter-spacing: 0.02em;
  }
  .contact-link:hover {
    color: #10B981;
    text-decoration: underline;
  }

  /* TIER 3: Minimal Executive Bottom Bar */
  .footer-bottom-bar {
    padding-top: 24px;
  }
  .legal-regulatory-note {
    font-size: 0.74rem;
    color: #94A3B8;
    line-height: 1.5;
    margin: 0 0 16px;
    text-align: center;
  }
  .bottom-bar-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }
  .copyright-text {
    font-size: 0.78rem;
    color: #94A3B8;
    margin: 0;
  }
  .copyright-text strong {
    color: #E2E8F0;
  }
  .bottom-legal-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .bottom-legal-links li a {
    color: #94A3B8;
    font-size: 0.76rem;
    text-decoration: none;
    transition: color 0.15s;
  }
  .bottom-legal-links li a:hover {
    color: #D4AF37;
  }
  .bullet-dot {
    color: #475569;
    font-size: 0.7rem;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .footer-grid-4col {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      margin-top: 70px;
      padding-bottom: 25px;
    }
    .pre-footer-cta-card {
      padding: 22px 20px;
      top: -35px;
    }
    .pre-cta-title {
      font-size: 1.25rem;
    }
    .pre-cta-actions {
      width: 100%;
      flex-direction: column;
    }
    .btn-pre-whatsapp, .btn-pre-call {
      width: 100%;
      justify-content: center;
    }
    .footer-grid-4col {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 25px 0 30px;
    }
    .bottom-bar-flex {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .legal-regulatory-note {
      text-align: left;
    }
  }
</style>
