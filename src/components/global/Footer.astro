---
import { business } from '@/data/business';
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-grid">
      <!-- Col 1: Brand & Professional Bio -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo">
          <div class="logo-crest">
            <img src="/assets/images/siddhu-logo-new.jpg" alt="SIDDHU Logo" width="40" height="40" />
          </div>
          <div class="logo-text">
            <span class="logo-brand">SIDDHU <span class="highlight-gold">PROPERTY</span></span>
            <span class="logo-sub">REAL ESTATE ADVISOR • CHICHAWATNI</span>
          </div>
        </a>
        <p class="footer-bio">
          Tehsil Chichawatni's trusted real estate consultancy. Delivering transparent residential house discovery, computerized Arazi Record Center (PLRA) title verification, and on-ground property advisory across all major housing colonies and urban revenue blocks.
        </p>

        <!-- Trust Badges -->
        <div class="footer-trust-pills">
          <span class="trust-pill"><i class="fa-solid fa-shield-halved highlight-gold"></i> PLRA Title Assistance</span>
          <span class="trust-pill"><i class="fa-solid fa-file-signature highlight-teal"></i> Direct Seller Deals</span>
        </div>

        <div class="footer-socials">
          <a href={business.whatsappUrl} target="_blank" rel="noopener" aria-label="Official WhatsApp Support" class="social-link whatsapp">
            <i class="fa-brands fa-whatsapp"></i>
          </a>
          <a href={business.facebookUrl} target="_blank" rel="noopener" aria-label="Official Facebook Page" class="social-link facebook">
            <i class="fa-brands fa-facebook-f"></i>
          </a>
          <a href={business.googleBusinessProfileUrl} target="_blank" rel="noopener" aria-label="Google Business Profile" class="social-link google">
            <i class="fa-brands fa-google"></i>
          </a>
        </div>
      </div>

      <!-- Col 2: Real Estate Quick Links -->
      <div class="footer-col">
        <h4 class="footer-heading">Properties & Market</h4>
        <ul class="footer-links">
          <li><a href="/#properties"><i class="fa-solid fa-chevron-right link-arrow"></i> Residential Houses for Sale</a></li>
          <li><a href="/#areas"><i class="fa-solid fa-chevron-right link-arrow"></i> Interactive Tehsil Map</a></li>
          <li><a href="/sell-my-property/index.html"><i class="fa-solid fa-chevron-right link-arrow"></i> List Your House or Plot</a></li>
          <li><a href="/chichawatni-property-directory/index.html"><i class="fa-solid fa-chevron-right link-arrow"></i> Colony & Area Directory</a></li>
          <li><a href="/areas/hayat-abad-chichawatni.html"><i class="fa-solid fa-chevron-right link-arrow"></i> Hayat Abad Properties</a></li>
          <li><a href="/areas/model-town-chichawatni.html"><i class="fa-solid fa-chevron-right link-arrow"></i> Model Town Properties</a></li>
          <li><a href="/areas/housing-scheme-chichawatni.html"><i class="fa-solid fa-chevron-right link-arrow"></i> Housing Colony Properties</a></li>
          <li><a href="/areas/civil-lines-chichawatni.html"><i class="fa-solid fa-chevron-right link-arrow"></i> Civil Lines Properties</a></li>
        </ul>
      </div>

      <!-- Col 3: Local Guides & Land Records -->
      <div class="footer-col">
        <h4 class="footer-heading">Verification & Guides</h4>
        <ul class="footer-links">
          <li><a href="/property-buying-guide.html"><i class="fa-solid fa-chevron-right link-arrow"></i> 5-Step Safe Buying Guide</a></li>
          <li><a href="/chichawatni-land-records-plra-guide.html"><i class="fa-solid fa-chevron-right link-arrow"></i> PLRA Computerized Fard Guide</a></li>
          <li><a href="/fbr-property-valuation-chichawatni.html"><i class="fa-solid fa-chevron-right link-arrow"></i> Official FBR Property Valuation</a></li>
          <li><a href="/chichawatni-city-guide.html"><i class="fa-solid fa-chevron-right link-arrow"></i> Chichawatni Master City Guide</a></li>
          <li><a href="/chichawatni-overseas-investor-guide.html"><i class="fa-solid fa-chevron-right link-arrow"></i> Overseas Pakistani Investor Guide</a></li>
          <li><a href="/chichawatni-commercial-property-guide.html"><i class="fa-solid fa-chevron-right link-arrow"></i> Commercial Plots & Shops Guide</a></li>
          <li><a href="/blog/index.html"><i class="fa-solid fa-chevron-right link-arrow"></i> Property Market Blog & Insights</a></li>
          <li><a href="/chichawatni-city-facts.html"><i class="fa-solid fa-chevron-right link-arrow"></i> Tehsil Facts & History</a></li>
        </ul>
      </div>

      <!-- Col 4: Office Contact -->
      <div class="footer-col contact-col">
        <h4 class="footer-heading">Chichawatni Office</h4>
        <div class="contact-item">
          <i class="fa-solid fa-location-dot highlight-gold"></i>
          <span>{business.address.street}, {business.address.locality}, {business.address.city} {business.address.postalCode}, Punjab, Pakistan</span>
        </div>
        <div class="contact-item">
          <i class="fa-solid fa-phone highlight-gold"></i>
          <a href={`tel:${business.phone}`}>{business.phoneFormatted}</a>
        </div>
        <div class="contact-item">
          <i class="fa-solid fa-envelope highlight-gold"></i>
          <a href={`mailto:${business.email}`}>{business.email}</a>
        </div>
        <div class="contact-item">
          <i class="fa-solid fa-clock highlight-gold"></i>
          <span>Mon – Sat: 9:00 AM – 8:00 PM (Direct Consultations)</span>
        </div>
        <div class="footer-cta-box">
          <a href={business.whatsappUrl} target="_blank" rel="noopener" class="btn-whatsapp" style="width: 100%; justify-content: center;">
            <i class="fa-brands fa-whatsapp"></i> <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Legal & Disclaimer Row -->
    <div class="footer-disclaimer">
      <p>
        <strong>Legal & Regulatory Advisory:</strong> SIDDHU Property Advisor is an independent professional real estate consultancy in Tehsil Chichawatni. We provide clients with authentic property discovery, on-ground inspections, and procedural assistance through the Punjab Land Records Authority (PLRA) Arazi Record Center and Sub-Registrar revenue offices. All transactions must be verified directly through official revenue registries prior to financial exchange.
      </p>
    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom">
      <p class="copyright">
        &copy; {new Date().getFullYear()} SIDDHU Property Advisor. All rights reserved. Tehsil Chichawatni, District Sahiwal.
      </p>
      <ul class="legal-links">
        <li><a href="/policy-pages.html#privacy">Privacy Policy</a></li>
        <li><a href="/policy-pages.html#terms">Terms of Service</a></li>
        <li><a href="/policy-pages.html#disclaimer">Legal Disclaimer</a></li>
        <li><a href="/policy-pages.html#verification">Due Diligence Policy</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #1F362E;
    border-top: 2px solid rgba(200, 169, 107, 0.3);
    padding: 70px 0 30px;
    margin-top: 80px;
    color: #CAD8D1;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1.2fr;
    gap: 40px;
    margin-bottom: 50px;
  }

  /* Brand Col */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    text-decoration: none;
  }

  .logo-crest {
    width: 40px;
    height: 40px;
    border-radius: 9px;
    overflow: hidden;
    border: 1px solid rgba(200, 169, 107, 0.5);
    background: #000;
  }

  .logo-crest img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-brand {
    font-size: 1.15rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: 0.5px;
  }

  .logo-sub {
    font-size: 0.62rem;
    letter-spacing: 1.8px;
    color: var(--color-gold);
    font-weight: 700;
  }

  .footer-bio {
    font-size: 0.88rem;
    line-height: 1.65;
    margin-bottom: 18px;
    color: #CAD8D1;
  }

  .footer-trust-pills {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 22px;
  }

  .trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #E2ECE7;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(200, 169, 107, 0.2);
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.3px;
    width: fit-content;
  }

  .footer-socials {
    display: flex;
    gap: 10px;
  }

  .social-link {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-control);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(200, 169, 107, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    color: #E2ECE7;
    transition: var(--transition);
  }

  .social-link:hover {
    transform: translateY(-3px);
  }

  .social-link.whatsapp:hover {
    background: #25D366;
    color: #1F362E;
    border-color: #25D366;
  }

  .social-link.facebook:hover {
    background: #1877F2;
    color: #FFFFFF;
    border-color: #1877F2;
  }

  .social-link.google:hover {
    background: #EA4335;
    color: #FFFFFF;
    border-color: #EA4335;
  }

  /* Headings & Links */
  .footer-heading {
    font-size: 1.08rem;
    color: #FFFFFF;
    font-weight: 700;
    margin-bottom: 20px;
    position: relative;
    padding-bottom: 8px;
    letter-spacing: 0.3px;
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 28px;
    height: 2px;
    background: var(--color-gold);
    border-radius: 2px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    margin: 0;
  }

  .footer-links li a {
    font-size: 0.85rem;
    color: #CAD8D1;
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    line-height: 1.4;
  }

  .link-arrow {
    font-size: 0.65rem;
    color: var(--color-gold);
    opacity: 0.7;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .footer-links li a:hover {
    color: #FFFFFF;
    transform: translateX(4px);
  }

  .footer-links li a:hover .link-arrow {
    opacity: 1;
    transform: translateX(2px);
  }

  /* Contact Items */
  .contact-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact-item {
    display: flex;
    gap: 12px;
    font-size: 0.88rem;
    line-height: 1.5;
    color: #CAD8D1;
  }

  .contact-item i {
    margin-top: 3px;
    flex-shrink: 0;
    color: var(--color-gold);
  }

  .contact-item a {
    color: #E2ECE7;
    text-decoration: none;
    transition: color 0.2s;
  }

  .contact-item a:hover {
    color: var(--color-gold);
  }

  .footer-cta-box {
    margin-top: 8px;
  }

  /* Disclaimer */
  .footer-disclaimer {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding: 20px 0;
    margin-bottom: 24px;
    font-size: 0.8rem;
    line-height: 1.6;
    color: #9AB0A6;
  }

  .footer-disclaimer strong {
    color: #CAD8D1;
  }

  /* Bottom */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 0.82rem;
    color: #9AB0A6;
  }

  .copyright {
    color: #9AB0A6;
  }

  .legal-links {
    display: flex;
    gap: 20px;
    list-style: none;
  }

  .legal-links li a {
    color: #CAD8D1;
    text-decoration: none;
    transition: color 0.2s;
  }

  .legal-links li a:hover {
    color: var(--color-gold);
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }

    .legal-links {
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
    }
  }
</style>
