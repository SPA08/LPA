---
import { business } from '@/data/business';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<!-- Top Announcement & Telemetry Micro-Bar -->
<div class="telemetry-bar">
  <div class="container telemetry-container">
    <div class="telemetry-left">
      <span class="live-status-indicator">
        <span class="live-dot-pulse"></span>
        <span>Live PLRA & Market Index: Chichawatni & Sahiwal Division</span>
      </span>
    </div>
    <div class="telemetry-center">
      <span class="telemetry-highlight">
        <i class="fa-solid fa-award highlight-gold"></i>
        <span>#1 Verified Buy & Sale Real Estate Advisory</span>
      </span>
    </div>
    <div class="telemetry-right">
      <span class="currency-toggle-pill" title="Valuation Currency Format">
        <i class="fa-solid fa-coins"></i>
        <span>PKR Crore / Lakh</span>
      </span>
      <span class="telemetry-divider">•</span>
      <span class="telemetry-timing">
        <i class="fa-regular fa-clock"></i>
        <span>Mon–Sat: 9AM–8PM</span>
      </span>
      <span class="telemetry-divider">•</span>
      <a href={`tel:${business.phone}`} class="telemetry-phone">
        <i class="fa-solid fa-phone"></i>
        <span>{business.phoneFormatted}</span>
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Glassmorphic Header -->
<header id="siteHeader" class="site-header">
  <div class="container header-container">
    
    <!-- Brand Logo Lockup with PRO OS Badge -->
    <a href="/" class="header-logo" aria-label="SIDDHU Property Advisor Home">
      <div class="logo-crest">
        <img src="/assets/images/siddhu-logo-new.jpg" alt="SIDDHU Logo" width="38" height="38" decoding="async" />
      </div>
      <div class="logo-text">
        <div class="logo-title-row">
          <span class="logo-brand">SIDDHU <span class="highlight-gold">PROPERTY</span></span>
        </div>
        <span class="logo-sub">REAL ESTATE ADVISOR • CHICHAWATNI</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        <!-- Properties Mega-Menu -->
        <li class="nav-dropdown-wrapper">
          <a href="/#properties" class="nav-link dropdown-trigger">
            <span>Properties</span>
            <i class="fa-solid fa-chevron-down dropdown-arrow"></i>
          </a>
          <div class="dropdown-menu mega-dropdown properties-mega">
            <div class="mega-header">
              <span class="mega-title">
                <i class="fa-solid fa-house-chimney highlight-gold"></i> Verified Inventory Matrix
              </span>
              <a href="/properties.html" class="mega-header-link">View All Listings &rarr;</a>
            </div>
            <div class="mega-columns">
              <div class="mega-col">
                <span class="mega-col-label">Chichawatni Residential</span>
                <ul class="mega-sublist">
                  <li><a href="/areas/hayat-abad-chichawatni.html"><i class="fa-solid fa-house-user highlight-gold"></i> Hayat Abad (Tower Road)</a></li>
                  <li><a href="/areas/model-town-chichawatni.html"><i class="fa-solid fa-house-circle-check highlight-teal"></i> Model Town (40ft Roads)</a></li>
                  <li><a href="/areas/housing-scheme-chichawatni.html"><i class="fa-solid fa-building-user highlight-gold"></i> Housing Colony Scheme 1 & 2</a></li>
                  <li><a href="/areas/civil-lines-chichawatni.html"><i class="fa-solid fa-tree-city highlight-teal"></i> Civil Lines & Canal Corridor</a></li>
                  <li><a href="/#properties"><i class="fa-solid fa-diamond highlight-gold"></i> 10 Marla Corner Residences</a></li>
                </ul>
              </div>
              <div class="mega-col">
                <span class="mega-col-label">Sahiwal Top 10 Towns</span>
                <ul class="mega-sublist">
                  <li><a href="/#properties"><i class="fa-solid fa-city highlight-gold"></i> Farid Town, Sahiwal (Premier)</a></li>
                  <li><a href="/#properties"><i class="fa-solid fa-building-flag highlight-teal"></i> Tariq Bin Ziyad (TBZ) Colony</a></li>
                  <li><a href="/#properties"><i class="fa-solid fa-tree highlight-gold"></i> Shadman & Green Town, Sahiwal</a></li>
                  <li><a href="/#properties"><i class="fa-solid fa-shield-halved highlight-teal"></i> Royal Orchard & Palm View</a></li>
                  <li><a href="/#properties"><i class="fa-solid fa-road highlight-gold"></i> Main GT Road & Bypass Commercial</a></li>
                </ul>
              </div>
            </div>
          </div>
        </li>

        <!-- Interactive Map with LIVE GPS Badge -->
        <li>
          <a href="/#areas" class="nav-link map-nav-link">
            <span>Interactive Map</span>
            <span class="live-gps-badge">LIVE GPS</span>
          </a>
        </li>

        <!-- City & Guides 2-Column Bento Mega Dropdown -->
        <li class="nav-dropdown-wrapper">
          <a href="/chichawatni-city-guide.html" class="nav-link dropdown-trigger">
            <span>Guides & Verification</span>
            <i class="fa-solid fa-chevron-down dropdown-arrow"></i>
          </a>
          <div class="dropdown-menu mega-dropdown guides-mega">
            <div class="mega-header">
              <span class="mega-title">
                <i class="fa-solid fa-book-atlas highlight-gold"></i> Chichawatni & Sahiwal Knowledge Hub
              </span>
            </div>
            <div class="mega-columns">
              <div class="mega-col">
                <span class="mega-col-label">Due Diligence & Valuation</span>
                <ul class="mega-sublist">
                  <li><a href="/chichawatni-land-records-plra-guide.html"><i class="fa-solid fa-file-signature highlight-gold"></i> PLRA Computerized Fard Guide</a></li>
                  <li><a href="/fbr-property-valuation-chichawatni.html"><i class="fa-solid fa-calculator highlight-teal"></i> FBR Property Valuation 2026</a></li>
                  <li><a href="/property-buying-guide.html"><i class="fa-solid fa-shield-halved highlight-gold"></i> 5-Step Safe Buying Checklist</a></li>
                  <li><a href="/chichawatni-overseas-investor-guide.html"><i class="fa-solid fa-plane-departure highlight-teal"></i> Overseas Pakistani Investor Portal</a></li>
                  <li><a href="/chichawatni-commercial-property-guide.html"><i class="fa-solid fa-building highlight-gold"></i> Commercial Property Guide</a></li>
                </ul>
              </div>
              <div class="mega-col">
                <span class="mega-col-label">City Infrastructure & Heritage</span>
                <ul class="mega-sublist">
                  <li><a href="/chichawatni-property-directory/index.html"><i class="fa-solid fa-map-location-dot highlight-gold"></i> Complete Chichawatni Rakba &amp; Area Directory</a></li>
                  <li><a href="/chichawatni-residential-colonies-guide.html"><i class="fa-solid fa-tree-city highlight-teal"></i> All Chichawatni Colonies</a></li>
                  <li><a href="/chichawatni-history-heritage.html"><i class="fa-solid fa-landmark highlight-gold"></i> 1913 Forest & History</a></li>
                  <li><a href="/chichawatni-hospitals-guide.html"><i class="fa-solid fa-hospital highlight-teal"></i> Hospitals & Health Centers</a></li>
                  <li><a href="/chichawatni-schools-guide.html"><i class="fa-solid fa-graduation-cap highlight-gold"></i> Schools & Colleges</a></li>
                  <li><a href="/chichawatni-roads-guide.html"><i class="fa-solid fa-road highlight-teal"></i> GT Road & Bypass Corridors</a></li>
                </ul>
              </div>
            </div>
          </div>
        </li>
      </ul>
    </nav>

    <!-- Header Actions Cluster -->
    <div class="header-actions">
      <!-- Primary Gold CTA Button -->
      <a href="/sell-my-property/index.html" class="btn-primary list-property-btn">
        <i class="fa-solid fa-plus"></i>
        <span>List Property</span>
        <i class="fa-solid fa-arrow-right btn-arrow"></i>
      </a>

      <!-- Mobile Hamburger Button -->
      <button id="mobileMenuToggle" class="mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <i class="fa-solid fa-bars" id="menuBarsIcon"></i>
        <i class="fa-solid fa-xmark" id="menuCloseIcon" style="display: none;"></i>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Overlay & Menu -->
  <div id="mobileDrawerOverlay" class="mobile-drawer-overlay"></div>
  <div id="mobileDrawer" class="mobile-drawer" aria-hidden="true">
    <div class="drawer-inner container">
      <div class="mobile-drawer-brand">
        <div class="logo-text">
          <div class="logo-title-row">
            <span class="logo-brand">SIDDHU <span class="highlight-gold">PROPERTY</span></span>
          </div>
          <span class="logo-sub">REAL ESTATE ADVISOR • CHICHAWATNI</span>
        </div>
      </div>

      <ul class="mobile-nav-list">
        <li><a href="/" class="mobile-nav-link"><i class="fa-solid fa-house highlight-gold"></i> Home</a></li>
        <li><a href="/#properties" class="mobile-nav-link"><i class="fa-solid fa-house-chimney highlight-teal"></i> Verified Properties</a></li>
        <li><a href="/#areas" class="mobile-nav-link"><i class="fa-solid fa-map-location-dot highlight-gold"></i> Interactive Map (Live GPS)</a></li>
        <li><a href="/#rate-index" class="mobile-nav-link"><i class="fa-solid fa-chart-line highlight-gold"></i> 2026 Per-Marla Rate Index</a></li>
        
        <li class="mobile-section-divider">City & Legal Knowledge</li>
        <li><a href="/chichawatni-property-directory/index.html" class="mobile-nav-link"><i class="fa-solid fa-book-atlas highlight-gold"></i> Complete Rakba &amp; Area Directory</a></li>
        <li><a href="/chichawatni-city-guide.html" class="mobile-nav-link"><i class="fa-solid fa-city highlight-gold"></i> City Overview</a></li>
        <li><a href="/chichawatni-residential-colonies-guide.html" class="mobile-nav-link"><i class="fa-solid fa-tree-city highlight-teal"></i> Residential Colonies</a></li>
        <li><a href="/chichawatni-land-records-plra-guide.html" class="mobile-nav-link"><i class="fa-solid fa-file-shield highlight-gold"></i> PLRA Land Records</a></li>
        <li><a href="/fbr-property-valuation-chichawatni.html" class="mobile-nav-link"><i class="fa-solid fa-calculator highlight-teal"></i> FBR Property Valuation</a></li>
        <li><a href="/property-buying-guide.html" class="mobile-nav-link"><i class="fa-solid fa-compass highlight-gold"></i> 5-Step Buying Roadmap</a></li>
        <li><a href="/chichawatni-overseas-investor-guide.html" class="mobile-nav-link"><i class="fa-solid fa-plane-departure highlight-teal"></i> Overseas Investor Guide</a></li>
        <li><a href="/blog/index.html" class="mobile-nav-link"><i class="fa-solid fa-newspaper highlight-gold"></i> Property Blog</a></li>
        <li><a href="/#contact" class="mobile-nav-link"><i class="fa-solid fa-envelope highlight-teal"></i> Contact Us</a></li>
      </ul>

      <div class="mobile-drawer-footer">
        <a href="/sell-my-property/index.html" class="btn-primary" style="width: 100%; margin-bottom: 10px; justify-content: center;">
          <i class="fa-solid fa-plus"></i> List Your Property Free
        </a>
        <a href="https://wa.me/923063996764" target="_blank" rel="noopener noreferrer" class="btn-whatsapp" style="width: 100%; justify-content: center; margin-bottom: 8px;">
          <i class="fa-brands fa-whatsapp"></i> WhatsApp Consultation
        </a>
        <a href={`tel:${business.phone}`} class="header-call-btn" style="width: 100%; justify-content: center;">
          <i class="fa-solid fa-phone"></i> Call Naeem Siddhu: {business.phoneFormatted}
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Global Command Palette Search Modal (⌘K) -->
<div id="cmdPaletteOverlay" class="cmd-palette-overlay" style="display: none;" onclick="window.closeCmdPalette(event);">
  <div class="cmd-palette-modal" onclick="event.stopPropagation();">
    <div class="cmd-input-row">
      <i class="fa-solid fa-magnifying-glass cmd-input-icon"></i>
      <input
        type="text"
        id="cmdPaletteInput"
        aria-label="Search properties, towns, colonies, or guides"
        placeholder="Search any town, plot, colony, or guide (e.g. Model Town, Farid Town, Fard)..."
        autocomplete="off"
        spellcheck="false"
        oninput="window.handleCmdSearch(this.value);"
      />
      <kbd class="cmd-modal-esc" onclick="window.closeCmdPalette();">ESC</kbd>
    </div>

    <div class="cmd-results-list" id="cmdResultsList">
      <!-- Quick Shortcuts default -->
      <div class="cmd-group-label">POPULAR DESTINATIONS & REGIONS</div>
      
      <a href="/#properties" class="cmd-item" onclick="window.closeCmdPalette();">
        <div class="cmd-item-icon green"><i class="fa-solid fa-house-chimney"></i></div>
        <div class="cmd-item-info">
          <span class="cmd-item-title">Selected Residential Homes</span>
          <span class="cmd-item-desc">Verified 5, 7, 10 & 12 Marla homes with demand prices</span>
        </div>
        <span class="cmd-item-badge">Properties</span>
      </a>

      <a href="/areas/hayat-abad-chichawatni.html" class="cmd-item" onclick="window.closeCmdPalette();">
        <div class="cmd-item-icon gold"><i class="fa-solid fa-location-dot"></i></div>
        <div class="cmd-item-info">
          <span class="cmd-item-title">Hayat Abad, Chichawatni</span>
          <span class="cmd-item-desc">Premier colony on Tower Road • 22–32 Lakh/Marla</span>
        </div>
        <span class="cmd-item-badge">Town</span>
      </a>

      <a href="/areas/model-town-chichawatni.html" class="cmd-item" onclick="window.closeCmdPalette();">
        <div class="cmd-item-icon gold"><i class="fa-solid fa-location-dot"></i></div>
        <div class="cmd-item-info">
          <span class="cmd-item-title">Model Town, Chichawatni</span>
          <span class="cmd-item-desc">TMA Approved 40ft roads • 20–30 Lakh/Marla</span>
        </div>
        <span class="cmd-item-badge">Town</span>
      </a>

      <a href="/#areas" class="cmd-item" onclick="window.closeCmdPalette(); window.switchMapHub('Sahiwal');">
        <div class="cmd-item-icon teal"><i class="fa-solid fa-city"></i></div>
        <div class="cmd-item-info">
          <span class="cmd-item-title">Farid Town & Top 10 Sahiwal Schemes</span>
          <span class="cmd-item-desc">TBZ Colony, Shadman, Royal Orchard, Jeewan City</span>
        </div>
        <span class="cmd-item-badge">Sahiwal Hub</span>
      </a>

      <a href="/#rate-index" class="cmd-item" onclick="window.closeCmdPalette();">
        <div class="cmd-item-icon purple"><i class="fa-solid fa-chart-line"></i></div>
        <div class="cmd-item-info">
          <span class="cmd-item-title">2026 Per-Marla Rate Index</span>
          <span class="cmd-item-desc">Compare current asking rates across Chichawatni & Sahiwal</span>
        </div>
        <span class="cmd-item-badge">Rate Table</span>
      </a>

      <a href="/chichawatni-land-records-plra-guide.html" class="cmd-item" onclick="window.closeCmdPalette();">
        <div class="cmd-item-icon blue"><i class="fa-solid fa-file-shield"></i></div>
        <div class="cmd-item-info">
          <span class="cmd-item-title">PLRA Computerized Fard & Title Verification</span>
          <span class="cmd-item-desc">Step-by-step land record registry due diligence</span>
        </div>
        <span class="cmd-item-badge">Legal Guide</span>
      </a>
    </div>

    <div class="cmd-modal-footer">
      <span>Use <kbd>&uarr;</kbd> <kbd>&darr;</kbd> to navigate</span>
      <span>Press <kbd>ESC</kbd> to close</span>
    </div>
  </div>
</div>

<style>
  /* Telemetry Micro-Bar */
  .telemetry-bar {
    background: #0F291E;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.72rem;
    color: #CBD5E1;
    padding: 6px 0;
    position: relative;
    z-index: 1001;
  }

  .telemetry-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .live-status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-weight: 600;
    color: #E2ECE7;
  }

  .live-dot-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 8px #10B981;
    animation: livePulse 2s infinite ease-in-out;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .telemetry-center {
    font-weight: 600;
    color: #F8FAFC;
    letter-spacing: 0.2px;
  }

  .telemetry-highlight {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .telemetry-right {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
  }

  .currency-toggle-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 2px 8px;
    border-radius: 9999px;
    color: #C8A96B;
    font-weight: 700;
    font-size: 0.68rem;
  }

  .telemetry-divider {
    color: rgba(255, 255, 255, 0.2);
  }

  .telemetry-phone {
    color: #F8FAFC;
    text-decoration: none;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: color 0.2s ease;
  }

  .telemetry-phone:hover {
    color: #C8A96B;
  }

  @media (max-width: 900px) {
    .telemetry-center {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .telemetry-timing, .telemetry-divider {
      display: none;
    }
  }

  /* Main Sticky Header */
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(19, 42, 31, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 14px 0;
    box-shadow: 0 4px 20px -2px rgba(15, 30, 24, 0.35);
  }

  .site-header.header-shrunk {
    padding: 10px 0;
    background: rgba(15, 33, 24, 0.98);
    box-shadow: 0 10px 25px -5px rgba(10, 24, 18, 0.5);
    border-bottom-color: rgba(200, 169, 107, 0.35);
  }

  .site-header.header-hidden {
    transform: translateY(-100%);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  /* Logo with PRO OS Badge */
  .header-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    text-decoration: none;
  }

  .logo-crest {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(200, 169, 107, 0.5);
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .logo-crest img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .logo-brand {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: #FFFFFF;
  }

  .pro-os-badge {
    background: linear-gradient(135deg, #059669, #10B981);
    color: #FFFFFF;
    font-size: 0.62rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.8px;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.4);
  }

  .logo-sub {
    font-size: 0.58rem;
    letter-spacing: 1.4px;
    color: var(--color-gold);
    font-weight: 700;
    text-transform: uppercase;
  }

  /* Desktop Nav */
  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 22px;
    list-style: none;
  }

  .nav-link {
    font-size: 0.88rem;
    font-weight: 500;
    color: #E2ECE7;
    position: relative;
    padding: 6px 0;
    display: flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .nav-link:hover, .nav-link.active {
    color: #FFFFFF;
    font-weight: 600;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-gold);
    transition: width 0.3s ease;
  }

  .nav-link:hover::after, .nav-link.active::after {
    width: 100%;
  }

  /* Live GPS badge in nav */
  .live-gps-badge {
    font-size: 0.62rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 9999px;
    background: #059669;
    color: #FFFFFF;
    letter-spacing: 0.4px;
    animation: gpsGlow 2.5s infinite;
  }

  @keyframes gpsGlow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.6); }
    50% { box-shadow: 0 0 0 5px rgba(5, 150, 105, 0); }
  }

  .nav-micro-icon {
    color: var(--color-gold);
    font-size: 0.82rem;
  }

  /* Dropdown Menus */
  .nav-dropdown-wrapper {
    position: relative;
  }

  .dropdown-arrow {
    font-size: 0.62rem;
    color: var(--color-gold);
    transition: transform 0.3s ease;
  }

  .nav-dropdown-wrapper:hover .dropdown-arrow {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    opacity: 0;
    visibility: hidden;
    background: #FFFFFF;
    border: 1px solid rgba(200, 169, 107, 0.35);
    border-radius: 18px;
    box-shadow: 0 24px 48px -12px rgba(27, 47, 40, 0.3);
    list-style: none;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s;
    z-index: 100;
  }

  .nav-dropdown-wrapper:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  /* Mega Dropdown */
  .mega-dropdown {
    min-width: 560px;
    padding: 16px 20px 20px;
  }

  .mega-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    margin-bottom: 14px;
    border-bottom: 1px solid #E2E8F0;
  }

  .mega-title {
    font-size: 0.8rem;
    font-weight: 700;
