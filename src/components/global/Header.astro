<script is:inline>
  // Shrinking & smart hide/reveal header script
  let lastScrollY = window.scrollY;
  let ticking = false;
  const header = document.getElementById('siteHeader');
  const toggleBtn = document.getElementById('mobileMenuToggle');
  const drawer = document.getElementById('mobileDrawer');
  const overlay = document.getElementById('mobileDrawerOverlay');
  const menuBars = document.getElementById('menuBarsIcon');
  const menuClose = document.getElementById('menuCloseIcon');

  function updateHeader() {
    const currentScrollY = window.scrollY;

    if (currentScrollY > 40) {
      header?.classList.add('header-shrunk');
    } else {
      header?.classList.remove('header-shrunk');
    }

    if (currentScrollY > 200 && currentScrollY > lastScrollY && !drawer?.classList.contains('open')) {
      header?.classList.add('header-hidden');
    } else {
      header?.classList.remove('header-hidden');
    }

    lastScrollY = currentScrollY;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(updateHeader);
      ticking = true;
    }
  }, { passive: true });

  function closeMobileDrawer() {
    drawer?.classList.remove('open');
    overlay?.classList.remove('active');
    toggleBtn?.setAttribute('aria-expanded', 'false');
    if (menuBars && menuClose) {
      menuBars.style.display = 'block';
      menuClose.style.display = 'none';
    }
  }

  toggleBtn?.addEventListener('click', () => {
    const isOpen = drawer?.classList.toggle('open');
    overlay?.classList.toggle('active', !!isOpen);
    toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    if (menuBars && menuClose) {
      menuBars.style.display = isOpen ? 'none' : 'block';
      menuClose.style.display = isOpen ? 'block' : 'none';
    }
  });

  overlay?.addEventListener('click', closeMobileDrawer);
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', closeMobileDrawer);
  });

  // Command Palette Methods
  window.openCmdPalette = function() {
    const modal = document.getElementById('cmdPaletteOverlay');
    if (modal) {
      modal.style.display = 'flex';
      closeMobileDrawer();
      setTimeout(() => {
        const input = document.getElementById('cmdPaletteInput');
        if (input) {
          input.focus();
          input.select();
        }
      }, 50);
    }
  };

  window.closeCmdPalette = function(e) {
    const modal = document.getElementById('cmdPaletteOverlay');
    if (modal) modal.style.display = 'none';
  };

  // Keyboard shortcut listener for Ctrl+K or Cmd+K
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      const modal = document.getElementById('cmdPaletteOverlay');
      if (modal && modal.style.display === 'flex') {
        window.closeCmdPalette();
      } else {
        window.openCmdPalette();
      }
    }
    if (e.key === 'Escape') {
      window.closeCmdPalette();
    }
  });

  // Instant Search filter inside Command Palette
  window.handleCmdSearch = function(query) {
    const q = query.toLowerCase().trim();
    const items = document.querySelectorAll('#cmdResultsList .cmd-item');
    items.forEach(item => {
      const text = item.textContent.toLowerCase();
      if (!q || text.includes(q)) {
        item.style.display = 'flex';
      } else {
        item.style.display = 'none';
      }
    });
  };
</script>
