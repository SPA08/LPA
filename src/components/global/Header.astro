            <i class="fa-solid fa-chevron-down dropdown-arrow"></i>
          </a>
          <div class="dropdown-menu mega-dropdown">
            <div class="mega-header">
              <span class="mega-title"><i class="fa-solid fa-book-atlas highlight-gold"></i> Chichawatni Civic & Property Knowledge</span>
            </div>
            <div class="mega-columns">
              <div class="mega-col">
                <span class="mega-col-label">Essential Guides</span>
                <ul class="mega-sublist">
                  <li><a href="/chichawatni-city-guide.html"><i class="fa-solid fa-city highlight-gold"></i> City Overview</a></li>
                  <li><a href="/chichawatni-residential-colonies-guide.html"><i class="fa-solid fa-house-chimney highlight-teal"></i> Residential Colonies</a></li>
                  <li><a href="/chichawatni-land-records-plra-guide.html"><i class="fa-solid fa-file-signature highlight-gold"></i> PLRA & Land Records</a></li>
                  <li><a href="/fbr-property-valuation-chichawatni.html"><i class="fa-solid fa-calculator highlight-teal"></i> FBR Property Valuation</a></li>
                  <li><a href="/property-buying-guide.html"><i class="fa-solid fa-shield-halved highlight-gold"></i> Buying Roadmap</a></li>
                  <li><a href="/chichawatni-overseas-investor-guide.html"><i class="fa-solid fa-plane-departure highlight-teal"></i> Overseas Investor Guide</a></li>
                  <li><a href="/chichawatni-commercial-property-guide.html"><i class="fa-solid fa-building highlight-gold"></i> Commercial Property</a></li>
                </ul>
              </div>
              <div class="mega-col">
                <span class="mega-col-label">Civic & Community</span>
                <ul class="mega-sublist">
                  <li><a href="/chichawatni-history-heritage.html"><i class="fa-solid fa-landmark highlight-teal"></i> 1913 Forest & History</a></li>
                  <li><a href="/chichawatni-hospitals-guide.html"><i class="fa-solid fa-hospital highlight-gold"></i> Hospitals & Clinics</a></li>
                  <li><a href="/chichawatni-schools-guide.html"><i class="fa-solid fa-graduation-cap highlight-teal"></i> Schools & Colleges</a></li>
                  <li><a href="/chichawatni-markets-guide.html"><i class="fa-solid fa-store highlight-gold"></i> Markets & Bazaars</a></li>
                  <li><a href="/chichawatni-roads-guide.html"><i class="fa-solid fa-road highlight-teal"></i> Roads & Corridors</a></li>
                  <li><a href="/chichawatni-public-offices.html"><i class="fa-solid fa-building-columns highlight-gold"></i> Government Offices</a></li>
                  <li><a href="/chichawatni-city-facts.html"><i class="fa-solid fa-book-open highlight-teal"></i> City Encyclopedia</a></li>
                </ul>
              </div>
            </div>
          </div>
        </li>

        <!-- Property Blog Dropdown -->
        <li class="nav-dropdown-wrapper">
          <a href="/blog/index.html" class="nav-link dropdown-trigger">
            <span>Property Blog</span>
            <i class="fa-solid fa-chevron-down dropdown-arrow"></i>
          </a>
          <ul class="dropdown-menu compact-dropdown">
            <li><a href="/blog/index.html"><i class="fa-solid fa-newspaper highlight-gold"></i> All Articles</a></li>
            <li><a href="/blog/index.html?category=buying"><i class="fa-solid fa-house-circle-check highlight-teal"></i> Buying Guides</a></li>
            <li><a href="/blog/index.html?category=selling"><i class="fa-solid fa-tags highlight-gold"></i> Selling Advice</a></li>
            <li><a href="/blog/index.html?category=records"><i class="fa-solid fa-file-shield highlight-teal"></i> Land Record Advice</a></li>
          </ul>
        </li>

        <li>
          <a href="/#contact" class="nav-link">
            <span>Contact</span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a href="tel:+923063996764" class="header-call-btn" aria-label="Call consultation">
        <i class="fa-solid fa-phone"></i>
        <span class="call-text">{business.phoneFormatted}</span>
      </a>

      <a href="/sell-my-property/index.html" class="btn-primary list-property-btn">
        <i class="fa-solid fa-plus"></i>
        <span>List Property</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button id="mobileMenuToggle" class="mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <i class="fa-solid fa-bars" id="menuBarsIcon"></i>
        <i class="fa-solid fa-xmark" id="menuCloseIcon" style="display: none;"></i>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Overlay & Menu -->
  <div id="mobileDrawerOverlay" class="mobile-drawer-overlay"></div>
  <div id="mobileDrawer" class="mobile-drawer" aria-hidden="true">
    <div class="drawer-inner container">
      <div class="mobile-drawer-brand">
        <div class="logo-text">
          <span class="logo-brand">SIDDHU <span class="highlight-gold">PROPERTY</span></span>
          <span class="logo-sub">REAL ESTATE ADVISOR • CHICHAWATNI</span>
        </div>
      </div>

      <ul class="mobile-nav-list">
        <li><a href="/" class="mobile-nav-link"><i class="fa-solid fa-house highlight-gold"></i> Home</a></li>
        <li><a href="/#properties" class="mobile-nav-link"><i class="fa-solid fa-house-chimney highlight-teal"></i> Verified Properties</a></li>
        <li><a href="/#areas" class="mobile-nav-link"><i class="fa-solid fa-map-location-dot highlight-gold"></i> Interactive Map</a></li>
        
        <li class="mobile-section-divider">City & Legal Knowledge</li>
        <li><a href="/chichawatni-city-guide.html" class="mobile-nav-link"><i class="fa-solid fa-city highlight-gold"></i> City Overview</a></li>
        <li><a href="/chichawatni-residential-colonies-guide.html" class="mobile-nav-link"><i class="fa-solid fa-tree-city highlight-teal"></i> Residential Colonies</a></li>
        <li><a href="/chichawatni-land-records-plra-guide.html" class="mobile-nav-link"><i class="fa-solid fa-file-shield highlight-gold"></i> PLRA Land Records</a></li>
        <li><a href="/fbr-property-valuation-chichawatni.html" class="mobile-nav-link"><i class="fa-solid fa-calculator highlight-teal"></i> FBR Property Valuation</a></li>
        <li><a href="/property-buying-guide.html" class="mobile-nav-link"><i class="fa-solid fa-compass highlight-gold"></i> 5-Step Buying Roadmap</a></li>
        <li><a href="/chichawatni-overseas-investor-guide.html" class="mobile-nav-link"><i class="fa-solid fa-plane-departure highlight-teal"></i> Overseas Investor Guide</a></li>
        <li><a href="/blog/index.html" class="mobile-nav-link"><i class="fa-solid fa-newspaper highlight-gold"></i> Property Blog</a></li>
        <li><a href="/#contact" class="mobile-nav-link"><i class="fa-solid fa-envelope highlight-teal"></i> Contact Us</a></li>
      </ul>

      <div class="mobile-drawer-footer">
        <a href="/sell-my-property/index.html" class="btn-primary" style="width: 100%; margin-bottom: 10px; justify-content: center;">
          <i class="fa-solid fa-plus"></i> List Your Property Free
        </a>
        <a href="tel:+923063996764" class="btn-whatsapp" style="width: 100%; justify-content: center;">
          <i class="fa-solid fa-phone"></i> Call Advisor: {business.phoneFormatted}
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(41, 71, 61, 0.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(200, 169, 107, 0.28);
    transition: transform 0.35s ease, background 0.35s ease, padding 0.35s ease, box-shadow 0.35s ease;
    padding: 16px 0;
    box-shadow: 0 4px 20px -2px rgba(27, 47, 40, 0.25);
  }

  .site-header.header-shrunk {
    padding: 11px 0;
    background: rgba(31, 54, 46, 0.98);
    box-shadow: 0 10px 25px -5px rgba(15, 30, 24, 0.35);
    border-bottom-color: rgba(200, 169, 107, 0.4);
  }

  .site-header.header-hidden {
    transform: translateY(-100%);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  /* Logo */
  .header-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    text-decoration: none;
  }

  .logo-crest {
    width: 40px;
    height: 40px;
    border-radius: 9px;
    overflow: hidden;
    border: 1px solid rgba(200, 169, 107, 0.5);
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .logo-crest img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-brand {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: #FFFFFF;
  }

  .logo-sub {
    font-size: 0.62rem;
    letter-spacing: 1.8px;
    color: var(--color-gold);
    font-weight: 700;
    text-transform: uppercase;
  }

  /* Desktop Nav */
  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
  }

  .nav-link {
    font-size: 0.92rem;
    font-weight: 500;
    color: #E2ECE7;
    position: relative;
    padding: 6px 0;
    display: flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-link:hover, .nav-link.active {
    color: #FFFFFF;
    font-weight: 600;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-gold);
    transition: width 0.3s ease;
  }

  .nav-link:hover::after, .nav-link.active::after {
    width: 100%;
  }

  /* Dropdown Menus */
  .nav-dropdown-wrapper {
    position: relative;
  }

  .dropdown-arrow {
    font-size: 0.65rem;
    color: var(--color-gold);
    transition: transform 0.3s ease;
  }

  .nav-dropdown-wrapper:hover .dropdown-arrow {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    opacity: 0;
    visibility: hidden;
    background: #FFFFFF;
    border: 1px solid rgba(200, 169, 107, 0.35);
    border-radius: 18px;
    box-shadow: 0 24px 48px -12px rgba(27, 47, 40, 0.3);
    list-style: none;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s;
    z-index: 100;
  }

  .nav-dropdown-wrapper:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  /* Compact Dropdown (Blog) */
  .compact-dropdown {
    min-width: 240px;
    padding: 10px 0;
  }

  .compact-dropdown li a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    font-size: 0.88rem;
    color: #2D3D36;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .compact-dropdown li a:hover {
    background: #F3F7F5;
    color: var(--color-dark-green);
    font-weight: 600;
  }

  /* 2-Column Mega Dropdown (City & Guides) */
  .mega-dropdown {
    min-width: 540px;
    padding: 16px 20px 20px;
  }

  .mega-header {
    padding-bottom: 12px;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .mega-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--color-dark-green);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .mega-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .mega-col-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-gold);
    margin-bottom: 8px;
    padding-left: 10px;
  }

  .mega-sublist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mega-sublist li a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 0.85rem;
    color: #2D3D36;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }

  .mega-sublist li a:hover {
    background: #F3F7F5;
    color: var(--color-dark-green);
    font-weight: 600;
    transform: translateX(3px);
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .header-call-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #FFFFFF;
    font-size: 0.88rem;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.22);
    text-decoration: none;
    transition: var(--transition);
  }

  .header-call-btn i {
    color: var(--color-gold);
    font-size: 0.82rem;
  }

  .header-call-btn:hover {
    color: #FFFFFF;
    background: rgba(200, 169, 107, 0.22);
    border-color: var(--color-gold);
    transform: translateY(-1px);
  }

  .list-property-btn {
    padding: 9px 22px;
    font-size: 0.88rem;
    background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-light) 100%);
    color: var(--color-deep-green);
    border-radius: var(--radius-full);
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .list-property-btn:hover {
    background: var(--color-gold);
    box-shadow: var(--gold-glow);
    transform: translateY(-1px);
  }

  .mobile-toggle {
    display: none;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(200, 169, 107, 0.35);
    color: #FFFFFF;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.15rem;
    transition: var(--transition);
  }

  .mobile-toggle:hover {
    background: rgba(200, 169, 107, 0.2);
    border-color: var(--color-gold);
  }

  /* Mobile Drawer Overlay */
  .mobile-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(15, 30, 24, 0.65);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s;
  }

  .mobile-drawer-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #1F362E;
    border-bottom: 2px solid var(--color-gold);
    padding: 20px 0 30px;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
    box-shadow: 0 24px 50px rgba(10, 20, 16, 0.6);
    z-index: 999;
  }

  .mobile-drawer.open {
    display: block;
    animation: fadeInDrawer 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeInDrawer {
    from { opacity: 0; transform: translateY(-12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .mobile-drawer-brand {
    padding: 0 16px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 16px;
  }

  .mobile-section-divider {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--color-gold);
    font-weight: 700;
    padding: 12px 16px 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 8px;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 24px;
  }

  .mobile-nav-link {
    font-size: 0.96rem;
    font-weight: 500;
    color: #E2ECE7;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .mobile-nav-link:hover, .mobile-nav-link:active {
    color: #FFFFFF;
    background: rgba(63, 107, 91, 0.4);
  }

  @media (max-width: 1060px) {
    .desktop-nav, .header-call-btn {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }
  }

  @media (max-width: 520px) {
    .site-header {
      padding: 12px 0;
    }
    .logo-brand {
      font-size: 1rem;
    }
    .logo-sub {
      font-size: 0.55rem;
      letter-spacing: 1.2px;
    }
    .list-property-btn {
      padding: 8px 14px;
      font-size: 0.8rem;
    }
    .list-property-btn span {
      display: none;
    }
    .list-property-btn::after {
      content: 'List';
      display: inline;
    }
    .header-actions {
      gap: 10px;
    }
    .mobile-toggle {
      width: 38px;
      height: 38px;
      font-size: 1.05rem;
    }
  }

  @media (max-width: 360px) {
    .logo-crest {
      width: 34px;
      height: 34px;
    }
    .logo-brand {
      font-size: 0.9rem;
    }
  }
</style>

<script>
  // Shrinking & smart hide/reveal header script (Performance-friendly requestAnimationFrame)
  let lastScrollY = window.scrollY;
  let ticking = false;
  const header = document.getElementById('siteHeader');
  const toggleBtn = document.getElementById('mobileMenuToggle');
  const drawer = document.getElementById('mobileDrawer');
  const overlay = document.getElementById('mobileDrawerOverlay');
  const menuBars = document.getElementById('menuBarsIcon');
  const menuClose = document.getElementById('menuCloseIcon');

  function updateHeader() {
    const currentScrollY = window.scrollY;

    if (currentScrollY > 60) {
      header?.classList.add('header-shrunk');
    } else {
      header?.classList.remove('header-shrunk');
    }

    if (currentScrollY > 200 && currentScrollY > lastScrollY && !drawer?.classList.contains('open')) {
      // Scrolling down -> hide header
      header?.classList.add('header-hidden');
    } else {
      // Scrolling up or at top -> reveal header smoothly
      header?.classList.remove('header-hidden');
    }

    lastScrollY = currentScrollY;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(updateHeader);
      ticking = true;
    }
  }, { passive: true });

  function closeMobileDrawer() {
    drawer?.classList.remove('open');
    overlay?.classList.remove('active');
    toggleBtn?.setAttribute('aria-expanded', 'false');
    if (menuBars && menuClose) {
      menuBars.style.display = 'block';
      menuClose.style.display = 'none';
    }
  }

  // Mobile menu toggle
  toggleBtn?.addEventListener('click', () => {
    const isOpen = drawer?.classList.toggle('open');
    overlay?.classList.toggle('active', !!isOpen);
    toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    if (menuBars && menuClose) {
      menuBars.style.display = isOpen ? 'none' : 'block';
      menuClose.style.display = isOpen ? 'block' : 'none';
    }
  });

  // Close when clicking overlay or mobile nav link
  overlay?.addEventListener('click', closeMobileDrawer);
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', closeMobileDrawer);
  });
</script>
