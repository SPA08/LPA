    <!-- Desktop Navigation Links -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        <li>
          <a href="/" class:list={['nav-link', { active: currentPath === '/' }]}>
            <span>Home</span>
          </a>
        </li>
        <li>
          <a href="/#properties" class="nav-link">
            <span>Properties</span>
          </a>
        </li>
        <li>
          <a href="/#areas" class="nav-link">
            <span>Market Map</span>
          </a>
        </li>

        <!-- City & Guides 2-Column Mega Dropdown -->
        <li class="nav-dropdown-wrapper">
          <a href="/chichawatni-city-guide.html" class="nav-link dropdown-trigger">
