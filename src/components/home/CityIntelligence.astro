---
import { cityPlaces } from '@/data/cityIntelligence';
import { business } from '@/data/business';

const categories = [
  { id: 'all', label: 'All Places', icon: 'fa-layer-group', count: cityPlaces.length },
  { id: 'Education', label: 'Schools & Colleges', icon: 'fa-graduation-cap', count: cityPlaces.filter(p => p.category === 'Education').length },
  { id: 'Health', label: 'Hospitals & Healthcare', icon: 'fa-hospital', count: cityPlaces.filter(p => p.category === 'Health').length },
  { id: 'Government', label: 'Land Records & Govt', icon: 'fa-building-columns', count: cityPlaces.filter(p => p.category === 'Government').length },
  { id: 'Banking', label: 'Banks & ATMs', icon: 'fa-money-bill-transfer', count: cityPlaces.filter(p => p.category === 'Banking').length },
  { id: 'Safety', label: 'Safety & Emergency', icon: 'fa-shield-halved', count: cityPlaces.filter(p => p.category === 'Safety').length },
  { id: 'Real Estate', label: 'Real Estate & Heritage', icon: 'fa-landmark', count: cityPlaces.filter(p => p.category === 'Real Estate' || p.category === 'Services').length },
];
---

<section id="city-intelligence" class="city-intelligence-section">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">
        <i class="fa-solid fa-compass highlight-gold"></i>
        <span>LOCAL PLACE INTELLIGENCE</span>
      </span>
      <h2>
        Everything Around <span class="editorial-italic highlight-gold">Chichawatni</span>
      </h2>
      <p>
        Real community infrastructure, schools, hospitals, land registry centers, and civic landmarks that define property value and everyday family life across Tehsil Chichawatni.
      </p>
    </div>

    <!-- Category Tabs Filter Row -->
    <div class="intel-tabs-wrapper">
      <div class="intel-tabs-row" role="tablist" aria-label="City Intelligence Categories">
        {categories.map((cat, idx) => (
          <button
            class:list={['intel-tab-btn', { active: idx === 0 }]}
            data-category={cat.id}
            onclick="window.filterCityPlaces(this);"
          >
            <i class={`fa-solid ${cat.icon}`}></i>
            <span>{cat.label}</span>
            <span class="intel-count-pill">{cat.count}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Place Search & Stats Bar -->
    <div class="intel-search-bar-row">
      <div class="intel-search-box">
        <i class="fa-solid fa-magnifying-glass search-icon"></i>
        <input
          type="text"
          id="intelPlaceSearchInput"
          placeholder="Search by school, hospital, bank, road or office..."
          class="intel-search-input"
          oninput="window.searchCityPlaces(this.value);"
        />
      </div>
      <div class="intel-stat-notice">
        Showing <strong id="intelVisibleCount">{cityPlaces.length}</strong> verified civic locations in Chichawatni
      </div>
    </div>

    <!-- Places Cards Grid -->
    <div class="intel-cards-grid" id="intelPlacesGrid">
      {cityPlaces.map(place => (
        <article
          class="intel-card v4-card"
          data-id={place.id}
          data-category={place.category === 'Services' ? 'Real Estate' : place.category}
          data-search={`${place.name} ${place.locality} ${place.roadAddress} ${place.subCategory} ${place.usefulness}`.toLowerCase()}
        >
          <!-- Card Header -->
          <div class="intel-card-header">
            <div class="intel-icon-crest">
              {place.category === 'Education' && <i class="fa-solid fa-graduation-cap"></i>}
              {place.category === 'Health' && <i class="fa-solid fa-heart-pulse"></i>}
              {place.category === 'Government' && <i class="fa-solid fa-landmark-dome"></i>}
              {place.category === 'Banking' && <i class="fa-solid fa-building-columns"></i>}
              {place.category === 'Safety' && <i class="fa-solid fa-shield-halved"></i>}
              {place.category === 'Real Estate' && <i class="fa-solid fa-house-chimney"></i>}
              {place.category === 'Services' && <i class="fa-solid fa-landmark"></i>}
            </div>

            <div class="intel-meta-top">
              <span class="intel-category-pill">{place.subCategory}</span>
              {place.distanceFromCenter && (
                <span class="intel-dist-pill">
                  <i class="fa-solid fa-route"></i> {place.distanceFromCenter}
                </span>
              )}
            </div>
          </div>

          <!-- Card Body -->
          <div class="intel-card-body">
            <h3 class="intel-place-name">{place.name}</h3>

            <div class="intel-address-line">
              <i class="fa-solid fa-location-dot highlight-gold"></i>
              <span><strong>{place.locality}</strong> • {place.roadAddress}</span>
            </div>

            <p class="intel-usefulness">
              {place.usefulness}
            </p>

            <!-- Highlights Tags -->
            <div class="intel-tags-row">
              {place.highlights.map(tag => (
                <span class="intel-tag">{tag}</span>
              ))}
            </div>
          </div>

          <!-- Card Footer -->
          <div class="intel-card-footer">
            {place.contactOrTiming && (
              <div class="intel-timing">
                <i class="fa-regular fa-clock"></i>
                <span>{place.contactOrTiming}</span>
              </div>
            )}
            <div class="intel-actions">
              <button
                class="btn-intel-map"
                onclick={`window.focusPlaceOnMap('${place.id}', ${place.lat}, ${place.lng}, '${place.name.replace(/'/g, "\\'")}');`}
              >
                <i class="fa-solid fa-map-location-dot"></i> View on Map
              </button>
              <a
                href={`https://wa.me/923063996764?text=${encodeURIComponent(`Hello Naeem Siddhu, I have an inquiry regarding area near ${place.name} in Chichawatni.`)}`}
                target="_blank"
                rel="noopener"
                class="btn-intel-inquire"
                aria-label={`Inquire about property near ${place.name}`}
              >
                <i class="fa-brands fa-whatsapp"></i> Inquire Area
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State for Search -->
    <div id="intelEmptyState" class="empty-state-card glass-panel" style="display: none; margin-top: 30px;">
      <div class="empty-icon"><i class="fa-solid fa-map-pin"></i></div>
      <h3>No matching civic locations found</h3>
      <p>Try searching for a different term like "School", "Hospital", "Bank", "Tower Road", or "PLRA".</p>
      <button class="btn-primary" onclick="window.resetCityPlaceSearch();" style="margin-top: 14px;">
        <i class="fa-solid fa-rotate-left"></i> View All Locations
      </button>
    </div>
  </div>
</section>

<style>
  .city-intelligence-section {
    padding: 90px 0;
    background: #F7F7F3;
    position: relative;
    border-top: 1px solid #E2E6E3;
    border-bottom: 1px solid #E2E6E3;
  }

  /* Category Filter Tabs */
  .intel-tabs-wrapper {
    margin-bottom: 24px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 6px;
  }

  .intel-tabs-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: nowrap;
    min-width: max-content;
  }

  .intel-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: var(--radius-full);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    white-space: nowrap;
  }

  .intel-tab-btn i {
    color: var(--color-matte-green);
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .intel-tab-btn:hover {
    border-color: var(--color-matte-green);
    color: var(--color-dark-green);
    background: #FCFCFA;
    transform: translateY(-1px);
  }

  .intel-tab-btn.active {
    background: var(--color-dark-green);
    border-color: var(--color-dark-green);
    color: #FFFFFF;
    box-shadow: 0 4px 14px rgba(41, 71, 61, 0.22);
  }

  .intel-tab-btn.active i {
    color: var(--color-gold);
  }

  .intel-count-pill {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: var(--radius-full);
    background: rgba(41, 71, 61, 0.08);
    color: var(--color-dark-green);
  }

  .intel-tab-btn.active .intel-count-pill {
    background: rgba(255, 255, 255, 0.2);
    color: #FFFFFF;
  }

  /* Search & Stats Bar */
  .intel-search-bar-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .intel-search-box {
    position: relative;
    flex-grow: 1;
    max-width: 520px;
  }

  .intel-search-box .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-matte-green);
    font-size: 0.95rem;
  }

  .intel-search-input {
    width: 100%;
    padding: 12px 18px 12px 44px;
    border-radius: var(--radius-full);
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    font-size: 0.92rem;
    color: var(--text-primary);
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
  }

  .intel-search-input:focus {
    outline: none;
    border-color: var(--color-matte-green);
    box-shadow: 0 0 0 3px rgba(63, 107, 91, 0.15);
  }

  .intel-stat-notice {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .intel-stat-notice strong {
    color: var(--color-dark-green);
  }

  /* Places Cards Grid */
  .intel-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .intel-card {
    background: #FFFFFF;
    border: 1px solid var(--border-card);
    border-radius: var(--radius-card);
    padding: 24px;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: var(--transition);
  }

  .intel-card:hover {
    border-color: rgba(63, 107, 91, 0.4);
    box-shadow: 0 16px 32px -4px rgba(41, 71, 61, 0.1);
    transform: translateY(-4px);
  }

  .intel-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 16px;
  }

  .intel-icon-crest {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(63, 107, 91, 0.1);
    border: 1px solid rgba(63, 107, 91, 0.2);
    color: var(--color-dark-green);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    flex-shrink: 0;
  }

  .intel-meta-top {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .intel-category-pill {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-matte-green);
    background: rgba(63, 107, 91, 0.08);
    padding: 3px 9px;
    border-radius: var(--radius-full);
  }

  .intel-dist-pill {
    font-size: 0.72rem;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .intel-dist-pill i {
    color: var(--color-gold);
    font-size: 0.68rem;
  }

  .intel-card-body {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 20px;
  }

  .intel-place-name {
    font-size: 1.18rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .intel-address-line {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .intel-address-line i {
    margin-top: 3px;
    flex-shrink: 0;
  }

  .intel-usefulness {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .intel-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  .intel-tag {
    font-size: 0.74rem;
    font-weight: 500;
    background: #F3F5F4;
    color: var(--text-secondary);
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid #E6EAE8;
  }

  .intel-card-footer {
    border-top: 1px solid #EEF1EF;
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .intel-timing {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .intel-timing i {
    color: var(--color-gold);
  }

  .intel-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .btn-intel-map {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: var(--radius-full);
    background: #FAFBF9;
    border: 1px solid var(--border-subtle);
    color: var(--color-dark-green);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
  }

  .btn-intel-map:hover {
    background: var(--color-dark-green);
    color: #FFFFFF;
    border-color: var(--color-dark-green);
  }

  .btn-intel-map i {
    color: var(--color-gold);
  }

  .btn-intel-map:hover i {
    color: #FFFFFF;
  }

  .btn-intel-inquire {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: var(--radius-full);
    background: rgba(37, 211, 102, 0.1);
    border: 1px solid rgba(37, 211, 102, 0.3);
    color: #15803D;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition);
  }

  .btn-intel-inquire:hover {
    background: #25D366;
    color: #FFFFFF;
    border-color: #25D366;
  }

  /* Responsive Rules */
  @media (max-width: 1100px) {
    .intel-cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }
  }

  @media (max-width: 680px) {
    .city-intelligence-section {
      padding: 60px 0;
    }
    .intel-cards-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .intel-actions {
      grid-template-columns: 1fr;
    }
    .intel-search-box {
      max-width: 100%;
    }
  }
</style>

<script is:inline>
  let activeIntelCategory = 'all';

  window.filterCityPlaces = function(buttonEl) {
    const category = buttonEl.getAttribute('data-category');
    activeIntelCategory = category;

    // Update active button state
    document.querySelectorAll('.intel-tab-btn').forEach(btn => btn.classList.remove('active'));
    buttonEl.classList.add('active');

    applyIntelFilter();
  };

  window.searchCityPlaces = function(keyword) {
    applyIntelFilter(keyword);
  };

  function applyIntelFilter(keyword = null) {
    const inputVal = keyword !== null ? keyword : (document.getElementById('intelPlaceSearchInput')?.value || '');
    const searchLower = inputVal.toLowerCase().trim();

    const cards = document.querySelectorAll('.intel-card');
    let visibleCount = 0;

    cards.forEach(card => {
      const cardCategory = card.getAttribute('data-category');
      const cardSearchText = card.getAttribute('data-search') || '';

      const matchesCategory = (activeIntelCategory === 'all' || cardCategory === activeIntelCategory);
      const matchesSearch = (!searchLower || cardSearchText.includes(searchLower));

      if (matchesCategory && matchesSearch) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    const countEl = document.getElementById('intelVisibleCount');
    if (countEl) countEl.textContent = visibleCount;

    const emptyNotice = document.getElementById('intelEmptyState');
    if (emptyNotice) {
      emptyNotice.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  window.resetCityPlaceSearch = function() {
    const input = document.getElementById('intelPlaceSearchInput');
    if (input) input.value = '';
    const allBtn = document.querySelector('.intel-tab-btn[data-category="all"]');
    if (allBtn) window.filterCityPlaces(allBtn);
  };

  window.focusPlaceOnMap = function(placeId, lat, lng, placeName) {
    const mapSection = document.getElementById('areas');
    if (mapSection) {
      mapSection.scrollIntoView({ behavior: 'smooth' });
    }
    if (typeof window.flyToMapCoordinates === 'function') {
      window.flyToMapCoordinates(lat, lng, placeName, placeId);
    }
  };
</script>
