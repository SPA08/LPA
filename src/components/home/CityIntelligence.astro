</style>

<script is:inline>
  let activeIntelCategory = 'all';
  let allCardsExpanded = false;

  const categoryGuideMap = {
    'all': {
      text: 'Looking for all verified civic locations across Tehsil Chichawatni?',
      btnText: 'Explore Master Directory (25+ Places)',
      url: '/chichawatni-property-directory/index.html'
    },
    'Education': {
      text: 'Need verified admission & transport details for family residences?',
      btnText: 'Explore Schools & Colleges Guide',
      url: '/chichawatni-schools-guide.html'
    },
    'Health': {
      text: 'Looking for 24/7 trauma emergency centers & clinical routes?',
      btnText: 'Explore Hospitals & Clinics Guide',
      url: '/chichawatni-hospitals-guide.html'
    },
    'Government': {
      text: 'Conducting PLRA title deeds, Fard verification & Tehsil registrations?',
      btnText: 'Explore Land Records & Govt Guide',
      url: '/chichawatni-public-offices.html'
    },
    'Banking': {
      text: 'Need CDR pay orders, demand drafts & branch banking information?',
      btnText: 'Explore Commercial Directory',
      url: '/chichawatni-property-directory/index.html'
    },
    'Safety': {
      text: 'Need emergency response stations & police jurisdiction mapping?',
      btnText: 'Explore Emergency Services Guide',
      url: '/chichawatni-public-offices.html'
    },
    'Real Estate': {
      text: 'Exploring major housing colonies, commercial zones & land corridors?',
      btnText: 'Explore Residential Colonies Guide',
      url: '/chichawatni-residential-colonies-guide.html'
    }
  };

  // Carousel slider function
  window.slideIntelCards = function(direction) {
    const track = document.getElementById('intelPlacesTrack');
    if (!track) return;
    const visibleSlides = Array.from(track.querySelectorAll('.intel-card-slide')).filter(s => s.style.display !== 'none');
    if (!visibleSlides.length) return;
    const slideWidth = visibleSlides[0].offsetWidth + 20;
    track.scrollBy({
      left: direction * slideWidth,
      behavior: 'smooth'
    });
  };

  // Select Category from top summary cards
  window.selectCategoryFromSummary = function(categoryId) {
    const tabBtn = document.querySelector(`.intel-tab-btn[data-category="${categoryId}"]`);
    if (tabBtn) {
      window.filterCityPlaces(tabBtn);
      const tabsWrapper = document.getElementById('intelTabsWrapper');
      if (tabsWrapper) {
        tabsWrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  };

  // Filter City Places by category tab
  window.filterCityPlaces = function(buttonEl) {
    const category = buttonEl.getAttribute('data-category');
    activeIntelCategory = category;

    // Update active tab button
    document.querySelectorAll('.intel-tab-btn').forEach(btn => btn.classList.remove('active'));
    buttonEl.classList.add('active');

    // Reset track scroll
    const track = document.getElementById('intelPlacesTrack');
    if (track) track.scrollLeft = 0;

    // Update Category Guide Banner
    const guideConfig = categoryGuideMap[category] || categoryGuideMap['all'];
    const guideText = document.getElementById('intelGuideText');
    const guideBtnText = document.getElementById('intelGuideBtnText');
    const guideLink = document.getElementById('intelGuideLink');
    if (guideText) guideText.textContent = guideConfig.text;
    if (guideBtnText) guideBtnText.textContent = guideConfig.btnText;
    if (guideLink) guideLink.href = guideConfig.url;

    applyIntelFilter();
  };

  // Search input handler
  window.searchCityPlaces = function(keyword) {
    const clearBtn = document.getElementById('intelClearSearchBtn');
    if (clearBtn) {
      clearBtn.style.display = keyword && keyword.length > 0 ? 'block' : 'none';
    }
    applyIntelFilter(keyword);
  };

  // Clear search input
  window.clearSearchInput = function() {
    const input = document.getElementById('intelPlaceSearchInput');
    if (input) input.value = '';
    const clearBtn = document.getElementById('intelClearSearchBtn');
    if (clearBtn) clearBtn.style.display = 'none';
    applyIntelFilter('');
  };

  function applyIntelFilter(keyword = null) {
    const inputVal = keyword !== null ? keyword : (document.getElementById('intelPlaceSearchInput')?.value || '');
    const searchLower = inputVal.toLowerCase().trim();

    const slides = document.querySelectorAll('#intelPlacesTrack .intel-card-slide');
    let visibleCount = 0;
    let totalInCat = 0;

    slides.forEach(slide => {
      const cardCategory = slide.getAttribute('data-category');
      const cardSearchText = slide.getAttribute('data-search') || '';

      const matchesCategory = (activeIntelCategory === 'all' || cardCategory === activeIntelCategory);
      const matchesSearch = (!searchLower || cardSearchText.includes(searchLower));

      if (matchesCategory) {
        totalInCat++;
      }

      if (matchesCategory && matchesSearch) {
        slide.style.display = 'flex';
        visibleCount++;
      } else {
        slide.style.display = 'none';
      }
    });

    const countEl = document.getElementById('intelVisibleCount');
    if (countEl) countEl.textContent = Math.min(4, visibleCount);

    const totalEl = document.getElementById('intelTotalCatCount');
    if (totalEl) totalEl.textContent = visibleCount;

    const emptyNotice = document.getElementById('intelEmptyState');
    if (emptyNotice) {
      emptyNotice.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  // Toggle Single Card (Clicking Toggle Button)
  window.toggleCardButton = function(btn, event) {
    event?.stopPropagation();
    const card = btn.closest('.intel-card');
    if (!card) return;

    const isExpanded = card.classList.contains('expanded');
    if (isExpanded) {
      card.classList.remove('expanded');
      btn.setAttribute('aria-expanded', 'false');
      btn.querySelector('.toggle-label').textContent = 'View Civic Details';
    } else {
      card.classList.add('expanded');
      btn.setAttribute('aria-expanded', 'true');
      btn.querySelector('.toggle-label').textContent = 'Hide Details';
    }
  };

  // Toggle Single Card (Clicking Header/Body)
  window.toggleCardByElement = function(card) {
    if (!card) return;
    const btn = card.querySelector('.btn-intel-toggle');
    if (btn) {
      window.toggleCardButton(btn);
    }
  };

  // Toggle All Cards (Global Expand / Collapse)
  window.toggleAllIntelCards = function() {
    allCardsExpanded = !allCardsExpanded;
    const cards = document.querySelectorAll('.intel-card');
    const toggleBtnText = document.getElementById('toggleAllText');
    const toggleBtnIcon = document.getElementById('toggleAllIcon');

    cards.forEach(card => {
      const btn = card.querySelector('.btn-intel-toggle');
      if (allCardsExpanded) {
        card.classList.add('expanded');
        if (btn) {
          btn.setAttribute('aria-expanded', 'true');
          btn.querySelector('.toggle-label').textContent = 'Hide Details';
        }
      } else {
        card.classList.remove('expanded');
        if (btn) {
          btn.setAttribute('aria-expanded', 'false');
          btn.querySelector('.toggle-label').textContent = 'View Civic Details';
        }
      }
    });

    if (toggleBtnText) toggleBtnText.textContent = allCardsExpanded ? 'Collapse All' : 'Expand All';
    if (toggleBtnIcon) {
      toggleBtnIcon.className = allCardsExpanded ? 'fa-solid fa-chevron-up' : 'fa-solid fa-chevron-down';
    }
  };

  window.resetCityPlaceSearch = function() {
    window.clearSearchInput();
    const allBtn = document.querySelector('.intel-tab-btn[data-category="all"]');
    if (allBtn) window.filterCityPlaces(allBtn);
  };

  // Cross-component coordination with AreaExplorer Map
  window.focusPlaceOnMap = function(placeId, lat, lng, placeName) {
    const mapSection = document.getElementById('areas');
    if (mapSection) {
      mapSection.scrollIntoView({ behavior: 'smooth' });
    }
    if (typeof window.flyToMapCoordinates === 'function') {
      window.flyToMapCoordinates(lat, lng, placeName, placeId);
    }
  };
</script>
