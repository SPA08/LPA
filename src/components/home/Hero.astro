---
import { business } from '@/data/business';
import { localities } from '@/data/locations';
---

<section id="hero" class="hero-section">
  <!-- Cinematic Background with Real Pakistani Residential Photograph -->
  <div class="hero-bg-media">
    <img
      src="/assets/images/real-house-hero.jpg"
      alt="Residential Property in Chichawatni, Punjab"
      fetchpriority="high"
      class="hero-img"
    />
    <div class="hero-overlay"></div>
  </div>

  <div class="container hero-content">
    <!-- Top Verified Badge -->
    <div class="hero-badge-wrap">
      <div class="section-badge pulse-gold">
        <i class="fa-solid fa-crown highlight-gold"></i>
        <span>VERIFIED PROPERTY ADVISORY • CHICHAWATNI</span>
      </div>
    </div>

    <!-- Main Editorial Hero Title & Copy -->
    <div class="hero-text-block">
      <h1 class="hero-title">
        Property Dealer & <br />
        <span class="editorial-italic highlight-gold">Real Estate Advisor</span> in Chichawatni
      </h1>
      <p class="hero-description">
        Explore residential properties, compare local areas, and arrange direct site visits with <strong>{business.advisor}</strong>. Transparent guidance, verified Arazi Record Center checks, and zero phantom listings.
      </p>
    </div>

    <!-- Hero Action Buttons -->
    <div class="hero-actions">
      <a href="#properties" class="btn-primary">
        <i class="fa-solid fa-house"></i>
        <span>Browse Properties</span>
      </a>
      <a href="/sell-my-property/index.html" class="btn-outline">
        <i class="fa-solid fa-tag highlight-gold"></i>
        <span>List Your Property</span>
      </a>
      <a href="tel:+923063996764" class="btn-whatsapp">
        <i class="fa-solid fa-phone"></i>
        <span>Call Naeem Siddhu</span>
      </a>
    </div>

    <!-- Floating Trust Stats Row -->
    <div class="hero-stats-row glass-panel">
      <div class="stat-item">
        <div class="stat-icon"><i class="fa-solid fa-map-location-dot highlight-gold"></i></div>
        <div class="stat-text">
          <strong>Local Chichawatni</strong>
          <span>Street-Level Knowledge</span>
        </div>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <div class="stat-icon"><i class="fa-solid fa-file-shield highlight-teal"></i></div>
        <div class="stat-text">
          <strong>PLRA Fard Checks</strong>
          <span>Ownership Verification</span>
        </div>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <div class="stat-icon"><i class="fa-solid fa-house-circle-check highlight-gold"></i></div>
        <div class="stat-text">
          <strong>Direct Site Visits</strong>
          <span>Organized On-Ground Inspections</span>
        </div>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <div class="stat-icon"><i class="fa-solid fa-handshake highlight-teal"></i></div>
        <div class="stat-text">
          <strong>Fair Deal Facilitation</strong>
          <span>Direct Buyer-Seller Meeting</span>
        </div>
      </div>
    </div>

    <!-- Section 7: ADVANCED SMART PROPERTY FINDER -->
    <div class="search-finder-card glass-panel" id="propertyFinder">
      <div class="finder-header">
        <h3 class="finder-title"><i class="fa-solid fa-magnifying-glass highlight-gold"></i> Smart Property Finder</h3>
        <span class="finder-sub">Filter verified residential homes and plots</span>
      </div>

      <form id="finderForm" class="finder-grid" onsubmit="event.preventDefault(); window.executePropertySearch();">
        <!-- Field 1: Location -->
        <div class="finder-field">
          <label for="filterLocation"><i class="fa-solid fa-location-dot highlight-gold"></i> Location</label>
          <select id="filterLocation" class="finder-select">
            <option value="all">All Chichawatni Areas</option>
            {localities.filter(l => l.category === "Residential Locality").map(loc => (
              <option value={loc.name}>{loc.name}</option>
            ))}
          </select>
        </div>

        <!-- Field 2: Property Type -->
        <div class="finder-field">
          <label for="filterType"><i class="fa-solid fa-house-chimney highlight-gold"></i> Property Type</label>
          <select id="filterType" class="finder-select">
            <option value="all">All Property Types</option>
            <option value="residential">Residential House</option>
            <option value="plot">Residential Plot</option>
            <option value="commercial">Commercial Shop / Plaza</option>
          </select>
        </div>

        <!-- Field 3: Buy / Rent -->
        <div class="finder-field">
          <label for="filterListingType"><i class="fa-solid fa-tags highlight-gold"></i> Purpose</label>
          <select id="filterListingType" class="finder-select">
            <option value="sale">For Sale (Purchase)</option>
            <option value="rent">For Rent</option>
          </select>
        </div>

        <!-- Field 4: Marla Size -->
        <div class="finder-field">
          <label for="filterSize"><i class="fa-solid fa-ruler-combined highlight-gold"></i> Size (Marla)</label>
          <select id="filterSize" class="finder-select">
            <option value="all">Any Size</option>
            <option value="3">3 Marla</option>
            <option value="4">4 Marla</option>
            <option value="5">5 Marla</option>
            <option value="7">7 Marla</option>
            <option value="8">8 Marla</option>
            <option value="10">10 Marla</option>
            <option value="12">12 Marla</option>
          </select>
        </div>

        <!-- Submit & Reset Buttons -->
        <div class="finder-actions">
          <button type="submit" class="btn-primary finder-btn">
            <i class="fa-solid fa-magnifying-glass"></i>
            <span>Search</span>
          </button>
          <button type="button" id="resetFinderBtn" class="btn-outline finder-reset-btn" onclick="window.resetPropertySearch();">
            <i class="fa-solid fa-rotate-left"></i>
            <span>Reset</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    padding: 60px 0 80px;
    overflow: hidden;
  }

  .hero-bg-media {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    transform: scale(1.03);
    filter: brightness(0.65) contrast(1.1);
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      180deg,
      rgba(13, 23, 35, 0.75) 0%,
      rgba(13, 23, 35, 0.88) 50%,
      rgba(13, 23, 35, 0.98) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 1180px;
  }

  .hero-badge-wrap {
    display: flex;
  }

  .hero-text-block {
    max-width: 820px;
  }

  .hero-title {
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }

  .hero-description {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  /* Floating Stats */
  .hero-stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 20px 28px;
    align-items: center;
    margin-top: 10px;
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .stat-icon {
    font-size: 1.8rem;
  }

  .stat-text {
    display: flex;
    flex-direction: column;
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .stat-text strong {
    color: var(--text-primary);
    font-size: 0.95rem;
  }

  .stat-text span {
    color: var(--text-muted);
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--border-glass);
    margin: 0 auto;
    display: none;
  }

  /* Smart Property Finder */
  .search-finder-card {
    padding: 28px 32px;
    margin-top: 10px;
    border: 1px solid var(--border-card);
    background: rgba(20, 34, 48, 0.85);
  }

  .finder-header {
    margin-bottom: 20px;
  }

  .finder-title {
    font-size: 1.3rem;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .finder-sub {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .finder-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr auto;
    gap: 16px;
    align-items: flex-end;
  }

  .finder-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .finder-field label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .finder-select {
    width: 100%;
    background: #0D1723;
    border: 1px solid var(--border-glass);
    color: var(--text-primary);
    padding: 12px 14px;
    border-radius: var(--radius-control);
    font-size: 0.92rem;
    font-family: inherit;
    transition: var(--transition);
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23B88A3B' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 14px center;
    background-size: 14px;
  }

  .finder-select:focus {
    outline: none;
    border-color: var(--accent-gold);
    box-shadow: 0 0 0 3px rgba(184, 138, 59, 0.15);
  }

  .finder-actions {
    display: flex;
    gap: 8px;
  }

  .finder-btn {
    height: 48px;
    padding: 0 22px;
    white-space: nowrap;
  }

  .finder-reset-btn {
    height: 48px;
    padding: 0 16px;
    font-size: 0.88rem;
  }

  @media (max-width: 1100px) {
    .finder-grid {
      grid-template-columns: 1fr 1fr;
    }
    .finder-actions {
      grid-column: span 2;
    }
    .hero-stats-row {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .finder-grid {
      grid-template-columns: 1fr;
    }
    .finder-actions {
      grid-column: span 1;
    }
    .hero-stats-row {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
