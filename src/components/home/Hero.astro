---
import { business } from '@/data/business';
import { localities } from '@/data/locations';
---

<section id="hero" class="hero-section">
  <!-- Subtle ambient decorative glow -->
  <div class="hero-glow-bg"></div>

  <div class="container hero-container">
    <!-- Top 2-Column Showcase (Matching Approved Design Screenshot) -->
    <div class="hero-split-grid">
      <!-- Left Column: Editorial Headline & Actions -->
      <div class="hero-editorial-col">
        <!-- Main Headline with Signature Inline Pill Images -->
        <h1 class="hero-main-title">
          Discover Your 
          <span class="headline-pill-img">
            <img src="/assets/images/house-10marla-corner.jpg" alt="Model Town Corner Residence" width="78" height="44" />
          </span>
          <br />
          Dream Property
          <br />
          Today 
          <span class="headline-pill-img">
            <img src="/assets/images/house-signature.jpg" alt="Signature Family Residence" width="78" height="44" />
          </span>
        </h1>

        <!-- Subtitle Paragraph -->
        <p class="hero-subtitle">
          Discovering the ideal property that perfectly suits your lifestyle and budget in Chichawatni is an exciting and fulfilling journey with <strong>{business.advisor}</strong>.
        </p>

        <!-- CTA Buttons Row -->
        <div class="hero-cta-row">
          <a href="#propertyFinder" class="btn-primary hero-search-pill-btn">
            <i class="fa-solid fa-magnifying-glass"></i>
            <span>Search Your Property</span>
          </a>
          <a href="#properties" class="btn-outline hero-learn-pill-btn">
            <span>Learn More</span>
          </a>
          <a href={business.whatsappUrl} target="_blank" rel="noopener" class="btn-whatsapp hero-wa-pill-btn" aria-label="WhatsApp Naeem Siddhu">
            <i class="fa-brands fa-whatsapp"></i>
            <span>WhatsApp</span>
          </a>
        </div>

        <!-- Social Proof Reviews Row (Matching Approved Screenshot) -->
        <div class="hero-reviews-proof">
          <div class="avatar-stack">
            <div class="avatar-circle av-1">
              <i class="fa-solid fa-user"></i>
            </div>
            <div class="avatar-circle av-2">
              <i class="fa-solid fa-user-check"></i>
            </div>
            <div class="avatar-circle av-3">
              <i class="fa-solid fa-user-tie"></i>
            </div>
          </div>

          <div class="rating-details">
            <div class="stars-group">
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
            </div>
            <span class="rating-caption">
              <strong>4.9 / 5</strong> based on verified local reviews
            </span>
          </div>
        </div>
      </div>

      <!-- Right Column: Visual Architectural Showcase with Floating Chips & Property Card -->
      <div class="hero-showcase-col">
        <div class="showcase-visual-wrapper">
          <!-- Main Architectural Building Photo: 5 Marla Double Story House (Tower Road, Hayat Abad) -->
          <div class="showcase-img-frame">
            <img
              src="/assets/images/house-5marla-brandnew.jpg"
              alt="5 Marla Double Story House in Tower Road, Hayat Abad, Chichawatni"
              class="showcase-img"
              fetchpriority="high"
            />
            <div class="showcase-fade-mask"></div>
          </div>

          <!-- Floating Chip 1: Expert Guidance (Top) -->
          <div class="floating-chip chip-expert">
            <span class="chip-icon purple">
              <i class="fa-solid fa-id-card-clip"></i>
            </span>
            <span>Expert Guidance</span>
          </div>

          <!-- Floating Chip 2: Time Efficiency (Top Right) -->
          <div class="floating-chip chip-time">
            <span class="chip-icon green">
              <i class="fa-regular fa-clock"></i>
            </span>
            <span>Time Efficiency</span>
          </div>

          <!-- Floating Chip 3: Legal Support (Bottom Left) -->
          <div class="floating-chip chip-legal">
            <span class="chip-icon blue">
              <i class="fa-solid fa-headphones"></i>
            </span>
            <span>Legal Support</span>
          </div>

          <!-- Floating Property Preview Card (Bottom Right): Contemporary Family Home (Green Town / Sahiwal Road) -->
          <a href="#properties" class="floating-preview-card" aria-label="View Contemporary Family Home">
            <div class="preview-card-img-wrap">
              <img
                src="/assets/images/house-contemporary.jpg"
                alt="Contemporary Family Home in Green Town / Sahiwal Road"
                class="preview-card-img"
              />
              <div class="preview-arrow-btn">
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
              </div>
            </div>
            <div class="preview-card-text">
              <h4 class="preview-card-title">Contemporary Family Home</h4>
              <p class="preview-card-sub hero-location-blur">
                <i class="fa-solid fa-location-dot highlight-gold"></i>
                <span class="blurred-address-hero">Green Town / Sahiwal Road</span>
                <span class="confidential-badge-mini"><i class="fa-solid fa-lock"></i> Protected</span>
              </p>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Section 2B: Trust Highlights Strip -->
    <div class="hero-trust-strip glass-panel">
      <div class="trust-stat-item">
        <div class="trust-icon-box"><i class="fa-solid fa-location-dot highlight-gold"></i></div>
        <div class="trust-stat-text">
          <strong>Local Chichawatni</strong>
          <span>Street-level property expertise</span>
        </div>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-stat-item">
        <div class="trust-icon-box"><i class="fa-solid fa-file-shield highlight-teal"></i></div>
        <div class="trust-stat-text">
          <strong>PLRA Fard Checks</strong>
          <span>Arazi Record Center title due diligence</span>
        </div>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-stat-item">
        <div class="trust-icon-box"><i class="fa-solid fa-house-circle-check highlight-gold"></i></div>
        <div class="trust-stat-text">
          <strong>Direct Site Visits</strong>
          <span>In-person physical inspections</span>
        </div>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-stat-item">
        <div class="trust-icon-box"><i class="fa-solid fa-handshake highlight-teal"></i></div>
        <div class="trust-stat-text">
          <strong>Fair Deal Facilitation</strong>
          <span>Transparent buyer & seller meetings</span>
        </div>
      </div>
    </div>

    <!-- Section 2C: Advanced Smart Property Finder (Clean Modern Style) -->
    <div class="search-finder-card glass-panel" id="propertyFinder">
      <div class="finder-header">
        <div class="finder-header-left">
          <span class="section-badge"><i class="fa-solid fa-magnifying-glass"></i> PROPERTY SEARCH</span>
          <h3 class="finder-title">Smart Property Finder</h3>
        </div>
        <span class="finder-sub">Filter genuine family homes, plots, and locations in Chichawatni</span>
      </div>

      <form id="finderForm" class="finder-grid" onsubmit="event.preventDefault(); window.executePropertySearch();">
        <!-- Field 1: Location -->
        <div class="finder-field">
          <label for="filterLocation"><i class="fa-solid fa-location-dot highlight-gold"></i> Locality</label>
          <select id="filterLocation" class="finder-select">
            <option value="all">All Chichawatni Areas</option>
            {localities.map(loc => (
              <option value={loc.name}>{loc.name}</option>
            ))}
          </select>
        </div>

        <!-- Field 2: Property Type -->
        <div class="finder-field">
          <label for="filterType"><i class="fa-solid fa-house-chimney highlight-gold"></i> Type</label>
          <select id="filterType" class="finder-select">
            <option value="all">All Property Types</option>
            <option value="residential">Residential House</option>
            <option value="plot">Residential Plot</option>
            <option value="commercial">Commercial Shop / Plaza</option>
          </select>
        </div>

        <!-- Field 3: Purpose -->
        <div class="finder-field">
          <label for="filterListingType"><i class="fa-solid fa-tag highlight-gold"></i> Purpose</label>
          <select id="filterListingType" class="finder-select">
            <option value="sale">For Sale (Purchase)</option>
            <option value="rent">For Rent</option>
          </select>
        </div>

        <!-- Field 4: Size -->
        <div class="finder-field">
          <label for="filterSize"><i class="fa-solid fa-ruler-combined highlight-gold"></i> Size (Marla)</label>
          <select id="filterSize" class="finder-select">
            <option value="all">Any Size</option>
            <option value="3">3 Marla</option>
            <option value="4">4 Marla</option>
            <option value="5">5 Marla</option>
            <option value="7">7 Marla</option>
            <option value="8">8 Marla</option>
            <option value="10">10 Marla</option>
            <option value="12">12 Marla</option>
          </select>
        </div>

        <!-- Submit & Reset Buttons -->
        <div class="finder-actions">
          <button type="submit" class="btn-primary finder-btn">
            <i class="fa-solid fa-magnifying-glass"></i>
            <span>Search</span>
          </button>
          <button type="button" id="resetFinderBtn" class="btn-outline finder-reset-btn" onclick="window.resetPropertySearch();">
            <i class="fa-solid fa-rotate-left"></i>
            <span>Reset</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 40px 0 70px;
    background: #FFFFFF;
    overflow: hidden;
  }

  .hero-glow-bg {
    position: absolute;
    top: -120px;
    right: -100px;
    width: 650px;
    height: 650px;
    background: radial-gradient(circle, rgba(13, 148, 136, 0.05) 0%, rgba(184, 138, 59, 0.04) 50%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* 2-Column Split Grid */
  .hero-split-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
    padding-top: 10px;
  }

  /* Left Column */
  .hero-editorial-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 640px;
  }

  .hero-main-title {
    font-size: clamp(2.4rem, 4.4vw, 4.2rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #0F172A;
  }

  .hero-subtitle {
    font-size: 1.12rem;
    line-height: 1.65;
    color: #475569;
    max-width: 540px;
  }

  .hero-cta-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .hero-search-pill-btn {
    padding: 14px 28px;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .hero-learn-pill-btn {
    padding: 14px 26px;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .hero-wa-pill-btn {
    padding: 14px 24px;
    font-size: 0.95rem;
  }

  /* Social Proof Reviews */
  .hero-reviews-proof {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 6px;
    padding-top: 8px;
  }

  .avatar-stack {
    display: flex;
    align-items: center;
  }

  .avatar-circle {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 2.5px solid #FFFFFF;
    margin-left: -10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.12);
  }

  .avatar-circle:first-child {
    margin-left: 0;
  }

  .avatar-circle.av-1 { background: #3B82F6; }
  .avatar-circle.av-2 { background: #10B981; }
  .avatar-circle.av-3 { background: #B88A3B; }

  .rating-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stars-group {
    color: #F59E0B;
    font-size: 0.9rem;
    display: flex;
    gap: 3px;
  }

  .rating-caption {
    font-size: 0.84rem;
    color: #64748B;
  }

  .rating-caption strong {
    color: #0F172A;
  }

  /* Right Column Visual Showcase */
  .hero-showcase-col {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .showcase-visual-wrapper {
    position: relative;
    width: 100%;
    max-width: 560px;
    height: 520px;
  }

  .showcase-img-frame {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.14);
  }

  .showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.02);
    transition: transform 0.6s ease;
  }

  .showcase-visual-wrapper:hover .showcase-img {
    transform: scale(1.05);
  }

  .showcase-fade-mask {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0) 65%, rgba(15, 23, 42, 0.2) 100%);
    pointer-events: none;
  }

  /* Floating Chips Positions */
  .chip-expert {
    position: absolute;
    top: 24px;
    left: -24px;
    z-index: 10;
  }

  .chip-time {
    position: absolute;
    top: 48px;
    right: -16px;
    z-index: 10;
  }

  .chip-legal {
    position: absolute;
    bottom: 40px;
    left: -20px;
    z-index: 10;
  }

  /* Floating Property Preview Card */
  .floating-preview-card {
    position: absolute;
    bottom: -16px;
    right: -16px;
    z-index: 12;
    background: #FFFFFF;
    border: 1px solid rgba(226, 232, 240, 0.95);
    border-radius: 18px;
    box-shadow: 0 20px 40px -8px rgba(15, 23, 42, 0.16);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 260px;
    text-decoration: none;
    transition: var(--transition);
  }

  .floating-preview-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 25px 50px -6px rgba(15, 23, 42, 0.22);
    border-color: #CBD5E1;
  }

  .preview-card-img-wrap {
    position: relative;
    width: 100%;
    height: 125px;
    border-radius: 12px;
    overflow: hidden;
  }

  .preview-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-arrow-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0F172A;
    font-size: 0.75rem;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }

  .preview-card-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 2px 4px 4px;
  }

  .preview-card-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: #0F172A;
    line-height: 1.3;
  }

  .preview-card-sub {
    font-size: 0.75rem;
    color: #64748B;
    line-height: 1.4;
  }

  .hero-location-blur {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.74rem;
    color: #64748B;
  }

  .blurred-address-hero {
    filter: blur(4px);
    user-select: none;
    -webkit-user-select: none;
    opacity: 0.85;
    transition: filter 0.3s ease;
  }

  .floating-preview-card:hover .blurred-address-hero {
    filter: blur(2px);
  }

  .confidential-badge-mini {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 1px 5px;
    border-radius: 9999px;
    background: rgba(184, 138, 59, 0.12);
    color: #B88A3B;
    border: 1px solid rgba(184, 138, 59, 0.25);
  }

  /* Trust Highlights Strip */
  .hero-trust-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 22px 32px;
    align-items: center;
    gap: 20px;
    margin-top: 10px;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
  }

  .trust-stat-item {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .trust-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .trust-stat-text {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }

  .trust-stat-text strong {
    color: #0F172A;
    font-size: 0.94rem;
    font-weight: 700;
  }

  .trust-stat-text span {
    color: #64748B;
    font-size: 0.8rem;
  }

  .trust-divider {
    width: 1px;
    height: 40px;
    background: #E2E8F0;
    margin: 0 auto;
    display: none;
  }

  /* Smart Property Finder */
  .search-finder-card {
    padding: 32px 36px;
    border: 1px solid var(--border-card);
    background: #FFFFFF;
    box-shadow: var(--shadow-card);
  }

  .finder-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .finder-header-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .finder-title {
    font-size: 1.45rem;
    font-weight: 700;
    color: #0F172A;
  }

  .finder-sub {
    font-size: 0.9rem;
    color: #64748B;
  }

  .finder-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr auto;
    gap: 18px;
    align-items: flex-end;
  }

  .finder-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .finder-field label {
    font-size: 0.82rem;
    font-weight: 700;
    color: #334155;
    display: flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .finder-select {
    width: 100%;
    background: #F8FAFC;
    border: 1px solid #CBD5E1;
    color: #0F172A;
    padding: 13px 16px;
    border-radius: var(--radius-control);
    font-size: 0.92rem;
    font-weight: 500;
    font-family: inherit;
    transition: var(--transition);
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%230F172A' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 14px center;
    background-size: 14px;
  }

  .finder-select:focus {
    outline: none;
    border-color: #0F172A;
    background-color: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.08);
  }

  .finder-actions {
    display: flex;
    gap: 10px;
  }

  .finder-btn {
    height: 50px;
    padding: 0 24px;
    white-space: nowrap;
    border-radius: var(--radius-control);
  }

  .finder-reset-btn {
    height: 50px;
    padding: 0 18px;
    font-size: 0.88rem;
    border-radius: var(--radius-control);
  }

  /* Responsive Breakpoints */
  @media (max-width: 1100px) {
    .hero-split-grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }
    .hero-editorial-col {
      max-width: 100%;
      text-align: center;
      align-items: center;
    }
    .hero-subtitle {
      max-width: 600px;
    }
    .hero-cta-row {
      justify-content: center;
    }
    .hero-reviews-proof {
      justify-content: center;
    }
    .showcase-visual-wrapper {
      max-width: 520px;
      height: 480px;
    }
    .finder-grid {
      grid-template-columns: 1fr 1fr;
    }
    .finder-actions {
      grid-column: span 2;
    }
    .hero-trust-strip {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 30px 0 50px;
    }
    .showcase-visual-wrapper {
      max-width: 100%;
      height: 420px;
    }
    .chip-expert {
      left: 10px;
      top: 16px;
    }
    .chip-time {
      right: 10px;
      top: 40px;
    }
    .chip-legal {
      left: 10px;
      bottom: 20px;
    }
    .floating-preview-card {
      right: 10px;
      bottom: 10px;
      max-width: 220px;
    }
    .preview-card-img-wrap {
      height: 100px;
    }
    .finder-grid {
      grid-template-columns: 1fr;
    }
    .finder-actions {
      grid-column: span 1;
    }
    .hero-trust-strip {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      padding: 18px 20px;
    }
  }

  @media (max-width: 640px) {
    .hero-main-title {
      font-size: 2.1rem;
    }
    .hero-cta-row {
      flex-direction: column;
      width: 100%;
    }
    .hero-cta-row a {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
    .hero-trust-strip {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .search-finder-card {
      padding: 22px 18px;
    }
    .finder-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .finder-btn, .finder-reset-btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .showcase-visual-wrapper {
      height: 360px;
    }
    .floating-chip {
      padding: 6px 12px;
      font-size: 0.78rem;
      gap: 6px;
    }
    .chip-icon {
      width: 22px;
      height: 22px;
      font-size: 0.72rem;
    }
    .floating-preview-card {
      max-width: 190px;
      padding: 8px;
    }
    .preview-card-title {
