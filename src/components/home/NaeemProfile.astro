---
import { business } from '@/data/business';
---

<section id="consultant" class="consultant-section">
  <div class="container">
    <div class="consultant-card glass-panel">
      <!-- Left Photo Frame with Real Photo -->
      <div class="consultant-media">
        <div class="photo-frame">
          <img
            src="/assets/images/ceo-naseem-siddhu.jpg"
            alt="Naeem Siddhu - Real Estate Consultant in Chichawatni"
            loading="lazy"
            class="consultant-img"
          />
          <div class="photo-crest-badge">
            <i class="fa-solid fa-shield-halved highlight-gold"></i>
          </div>
        </div>
        <div class="consultant-badge-bar">
          <strong>{business.advisor}</strong>
          <span>{business.role}</span>
        </div>
      </div>

      <!-- Right Editorial Bio & Direct Contact -->
      <div class="consultant-bio-content">
        <span class="section-badge">
          <i class="fa-solid fa-user-check highlight-gold"></i>
          <span>PERSONAL PROPERTY COUNSEL</span>
        </span>

        <h2>
          Meet <span class="highlight-gold">{business.advisor}</span>
        </h2>

        <p class="lead-quote">
          "Buying or selling a house is one of the most important financial decisions a family will ever make. It is not just about square feet—it is about clear land titles, sound masonry, street access, and peace of mind."
        </p>

        <p class="body-text">
          As a dedicated local advisor based in Hayat Abad, Chichawatni, Naeem Siddhu personally investigates every listed property. Whether inspecting damp-proof courses in newly built houses, verifying computerized Fard Malkiat at the Arazi Record Center, or coordinating direct meetings between buyers and sellers, Naeem guarantees absolute transparency with zero artificial commission layering.
        </p>

        <div class="consultant-features-grid">
          <div class="feat-box bento-badge">
            <div class="bento-icon-wrap emerald">
              <i class="fa-solid fa-crown"></i>
            </div>
            <div class="bento-text">
              <strong>#1 Property Advisor in Chichawatni</strong>
              <span>Top 1 trusted real estate consultant with 15+ yrs on-ground authority</span>
            </div>
          </div>
          <div class="feat-box bento-badge">
            <div class="bento-icon-wrap emerald">
              <i class="fa-solid fa-file-shield"></i>
            </div>
            <div class="bento-text">
              <strong>100% PLRA Title Verification</strong>
              <span>Computerized Fard Malkiat & Arazi Record Center registry check</span>
            </div>
          </div>
          <div class="feat-box bento-badge">
            <div class="bento-icon-wrap gold">
              <i class="fa-solid fa-map-location-dot"></i>
            </div>
            <div class="bento-text">
              <strong>Best Town & Location Deals</strong>
              <span>Hayat Abad, Model Town, Housing Colony & GT Road corridors</span>
            </div>
          </div>
          <div class="feat-box bento-badge">
            <div class="bento-icon-wrap emerald">
              <i class="fa-solid fa-handshake-simple"></i>
            </div>
            <div class="bento-text">
              <strong>Direct Buy & Fast Sale Guarantee</strong>
              <span>Face-to-face seller meetings with 0% fake markups & transparent rates</span>
            </div>
          </div>
        </div>

        <div class="consultant-actions">
          <a href={`tel:${business.phone}`} class="btn-primary">
            <i class="fa-solid fa-phone"></i>
            <span>Call Naeem: {business.phoneFormatted}</span>
          </a>
          <a href={business.whatsappUrl} target="_blank" rel="noopener" class="btn-whatsapp">
            <i class="fa-brands fa-whatsapp"></i>
            <span>WhatsApp Now</span>
          </a>
          <a href={business.facebookUrl} target="_blank" rel="noopener" class="btn-outline" aria-label="Official Facebook">
            <i class="fa-brands fa-facebook-f"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .consultant-section {
    padding: 90px 0;
    background: var(--bg-main);
    border-bottom: 1px solid var(--border-subtle);
  }

  .consultant-card {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 50px;
    padding: 48px;
    border: 1px solid var(--border-card);
    align-items: center;
    background: #FFFFFF;
    border-radius: var(--radius-card);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  .consultant-media {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .photo-frame {
    position: relative;
    width: 280px;
    height: 340px;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 2px solid var(--color-gold);
    box-shadow: var(--shadow-elevated), var(--gold-glow);
  }

  .consultant-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .photo-crest-badge {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(13, 27, 21, 0.92);
    border: 1.5px solid var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
  }

  .consultant-badge-bar {
    text-align: center;
    display: flex;
    flex-direction: column;
  }

  .consultant-badge-bar strong {
    font-size: 1.25rem;
    color: var(--text-primary);
  }

  .consultant-badge-bar span {
    font-size: 0.85rem;
    color: var(--color-gold-hover);
    font-weight: 600;
  }

  /* Bio Content */
  .consultant-bio-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .lead-quote {
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--color-dark-green);
    font-style: italic;
    border-left: 3px solid var(--color-gold);
    padding-left: 16px;
    margin: 6px 0;
    font-weight: 500;
  }

  .body-text {
    font-size: 0.96rem;
    line-height: 1.68;
    color: var(--text-secondary);
  }

  /* Crisp SaaS Bento Badges (High Contrast Bug Fix) */
  .consultant-features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin: 12px 0;
  }

  .feat-box.bento-badge {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    padding: 16px 18px;
    border-radius: 14px;
    transition: all 0.25s ease;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .feat-box.bento-badge:hover {
    background: #F0FDF4;
    border-color: #86EFAC;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.06);
  }

  .bento-icon-wrap {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .bento-icon-wrap.emerald {
    background: rgba(27, 67, 50, 0.1);
    color: #1B4332;
    border: 1px solid rgba(27, 67, 50, 0.2);
  }

  .bento-icon-wrap.gold {
    background: rgba(200, 169, 107, 0.15);
    color: #9A7B38;
    border: 1px solid rgba(200, 169, 107, 0.3);
  }

  .bento-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .bento-text strong {
    font-size: 0.92rem;
    color: #0F172A !important; /* High-contrast crisp dark typography */
    font-weight: 700;
    line-height: 1.3;
  }

  .bento-text span {
    font-size: 0.8rem;
    color: #475569 !important; /* Crisp readable slate */
    line-height: 1.45;
  }

  .consultant-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 10px;
  }

  @media (max-width: 992px) {
    .consultant-card {
      grid-template-columns: 1fr;
      padding: 32px 24px;
      gap: 32px;
    }

    .consultant-features-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .consultant-section {
      padding: 60px 0;
    }
    .consultant-card {
      padding: 24px 16px;
      gap: 24px;
    }
    .photo-frame {
      width: 220px;
      height: 270px;
    }
    .consultant-actions {
      flex-direction: column;
      width: 100%;
    }
    .consultant-actions a {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }
</style>
