---
import { reviews } from '@/data/reviews';
import { business } from '@/data/business';

// Only keep the 3 verified Google Business Profile reviews (Muhammad Tariq, Sheikh Sarfraz, Ali Raza Chaudhry)
const verifiedGoogleReviews = reviews.filter(r => 
  r.id === 'rev-tariq' || r.id === 'rev-sarfraz' || r.id === 'rev-ali-raza'
);
---

<section id="reviews" class="reviews-section">
  <div class="container">
    <!-- Google Business Profile Verified Snapshot Card -->
    <div class="gbp-verified-badge-card glass-panel">
      <div class="gbp-label">
        <i class="fa-brands fa-google"></i>
        <span>GOOGLE BUSINESS PROFILE • 100% VERIFIED</span>
      </div>
      <h3 class="gbp-name">{business.name}</h3>
      <div class="gbp-rating-row">
        <div class="gbp-stars">
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
        </div>
        <strong class="gbp-score">5.0</strong>
        <span class="gbp-count">Based on Verified Google Reviews</span>
      </div>
      <p class="gbp-address">
        {business.address.street}, {business.address.locality}, {business.address.city} 57200, Punjab, Pakistan
      </p>
      <div class="gbp-action">
        <a href={business.googleBusinessProfileUrl} target="_blank" rel="noopener noreferrer" class="btn-primary" style="padding: 10px 24px; font-size: 0.88rem;">
          <i class="fa-brands fa-google"></i> View on Google Maps
        </a>
      </div>
    </div>

    <!-- Section Header Split -->
    <div class="section-header-split">
      <div class="header-left">
        <span class="section-badge">
          <i class="fa-solid fa-quote-left highlight-gold"></i>
          <span>VERIFIED CLIENT FEEDBACK</span>
        </span>
        <h2>
          Trusted by Buyers & Sellers in <span class="editorial-italic highlight-gold">Chichawatni</span>
        </h2>
        <p>
          Real Google client reviews from property buyers, overseas families, and sellers guided by Naeem Siddhu.
        </p>
      </div>
      <div class="header-right">
        <a href={business.googleBusinessProfileUrl} target="_blank" rel="noopener noreferrer" class="btn-outline view-all-reviews-btn">
          <i class="fa-brands fa-google"></i>
          <span>Verified Google Reviews</span>
          <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 0.75rem;"></i>
        </a>
      </div>
    </div>

    <!-- 3 Verified Google Reviews Grid -->
    <div class="verified-reviews-grid">
      {verifiedGoogleReviews.map((rev) => (
        <div class="review-card v4-card">
          <div class="rev-header">
            <div class="rev-stars">
              {Array.from({ length: rev.rating }).map(() => (
                <i class="fa-solid fa-star highlight-gold"></i>
              ))}
            </div>
            <span class="rev-source-pill">
              <i class="fa-brands fa-google"></i>
              <span>Google Verified</span>
            </span>
          </div>

          <p class="rev-quote">"{rev.text}"</p>

          <div class="rev-author-row">
            <div class="rev-avatar" style={`background: ${rev.avatarBg};`}>
              {rev.avatarInitial}
            </div>
            <div class="rev-meta">
              <strong class="rev-name">{rev.author}</strong>
              <span class="rev-location">
                <i class="fa-solid fa-location-dot highlight-gold"></i> {rev.location}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- ========================================================================= -->
    <!-- 2026 CHICHAWATNI PROPERTY PER-MARLA RATE INDEX (80 LAKH TO 1.8 CRORE) -->
    <!-- ========================================================================= -->
    <div id="rate-index" class="rate-index-container">
      <div class="rate-index-header">
        <div class="rate-badge-row">
          <span class="rate-tag-pill">
            <span class="rate-pulse-dot"></span>
            <i class="fa-solid fa-chart-line"></i> OFFICIAL 2026 VALUATION BENCHMARK
          </span>
          <span class="rate-audit-pill">
            <i class="fa-solid fa-shield-check"></i> 100% PLRA & Arazi Record Center Aligned
          </span>
        </div>
        <h3 class="rate-index-title">
          2026 Chichawatni Property <span class="editorial-italic highlight-gold">Per-Marla Rate Index</span>
