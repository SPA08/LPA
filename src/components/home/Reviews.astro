<script is:inline>
  window.switchRateIndexTab = function(panelId, btn) {
    // 1. Update button states
    document.querySelectorAll('.rate-index-tabs .rate-tab-btn').forEach(b => {
      b.classList.remove('active');
      b.setAttribute('aria-selected', 'false');
    });
    if (btn) {
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
    }

    // 2. Hide all panels and show selected
    document.querySelectorAll('.rate-table-wrapper .rate-panel').forEach(p => {
      p.style.display = 'none';
      p.classList.remove('active');
    });

    const targetPanel = document.getElementById(`panel-${panelId}`);
    if (targetPanel) {
      targetPanel.style.display = 'block';
      targetPanel.classList.add('active');
    }
  };
</script>
