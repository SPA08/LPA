---
import { reviews } from '@/data/reviews';
import { business } from '@/data/business';
---

<section id="reviews" class="reviews-section">
  <div class="container">
    <!-- Google Business Profile Verified Snapshot -->
    <div class="gbp-verified-badge-card glass-panel">
      <div class="gbp-label">
        <i class="fa-brands fa-google"></i>
        <span>GOOGLE BUSINESS PROFILE</span>
      </div>
      <h3 class="gbp-name">{business.name}</h3>
      <div class="gbp-rating-row">
        <div class="gbp-stars">
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
        </div>
        <strong class="gbp-score">5.0</strong>
        <span class="gbp-count">Based on 5 Google reviews</span>
      </div>
      <p class="gbp-address">
        {business.address.street}, {business.address.locality}, {business.address.city} 57200, Pakistan
      </p>
      <div class="gbp-action">
        <a href={business.googleBusinessProfileUrl} target="_blank" rel="noopener" class="btn-primary" style="padding: 9px 22px; font-size: 0.88rem;">
          <i class="fa-brands fa-google"></i> View on Google Maps
        </a>
      </div>
    </div>

    <!-- Section Header Split -->
    <div class="section-header-split" style="margin-top: 60px;">
      <div class="header-left">
        <span class="section-badge">
          <i class="fa-solid fa-quote-left highlight-gold"></i>
          <span>CLIENT FEEDBACK</span>
        </span>
        <h2>
          What Clients Say About <span class="editorial-italic highlight-gold">Naeem Siddhu</span>
        </h2>
        <p>
          Genuine feedback from home buyers and property owners across Tehsil Chichawatni.
        </p>
      </div>
      <div class="header-right">
        <a href={business.googleBusinessProfileUrl} target="_blank" rel="noopener" class="btn-outline view-all-reviews-btn">
          <i class="fa-brands fa-google"></i>
          <span>All 5 Verified Reviews</span>
          <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 0.75rem;"></i>
        </a>
      </div>
    </div>

    <!-- Reviews Carousel (Strict Single Horizontal Row: Max 4 Cards on Desktop) -->
    <div class="reviews-carousel-wrapper">
      <button
        type="button"
        class="rev-carousel-nav prev"
        id="revPrevBtn"
        onclick="window.slideReviews(-1);"
        aria-label="Previous review"
      >
        <i class="fa-solid fa-chevron-left"></i>
      </button>

      <div class="reviews-carousel-track" id="reviewsTrack">
        {reviews.map((rev, rIdx) => (
          <div class="rev-carousel-slide" data-index={rIdx}>
            <div class="review-card v4-card">
              <div class="rev-header">
                <div class="rev-stars">
                  {Array.from({ length: rev.rating }).map(() => (
                    <i class="fa-solid fa-star highlight-gold"></i>
                  ))}
                </div>
                <span class="rev-source-pill">
                  <i class={rev.source === 'Google Business Profile' ? 'fa-brands fa-google' : 'fa-solid fa-user-check'}></i>
                  {rev.source}
                </span>
              </div>

              <p class="rev-quote">"{rev.text}"</p>

              <div class="rev-author-row">
                <div class="rev-avatar" style={`background: ${rev.avatarBg};`}>
                  {rev.avatarInitial}
                </div>
                <div class="rev-meta">
                  <strong class="rev-name">{rev.author}</strong>
                  <span class="rev-location">{rev.location}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <button
        type="button"
        class="rev-carousel-nav next"
        id="revNextBtn"
        onclick="window.slideReviews(1);"
        aria-label="Next review"
      >
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>

    <!-- Carousel Footer Controls -->
    <div class="reviews-meta-bar">
      <div class="rev-dots-row" id="revDotsRow">
        {reviews.map((_, idx) => (
          <button
            type="button"
            class:list={['rev-dot', { active: idx === 0 }]}
            onclick={`window.goToReviewSlide(${idx});`}
            aria-label={`Go to review ${idx + 1}`}
          ></button>
        ))}
      </div>
      <div class="rev-hint-text">
        <i class="fa-solid fa-arrows-left-right highlight-gold"></i>
        <span>Showing 4 of {reviews.length} • Swipe to view all reviews</span>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-section {
    padding: 85px 0 90px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .gbp-verified-badge-card {
    max-width: 620px;
    margin: 0 auto;
    padding: 34px 28px;
    text-align: center;
    border: 1px solid var(--border-card);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .gbp-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .gbp-name {
    font-size: 1.55rem;
    color: var(--text-primary);
  }

  .gbp-rating-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .gbp-stars {
    color: var(--accent-gold);
    font-size: 1.15rem;
    display: flex;
    gap: 2px;
  }

  .gbp-score {
    font-size: 1.25rem;
    color: var(--text-primary);
  }

  .gbp-count {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .gbp-address {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .gbp-action {
    margin-top: 6px;
  }

  /* Section Header Split */
  .section-header-split {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }

  .header-left {
    max-width: 650px;
  }

  .header-left h2 {
    margin-bottom: 12px;
  }

  .header-left p {
    color: var(--text-secondary);
    font-size: 1rem;
    margin: 0;
  }

  .view-all-reviews-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 20px;
    border-radius: var(--radius-full);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-dark-green);
    background: #FFFFFF;
  }

  .view-all-reviews-btn:hover {
    background: var(--color-dark-green);
    color: #FFFFFF;
    border-color: var(--color-dark-green);
  }

  /* Reviews Carousel */
  .reviews-carousel-wrapper {
    position: relative;
    width: 100%;
  }

  .rev-carousel-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    color: var(--color-dark-green);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    cursor: pointer;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
    z-index: 10;
    transition: all 0.25s ease;
  }

  .rev-carousel-nav:hover {
    background: var(--color-dark-green);
    color: #FFFFFF;
    border-color: var(--color-dark-green);
    transform: translateY(-50%) scale(1.06);
  }

  .rev-carousel-nav.prev { left: -20px; }
  .rev-carousel-nav.next { right: -20px; }

  .reviews-carousel-track {
    display: flex;
    gap: 22px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding: 8px 4px 16px;
    scrollbar-width: none;
  }

  .reviews-carousel-track::-webkit-scrollbar {
    display: none;
  }

  /* Desktop (>= 1200px): Exactly 4 cards visible per row in 1 single row */
  .rev-carousel-slide {
    flex: 0 0 calc(25% - 17px);
    max-width: calc(25% - 17px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
  }

  /* Tablet (768px - 1199px): Exactly 2 visible cards */
  @media (max-width: 1199px) {
    .rev-carousel-slide {
      flex: 0 0 calc(50% - 11px);
      max-width: calc(50% - 11px);
    }
    .rev-carousel-nav.prev { left: -10px; }
    .rev-carousel-nav.next { right: -10px; }
  }

  /* Mobile (< 768px): Exactly 1 visible card with smooth swipe */
  @media (max-width: 767px) {
    .rev-carousel-slide {
      flex: 0 0 100%;
      max-width: 100%;
    }
    .rev-carousel-nav {
      display: none;
    }
    .section-header-split {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: 24px;
    }
    .view-all-reviews-btn {
      width: 100%;
      justify-content: center;
    }
  }

  .review-card {
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
    background: #FFFFFF;
    border: 1px solid var(--border-card);
    border-radius: var(--radius-card);
  }

  .rev-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .rev-stars {
    font-size: 0.9rem;
    display: flex;
    gap: 2px;
  }

  .rev-source-pill {
    font-size: 0.7rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 5px;
    background: #F4F6F5;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  .rev-quote {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary);
    font-style: italic;
    flex-grow: 1;
    margin: 0;
  }

  .rev-author-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid var(--border-subtle);
  }

  .rev-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rev-meta {
    display: flex;
    flex-direction: column;
    font-size: 0.82rem;
  }

  .rev-name {
    color: var(--text-primary);
  }

  .rev-location {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Meta Bar: Dots + Hint */
  .reviews-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
    padding: 0 4px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .rev-dots-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rev-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #D1D8D4;
    border: none;
    cursor: pointer;
    transition: all 0.25s ease;
    padding: 0;
  }

  .rev-dot.active {
    background: var(--color-matte-green);
    width: 24px;
    border-radius: var(--radius-full);
  }

  .rev-hint-text {
    font-size: 0.82rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 640px) {
    .reviews-section {
      padding: 60px 0;
    }
    .gbp-verified-badge-card {
      padding: 24px 18px;
    }
    .gbp-name {
      font-size: 1.35rem;
    }
  }
</style>

<script is:inline>
  window.slideReviews = function(direction) {
    const track = document.getElementById('reviewsTrack');
    if (!track) return;
    const slides = track.querySelectorAll('.rev-carousel-slide');
    if (!slides.length) return;
    const slideWidth = slides[0].offsetWidth + 22;
    track.scrollBy({
      left: direction * slideWidth,
      behavior: 'smooth'
    });
  };

  window.goToReviewSlide = function(index) {
    const track = document.getElementById('reviewsTrack');
    if (!track) return;
    const slides = track.querySelectorAll('.rev-carousel-slide');
    if (slides[index]) {
      slides[index].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
    }
  };

  const revTrack = document.getElementById('reviewsTrack');
  if (revTrack) {
    revTrack.addEventListener('scroll', () => {
      const slides = revTrack.querySelectorAll('.rev-carousel-slide');
      if (!slides.length) return;
      const slideWidth = slides[0].offsetWidth + 22;
      const activeIdx = Math.round(revTrack.scrollLeft / slideWidth);
      const dots = document.querySelectorAll('#revDotsRow .rev-dot');
      dots.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === activeIdx);
      });
    }, { passive: true });
  }
</script>
