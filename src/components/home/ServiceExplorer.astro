---
import { services } from '@/data/services';

// Show only first 6 services
const displayServices = services.slice(0, 6);
---

<section id="services" class="services-section">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">
        <i class="fa-solid fa-compass highlight-gold"></i>
        <span>PROFESSIONAL FACILITATION</span>
      </span>
      <h2>
        Advisory & <span class="editorial-italic highlight-gold">Client Services</span>
      </h2>
      <p>
        From your very first market query to the final computerized registry and key handover, Naeem Siddhu personally guides every step.
      </p>
    </div>

    <div class="services-grid">
      {displayServices.map(svc => (
        <a href={`/services/${svc.slug}.html`} class="service-card v4-card">
          <div class="svc-icon-box">
            <i class={svc.icon}></i>
          </div>
          <span class="svc-badge">{svc.badge}</span>
          <h3 class="svc-title">{svc.title}</h3>
          <div class="svc-footer">
            <span class="svc-link">
              <span>Read Guide</span>
              <i class="fa-solid fa-arrow-right"></i>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: 90px 0;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .service-card {
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: relative;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    cursor: pointer;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .service-card:hover .svc-link {
    color: #FFFFFF;
  }

  .service-card:hover .svc-link i {
    transform: translateX(4px);
  }

  .svc-icon-box {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-control);
    background: rgba(184, 138, 59, 0.12);
    border: 1px solid rgba(184, 138, 59, 0.3);
    color: var(--accent-gold-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
  }

  .svc-badge {
    font-size: 0.68rem;
    color: var(--accent-teal-light);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .svc-title {
    font-size: 1.05rem;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .svc-footer {
    padding-top: 10px;
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
  }

  .svc-link {
    font-size: 0.8rem;
    color: var(--accent-gold-light);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .svc-link i {
    transition: transform 0.2s ease;
  }

  @media (max-width: 1199px) and (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 767px) {
    .services-section {
      padding: 60px 0;
    }
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .service-card {
      padding: 18px 16px;
    }
    .svc-title {
      font-size: 0.95rem;
    }
  }
</style>
