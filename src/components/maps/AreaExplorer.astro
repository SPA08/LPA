---
import { localities } from '@/data/locations';
import { cityPlaces } from '@/data/cityIntelligence';
import { business } from '@/data/business';

// Deduplicate and assemble curated base locations with all towns, private schemes & rural chaks
const seenMapIds = new Set<string>();
const curatedLocations = [
  ...localities.map(loc => {
    let group = 'Residential';
    if (loc.category === 'Village & Chak') group = 'Village';
    else if (loc.category === 'Private Housing Scheme') group = 'Private';
    else if (loc.category === 'Government & Revenue Office') group = 'Government';
    else if (loc.category === 'Emergency & Healthcare') group = 'Health';
    else if (loc.category === 'Education & Landmark') group = 'Education';
    else if (loc.category === 'Commercial & Bazaar') group = 'Banking';
    else if (loc.category === 'Road & Highway') group = 'Government';

    return {
      id: loc.id,
      name: loc.name,
      category: loc.category,
      group: group,
      lat: loc.lat,
      lng: loc.lng,
      address: loc.parentChak || 'Tehsil Chichawatni',
      badge: loc.statusBadge || 'Verified Locality',
      desc: loc.description,
      legal: loc.legalStatus,
      highlights: loc.highlights || ['Verified Road Access', 'Electricity & Water Available', 'Arazi Record Registry Verified'],
      isVerified: true,
      source: 'Curated Verified'
    };
  }),
  ...cityPlaces.map(p => ({
    id: p.id,
    name: p.name,
    category: p.category,
    group: p.category,
    lat: p.lat,
    lng: p.lng,
    address: `${p.locality} • ${p.roadAddress}`,
    badge: p.subCategory || p.category,
    desc: p.usefulness,
    legal: p.roadAddress,
    highlights: p.highlights || ['Major Civic Amenity', 'Prime Road Access', 'Tehsil Focal Point'],
    isVerified: true,
    source: 'Curated Verified'
  }))
].filter(loc => {
  if (seenMapIds.has(loc.id)) return false;
  seenMapIds.add(loc.id);
  return true;
});
---

<section id="areas" class="map-section">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">
        <i class="fa-solid fa-map-location-dot highlight-gold"></i>
        <span>GEOGRAPHIC INTELLIGENCE & CIVIC GIS</span>
      </span>
      <h2>
        Chichawatni <span class="editorial-italic highlight-gold">Interactive Property & Civic Map</span>
      </h2>
      <p>
        Cadastral-grade GPS intelligence across Chichawatni’s TMA colonies, private estates, and rural Chaks
      </p>
    </div>

    <!-- Mobile View Mode Segmented Switcher (Visible only < 992px) -->
    <div class="mobile-map-segmented-tabs" id="mobileMapTabs">
      <button type="button" class="mobile-tab-btn active" id="btnTabMap" onclick="window.switchMobileMapView('map');">
        <i class="fa-solid fa-map"></i>
        <span>Map View</span>
      </button>
      <button type="button" class="mobile-tab-btn" id="btnTabList" onclick="window.switchMobileMapView('list');">
        <i class="fa-solid fa-list-ul"></i>
        <span>Locations (<strong id="mobileListCountLabel">{curatedLocations.length}</strong>)</span>
      </button>
    </div>

    <!-- Map Layout Grid Container -->
    <div class="map-layout-grid" id="mapLayoutGrid">
      
      <!-- LEFT SIDEBAR: Search, Category Chips, Location Cards & Detail View -->
      <aside class="map-panel-sidebar" id="mapPanelSidebar">
        
        <!-- Search & Filter Controls -->
        <div class="sidebar-top" id="sidebarControls">
          
          <!-- Clean Modern SaaS Search Bar (No Buggy Text/Key Artifacts) -->
          <div class="map-search-box">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input
              type="text"
              id="mapLocalitySearch"
              placeholder="Search town, chak, school, or hospital..."
              class="map-search-input"
              autocomplete="off"
              spellcheck="false"
              oninput="window.handleMapSearchInput(this.value);"
            />
            <button
              type="button"
              id="mapSearchClearBtn"
              class="search-clear-btn"
              onclick="window.clearMapSearch();"
              title="Clear search"
              aria-label="Clear search"
              style="display: none;"
            >
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>

          <!-- Horizontal Category Filter Chips with Non-Overlapping Nav Chevrons -->
          <div class="category-chips-wrapper">
            <button
              type="button"
              class="chip-nav-chevron left"
              onclick="window.scrollCategoryChips(-180);"
              title="Scroll left"
              aria-label="Scroll left"
            >
              <i class="fa-solid fa-chevron-left"></i>
            </button>

            <div class="category-chips-row" id="categoryChipsRow">
              <button type="button" class="chip-btn active" data-category="all" onclick="window.setMapCategory('all', this);">
                <i class="fa-solid fa-border-all"></i>
                <span>All Locations</span>
                <span class="chip-count" id="countAll">{curatedLocations.length}</span>
              </button>
              <button type="button" class="chip-btn" data-category="Residential" onclick="window.setMapCategory('Residential', this);">
                <i class="fa-solid fa-house-chimney icon-res"></i>
                <span>Towns & Colonies</span>
                <span class="chip-count" id="countResidential">17</span>
              </button>
              <button type="button" class="chip-btn" data-category="Private" onclick="window.setMapCategory('Private', this);">
                <i class="fa-solid fa-city icon-priv"></i>
                <span>Private Schemes</span>
                <span class="chip-count" id="countPrivate">9</span>
              </button>
              <button type="button" class="chip-btn" data-category="Village" onclick="window.setMapCategory('Village', this);">
                <i class="fa-solid fa-wheat-awn icon-village"></i>
                <span>Villages & Chaks (دیہات)</span>
                <span class="chip-count" id="countVillage">29</span>
              </button>
              <button type="button" class="chip-btn" data-category="Education" onclick="window.setMapCategory('Education', this);">
                <i class="fa-solid fa-graduation-cap icon-edu"></i>
                <span>Schools & Colleges</span>
                <span class="chip-count" id="countEducation">5</span>
              </button>
              <button type="button" class="chip-btn" data-category="Health" onclick="window.setMapCategory('Health', this);">
                <i class="fa-solid fa-heart-pulse icon-health"></i>
                <span>Hospitals</span>
                <span class="chip-count" id="countHealth">5</span>
              </button>
              <button type="button" class="chip-btn" data-category="Government" onclick="window.setMapCategory('Government', this);">
                <i class="fa-solid fa-landmark-dome icon-govt"></i>
                <span>Govt & PLRA</span>
                <span class="chip-count" id="countGovernment">7</span>
              </button>
              <button type="button" class="chip-btn" data-category="Banking" onclick="window.setMapCategory('Banking', this);">
                <i class="fa-solid fa-building-columns icon-bank"></i>
                <span>Banks & Bazaars</span>
                <span class="chip-count" id="countBanking">5</span>
              </button>
              <button type="button" class="chip-btn" data-category="Safety" onclick="window.setMapCategory('Safety', this);">
                <i class="fa-solid fa-shield-halved icon-safety"></i>
                <span>Police & Rescue</span>
                <span class="chip-count" id="countSafety">3</span>
              </button>
            </div>

            <button
              type="button"
              class="chip-nav-chevron right"
              onclick="window.scrollCategoryChips(180);"
              title="Scroll right"
              aria-label="Scroll right"
            >
              <i class="fa-solid fa-chevron-right"></i>
            </button>
          </div>

          <!-- Real-Time Sync Status Header Bar -->
          <div class="sidebar-status-bar">
            <div class="sync-indicator">
              <span class="pulse-dot"></span>
              <span class="sync-label">Chichawatni GIS: <strong id="mapLoadedBadge">{curatedLocations.length}</strong> Verified Locations</span>
            </div>
            <button
              type="button"
              class="sync-refresh-btn"
              onclick="window.refreshOverpassApi(true);"
              title="Refresh live data via OpenStreetMap Overpass API"
            >
              <i class="fa-solid fa-arrows-rotate" id="refreshSpinIcon"></i>
              <span>Live Sync</span>
            </button>
          </div>
        </div>

        <!-- Skeleton Loading Placeholders -->
        <div class="locality-skeleton-wrap" id="localitySkeletonWrap" style="display: none;">
          {Array(4).fill(0).map(() => (
            <div class="skeleton-card shimmer">
              <div class="skeleton-line-title"></div>
              <div class="skeleton-line-sub"></div>
              <div class="skeleton-line-desc"></div>
            </div>
          ))}
        </div>

        <!-- Scrollable Locations Card Feed -->
        <div class="locality-scroll-list" id="localityListContainer">
          <!-- Populated dynamically via JavaScript with high-contrast SaaS cards -->
        </div>

        <!-- Detail Inspection Drawer / View (Embedded inside sidebar) -->
        <div class="locality-detail-drawer" id="localityDetailView" style="display: none;">
          <div class="detail-header">
            <button type="button" class="detail-back-btn" onclick="window.closeLocalityDetail();" title="Back to location list">
              <i class="fa-solid fa-arrow-left"></i>
              <span>All Locations</span>
            </button>
            <div class="detail-badge-group">
              <span class="detail-category-tag" id="detailCategoryTag">Residential</span>
              <span class="detail-distance-badge" id="detailDistanceBadge">0.8 km</span>
            </div>
          </div>

          <div class="detail-content-scroll">
            <h3 class="detail-name" id="detailTitle">Locality Title</h3>
            
            <div class="detail-meta-row">
              <p class="detail-address">
                <i class="fa-solid fa-location-dot highlight-gold"></i>
                <span id="detailAddressText">Tower Road, Hayat Abad, Chichawatni</span>
              </p>
            </div>

            <!-- GPS Coordinates Box with One-Click Copy -->
            <div class="detail-coords-box">
              <div class="coords-info">
                <span class="coords-label">VERIFIED GPS COORDINATES</span>
                <code class="coords-mono" id="detailCoordsMono">30.5333° N, 72.7000° E</code>
              </div>
              <button type="button" class="btn-copy-coords" onclick="window.copyDetailCoords();" title="Copy GPS Coordinates">
                <i class="fa-regular fa-copy"></i>
                <span id="copyCoordsLabel">Copy GPS</span>
              </button>
            </div>

            <!-- Description -->
            <div class="detail-block">
              <h4 class="detail-block-title">
                <i class="fa-solid fa-circle-info highlight-gold"></i>
                <span>About this Area / Village</span>
              </h4>
              <p class="detail-description" id="detailDesc">Area description and strategic property valuation overview.</p>
            </div>

            <!-- Legal / Verification Status -->
            <div class="detail-block">
              <h4 class="detail-block-title">
                <i class="fa-solid fa-scale-balanced highlight-gold"></i>
                <span>Revenue & Registry Status</span>
              </h4>
              <div class="legal-highlight-block">
                <p id="detailLegal">Tehsil Revenue Registry & Land Record Center verified.</p>
              </div>
            </div>

            <!-- Highlights Checklist -->
            <div class="detail-block">
              <h4 class="detail-block-title">
                <i class="fa-solid fa-list-check highlight-gold"></i>
                <span>Infrastructure Highlights</span>
              </h4>
              <ul class="detail-highlights-list" id="detailHighlights">
                <!-- Injected via JS -->
              </ul>
            </div>
          </div>

          <!-- Bottom Action Buttons -->
          <div class="detail-footer-actions">
            <a
              id="detailGmapsBtn"
              href="#"
              target="_blank"
              rel="noopener"
              class="btn-saas-directions"
            >
              <i class="fa-solid fa-diamond-turn-right"></i>
              <span>Get Directions on Google Maps</span>
              <i class="fa-solid fa-arrow-up-right-from-square micro-arrow"></i>
            </a>
          </div>
        </div>

      </aside>

      <!-- RIGHT MAP VIEWPORT: Interactive Map & Custom Floating Controls -->
      <div class="map-viewport-wrapper">
        <div id="osV4Map" class="leaflet-map-canvas"></div>

        <!-- Floating Top-Right HUD Controls -->
        <div class="map-floating-top-hud">
          <div class="map-live-sync-pill" id="liveSyncPill">
            <span class="live-dot-pulse"></span>
            <span class="sync-text">Tehsil GIS • <strong>{curatedLocations.length}</strong> Locations</span>
            <button type="button" class="api-refresh-micro-btn" onclick="window.refreshOverpassApi(true);" title="Sync Live Overpass Amenities">
              <i class="fa-solid fa-arrows-rotate"></i>
            </button>
          </div>

          <button type="button" class="map-recenter-pill-btn" onclick="window.recenterMap();" title="Recenter Map on Chichawatni">
            <i class="fa-solid fa-compass"></i>
            <span>Recenter</span>
          </button>
        </div>

        <!-- Floating Bottom-Right SaaS Controls Cluster (Zoom In/Out, GPS, Satellite Toggle) -->
        <div class="map-floating-controls-cluster">
          <div class="controls-cluster-group">
            <button type="button" class="saas-control-btn" onclick="window.mapZoomIn();" title="Zoom In" aria-label="Zoom in">
              <i class="fa-solid fa-plus"></i>
            </button>
            <div class="control-divider"></div>
            <button type="button" class="saas-control-btn" onclick="window.mapZoomOut();" title="Zoom Out" aria-label="Zoom out">
              <i class="fa-solid fa-minus"></i>
            </button>
          </div>

          <div class="controls-cluster-group">
            <button type="button" class="saas-control-btn" onclick="window.locateUserGPS();" title="Find My Location (GPS)" aria-label="Locate user">
              <i class="fa-solid fa-crosshairs"></i>
            </button>
            <div class="control-divider"></div>
            <button type="button" class="saas-control-btn" id="btnToggleTileLayer" onclick="window.toggleSatelliteLayer();" title="Toggle Satellite Imagery" aria-label="Toggle satellite view">
              <i class="fa-solid fa-layer-group"></i>
            </button>
          </div>
        </div>

        <!-- Tile Mode Indicator -->
        <div class="map-tile-mode-indicator" id="mapTileModeIndicator">
          <span class="mode-dot"></span>
          <span id="tileModeLabel">SaaS Street View</span>
        </div>

        <!-- Attribution Strip -->
        <div class="map-minimal-attribution">
          <span>&copy; OpenStreetMap | SIDDHU GIS</span>
        </div>

        <!-- Toast Feedback Notification Container -->
        <div class="map-toast-container" id="mapToastContainer"></div>
      </div>

    </div>
  </div>
</section>

<!-- Client-Side GIS Map Engine -->
<script is:inline define:vars={{ initialCuratedLocations: curatedLocations, officeCoords: business.coordinates }}>
  (function() {
    // Geospatial Constants
    const CHICHAWATNI_CENTER = { lat: 30.5333, lng: 72.7000 };
    const OVERPASS_RADIUS_METERS = 6000;
    const CACHE_STORAGE_KEY = 'siddhu_chichawatni_overpass_v3';
    const CACHE_TTL_MS = 60 * 60 * 1000; // 1 hour

    // State Variables
    let mapInstance = null;
    let streetTileLayer = null;
    let satelliteTileLayer = null;
    let isSatelliteActive = false;
    let clusterGroup = null;
    let markersLayerGroup = null;
    let markersMap = {};
    let activeMapCategory = 'all';
    let activeMarkerId = null;
    let searchDebounceTimer = null;
    let userLocationMarker = null;
    let userAccuracyCircle = null;

    // Global Dataset Store
    window.BASE_VERIFIED_LOCATIONS = initialCuratedLocations || [];
    window.ALL_MAP_LOCATIONS = [...window.BASE_VERIFIED_LOCATIONS];

    // SVG Pin Icons for SaaS Markers
    const SVG_ICONS = {
      Residential: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
      Private: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><rect width="16" height="20" x="4" y="2" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M8 10h.01"/><path d="M16 10h.01"/><path d="M8 14h.01"/><path d="M16 14h.01"/></svg>`,
      Village: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="m2 22 1-1h18l1 1"/><path d="M12 2v6"/><path d="m7 7 5-5 5 5"/><path d="M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"/><path d="M12 14v6"/></svg>`,
      Education: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
      Health: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`,
      Government: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><line x1="2" x2="22" y1="20" y2="20"/><line x1="6" x2="6" y1="11"/><line x1="10" x2="10" y1="11"/><line x1="14" x2="14" y1="11"/><line x1="18" x2="18" y1="11"/><polygon points="12 2 20 7 4 7"/></svg>`,
      Banking: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>`,
      Safety: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
      HQ: `<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`
    };

    // Calculate Geodesic Distance in Km
    function calculateDistanceKm(lat1, lon1, lat2, lon2) {
      const R = 6371;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      return R * c;
    }

    function formatDistanceStr(lat, lng) {
      const dist = calculateDistanceKm(CHICHAWATNI_CENTER.lat, CHICHAWATNI_CENTER.lng, lat, lng);
      if (dist < 1) {
        return `${Math.round(dist * 1000)}m from center`;
      }
      return `${dist.toFixed(1)} km from center`;
    }

    // Toast Notification System
    function showMapToast(message, type = 'info') {
      const container = document.getElementById('mapToastContainer');
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = `map-toast-item toast-${type}`;
      toast.innerHTML = `
        <i class="fa-solid ${type === 'success' ? 'fa-circle-check' : type === 'warning' ? 'fa-triangle-exclamation' : 'fa-circle-info'}"></i>
        <span>${message}</span>
      `;
      container.appendChild(toast);
      setTimeout(() => toast.classList.add('toast-show'), 40);
      setTimeout(() => {
        toast.classList.remove('toast-show');
        setTimeout(() => toast.remove(), 350);
      }, 3500);
    }

    // Custom SaaS Map Marker Generator
    function createSaaSPinIcon(group, isOffice = false) {
      let colorClass = 'saas-pin--residential';
      let iconSvg = SVG_ICONS.Residential;

      if (isOffice) {
        colorClass = 'saas-pin--hq';
        iconSvg = SVG_ICONS.HQ;
      } else if (group === 'Village') {
        colorClass = 'saas-pin--village';
        iconSvg = SVG_ICONS.Village;
      } else if (group === 'Private') {
        colorClass = 'saas-pin--private';
        iconSvg = SVG_ICONS.Private;
      } else if (group === 'Education') {
        colorClass = 'saas-pin--education';
        iconSvg = SVG_ICONS.Education;
      } else if (group === 'Health') {
        colorClass = 'saas-pin--health';
        iconSvg = SVG_ICONS.Health;
      } else if (group === 'Government') {
        colorClass = 'saas-pin--government';
        iconSvg = SVG_ICONS.Government;
      } else if (group === 'Banking') {
        colorClass = 'saas-pin--banking';
        iconSvg = SVG_ICONS.Banking;
      } else if (group === 'Safety') {
        colorClass = 'saas-pin--safety';
        iconSvg = SVG_ICONS.Safety;
      }

      return L.divIcon({
        className: 'saas-leaflet-divicon',
        html: `
          <div class="saas-pin-wrapper ${colorClass}">
            <div class="pin-halo"></div>
            <div class="pin-card">
              <div class="pin-inner-icon">${iconSvg}</div>
            </div>
            <div class="pin-tip"></div>
          </div>
        `,
        iconSize: [36, 44],
        iconAnchor: [18, 42],
        popupAnchor: [0, -42]
      });
    }

    // Initialize Map Instance
    function initSaaSMap() {
      const container = document.getElementById('osV4Map');
      if (!container || typeof L === 'undefined' || mapInstance) return;

      try {
        // Create Map
        mapInstance = L.map('osV4Map', {
          center: [CHICHAWATNI_CENTER.lat, CHICHAWATNI_CENTER.lng],
          zoom: 13,
          zoomControl: false,
          attributionControl: false,
          scrollWheelZoom: false
        });

        // Layer 1: High-Contrast Free OpenStreetMap Standard Tiles (ZERO WATERMARK!)
        streetTileLayer = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '&copy; OpenStreetMap contributors | SIDDHU GIS'
        });

        // Layer 2: Free High-Res Esri World Imagery (Satellite)
        satelliteTileLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
          maxZoom: 19,
          attribution: 'Tiles &copy; Esri &mdash; Source: Esri, i-cubed, USDA, USGS'
        });

        // Add street layer as default
        streetTileLayer.addTo(mapInstance);

        // Chichawatni Municipal Perimeter Ring (Urban Ring)
        L.circle([CHICHAWATNI_CENTER.lat, CHICHAWATNI_CENTER.lng], {
          color: '#059669',
          fillColor: '#059669',
          fillOpacity: 0.03,
          radius: 2800,
          weight: 1.5,
          dashArray: '6, 6'
        }).addTo(mapInstance);

        // Tehsil Rural Command Ring (Tehsil Boundary Ring)
        L.circle([CHICHAWATNI_CENTER.lat, CHICHAWATNI_CENTER.lng], {
          color: '#D97706',
          fillColor: '#D97706',
          fillOpacity: 0.015,
          radius: 9000,
          weight: 1.2,
          dashArray: '8, 8'
        }).addTo(mapInstance);

        // Marker Clustering Setup:
        // Set disableClusteringAtZoom: 13 so individual pins show easily!
        if (typeof L.markerClusterGroup === 'function') {
          clusterGroup = L.markerClusterGroup({
            showCoverageOnHover: false,
            maxClusterRadius: 26,
            disableClusteringAtZoom: 13,
            spiderfyOnMaxZoom: true,
            iconCreateFunction: function(cluster) {
              const count = cluster.getChildCount();
              return L.divIcon({
                html: `<div class="saas-cluster-bubble"><span>${count}</span></div>`,
                className: 'saas-cluster-divicon',
                iconSize: [38, 38],
                iconAnchor: [19, 19]
              });
            }
          });
          mapInstance.addLayer(clusterGroup);
        } else {
          markersLayerGroup = L.layerGroup().addTo(mapInstance);
        }

        // Add Siddhu Property HQ Marker
        if (officeCoords) {
          const hqMarker = L.marker([officeCoords.lat, officeCoords.lng], {
            icon: createSaaSPinIcon('HQ', true),
            zIndexOffset: 1000
          });

          hqMarker.bindPopup(`
            <div class="saas-popup-card">
              <div class="popup-header-tag hq-tag">
                <i class="fa-solid fa-star"></i> HQ CONSULTATION OFFICE
              </div>
              <h4 class="popup-title">SIDDHU Property Advisor</h4>
              <p class="popup-address">Street 08, Tower Road Side, Hayat Abad, Chichawatni</p>
              <div class="popup-actions">
                <a href="https://www.google.com/maps/dir/?api=1&destination=${officeCoords.lat},${officeCoords.lng}" target="_blank" rel="noopener" class="popup-nav-btn">
                  <i class="fa-solid fa-diamond-turn-right"></i> Directions
                </a>
                <a href="tel:${officeCoords.phone || '+923063996764'}" class="popup-call-btn">
                  <i class="fa-solid fa-phone"></i> Call
                </a>
              </div>
            </div>
          `);

          if (clusterGroup) clusterGroup.addLayer(hqMarker);
          else if (markersLayerGroup) markersLayerGroup.addLayer(hqMarker);
        }

        // Render Initial Verified Locations
        renderAllLocationCardsAndMarkers();

        // Trigger Async Real-Time Overpass Fetch with Cache Check
        fetchLiveOverpassAmenities(false);

        // Invalidate size on load & resize
        setTimeout(() => mapInstance && mapInstance.invalidateSize(), 300);
        window.addEventListener('resize', () => mapInstance && mapInstance.invalidateSize());

      } catch (err) {
        console.error('Error initializing SaaS Map:', err);
      }
    }

    // Render Location Cards in Left Panel & Populate Markers on Map
    function renderAllLocationCardsAndMarkers() {
      const container = document.getElementById('localityListContainer');
      if (!container) return;

      // Clear existing markers from map
      Object.keys(markersMap).forEach(id => {
        const m = markersMap[id];
        if (clusterGroup) clusterGroup.removeLayer(m);
        else if (markersLayerGroup) markersLayerGroup.removeLayer(m);
      });

      // Clear list
      container.innerHTML = '';

      const counts = {
        all: window.ALL_MAP_LOCATIONS.length,
        Residential: 0,
        Private: 0,
        Village: 0,
        Education: 0,
        Health: 0,
        Government: 0,
        Banking: 0,
        Safety: 0
      };

      window.ALL_MAP_LOCATIONS.forEach(loc => {
        if (counts[loc.group] !== undefined) counts[loc.group]++;

        const distanceStr = formatDistanceStr(loc.lat, loc.lng);
        loc._distanceStr = distanceStr;

        // Create Sidebar Card
        const card = document.createElement('div');
        card.className = `locality-list-item cat-${loc.group.toLowerCase()}`;
        card.setAttribute('data-id', loc.id);
        card.setAttribute('data-cat', loc.group);
        card.setAttribute('data-name', loc.name);
        card.setAttribute('data-address', loc.address);

        let groupIconClass = 'fa-house-chimney';
        let groupLabel = loc.group;

        if (loc.group === 'Village') {
          groupIconClass = 'fa-wheat-awn';
          groupLabel = 'Village / Chak';
        } else if (loc.group === 'Private') {
          groupIconClass = 'fa-city';
          groupLabel = 'Private Scheme';
        } else if (loc.group === 'Residential') {
          groupIconClass = 'fa-house-chimney';
          groupLabel = 'Town / Colony';
        } else if (loc.group === 'Education') {
          groupIconClass = 'fa-graduation-cap';
          groupLabel = 'School / College';
        } else if (loc.group === 'Health') {
          groupIconClass = 'fa-heart-pulse';
          groupLabel = 'Hospital / Clinic';
        } else if (loc.group === 'Government') {
          groupIconClass = 'fa-landmark-dome';
          groupLabel = 'Govt / Revenue';
        } else if (loc.group === 'Banking') {
          groupIconClass = 'fa-building-columns';
          groupLabel = 'Bank / Bazaar';
        } else if (loc.group === 'Safety') {
          groupIconClass = 'fa-shield-halved';
          groupLabel = 'Emergency / Police';
        }

        card.innerHTML = `
          <div class="item-top-row">
            <span class="item-category-pill pill-${loc.group.toLowerCase()}">
              <i class="fa-solid ${groupIconClass}"></i> ${groupLabel}
            </span>
            <span class="item-badge-pill">${loc.badge || 'Verified'}</span>
            <span class="item-dist-label">${distanceStr}</span>
          </div>
          <h4 class="item-name">${loc.name}</h4>
          <p class="item-address-line">
            <i class="fa-solid fa-location-dot highlight-gold"></i>
            <span>${loc.address}</span>
          </p>
          <p class="item-desc">${(loc.desc || '').slice(0, 110)}...</p>
          <div class="item-quick-actions">
            <button type="button" class="qa-btn qa-fly" onclick="event.stopPropagation(); window.flyToLoc('${loc.id}');" title="Fly to map marker">
              <i class="fa-solid fa-crosshairs"></i> Fly to Pin
            </button>
            <button type="button" class="qa-btn qa-copy" onclick="event.stopPropagation(); window.copyLocCoords('${loc.lat}', '${loc.lng}', this);" title="Copy GPS Coordinates">
              <i class="fa-regular fa-copy"></i> Copy GPS
            </button>
            <a href="https://www.google.com/maps/dir/?api=1&destination=${loc.lat},${loc.lng}" target="_blank" rel="noopener" class="qa-btn qa-nav" onclick="event.stopPropagation();" title="Google Maps Directions">
              <i class="fa-solid fa-diamond-turn-right"></i> Directions
            </a>
          </div>
        `;

        // Card Selection
        card.addEventListener('click', () => {
          window.selectLocality(loc.id);
        });

        // Hover Physics: Hovering card highlights map pin
        card.addEventListener('mouseenter', () => {
          const marker = markersMap[loc.id];
          if (marker && marker._icon) {
            marker._icon.querySelector('.saas-pin-wrapper')?.classList.add('hover-halo');
          }
        });
        card.addEventListener('mouseleave', () => {
          const marker = markersMap[loc.id];
          if (marker && marker._icon && activeMarkerId !== loc.id) {
            marker._icon.querySelector('.saas-pin-wrapper')?.classList.remove('hover-halo');
          }
        });

        container.appendChild(card);

        // Create Leaflet Marker
        if (mapInstance) {
          const marker = L.marker([loc.lat, loc.lng], {
            icon: createSaaSPinIcon(loc.group)
          });

          marker.bindPopup(`
            <div class="saas-popup-card">
              <div class="popup-header-tag tag-${loc.group.toLowerCase()}">
                ${groupLabel} • ${loc.badge || 'Verified'}
              </div>
              <h4 class="popup-title">${loc.name}</h4>
              <p class="popup-address">${loc.address}</p>
              <div class="popup-distance-row">
                <i class="fa-solid fa-road highlight-gold"></i>
                <span>${distanceStr} (${loc.lat.toFixed(4)}°N, ${loc.lng.toFixed(4)}°E)</span>
              </div>
              <div class="popup-actions">
                <button type="button" class="popup-detail-btn" onclick="window.selectLocality('${loc.id}');">
                  <i class="fa-solid fa-circle-info"></i> Full Details
                </button>
                <a href="https://www.google.com/maps/dir/?api=1&destination=${loc.lat},${loc.lng}" target="_blank" rel="noopener" class="popup-nav-btn">
                  <i class="fa-solid fa-diamond-turn-right"></i> Directions
                </a>
              </div>
            </div>
          `);

          marker.on('click', () => {
            window.selectLocality(loc.id);
          });

          markersMap[loc.id] = marker;

          if (clusterGroup) clusterGroup.addLayer(marker);
          else if (markersLayerGroup) markersLayerGroup.addLayer(marker);
        }
      });

      // Update Filter Counts in UI
      const countAllEl = document.getElementById('countAll');
      if (countAllEl) countAllEl.textContent = counts.all;
      Object.keys(counts).forEach(cat => {
        const el = document.getElementById(`count${cat}`);
        if (el) el.textContent = counts[cat];
      });

      const loadedBadge = document.getElementById('mapLoadedBadge');
      if (loadedBadge) loadedBadge.textContent = window.ALL_MAP_LOCATIONS.length;

      const mobileCountEl = document.getElementById('mobileListCountLabel');
      if (mobileCountEl) mobileCountEl.textContent = window.ALL_MAP_LOCATIONS.length;

      applyMapFilters();
    }

    // Real-Time Overpass API Fetcher & Hybrid Data Merger
    async function fetchLiveOverpassAmenities(forceRefresh = false) {
      const refreshIcon = document.getElementById('refreshSpinIcon');
      const skeletonWrap = document.getElementById('localitySkeletonWrap');
      const listContainer = document.getElementById('localityListContainer');

      if (refreshIcon) refreshIcon.classList.add('fa-spin');

      // Check client-side sessionStorage cache first
      if (!forceRefresh) {
        try {
          const cached = sessionStorage.getItem(CACHE_STORAGE_KEY);
          if (cached) {
            const parsed = JSON.parse(cached);
            if (Date.now() - parsed.timestamp < CACHE_TTL_MS && Array.isArray(parsed.items) && parsed.items.length > 0) {
              mergeOverpassItems(parsed.items, true);
              if (refreshIcon) refreshIcon.classList.remove('fa-spin');
              return;
            }
          }
        } catch (e) {
          console.warn('Session cache read error:', e);
        }
      }

      if (forceRefresh && skeletonWrap && listContainer) {
        skeletonWrap.style.display = 'flex';
        listContainer.style.display = 'none';
      }

      // Overpass QL Query for Tehsil Chichawatni (amenities + villages/hamlets)
      const overpassQuery = `[out:json][timeout:15];
(
  node["place"~"village|hamlet|suburb|town"](around:${OVERPASS_RADIUS_METERS},${CHICHAWATNI_CENTER.lat},${CHICHAWATNI_CENTER.lng});
  node["amenity"~"school|college|hospital|clinic|bank|townhall|police"](around:${OVERPASS_RADIUS_METERS},${CHICHAWATNI_CENTER.lat},${CHICHAWATNI_CENTER.lng});
);
out body 50;`;

      const endpoints = [
        'https://overpass-api.de/api/interpreter',
        'https://lz4.overpass-api.de/api/interpreter'
      ];

      let rawData = null;

      for (const endpoint of endpoints) {
        try {
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 12000);

          const response = await fetch(endpoint, {
            method: 'POST',
            body: `data=${encodeURIComponent(overpassQuery)}`,
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            signal: controller.signal
          });
          clearTimeout(timeoutId);

          if (response.ok) {
            rawData = await response.json();
            break;
          }
        } catch (fetchErr) {
          console.warn(`Overpass endpoint ${endpoint} failed, trying next...`, fetchErr);
        }
      }

      if (skeletonWrap && listContainer) {
        skeletonWrap.style.display = 'none';
        listContainer.style.display = 'flex';
      }
      if (refreshIcon) refreshIcon.classList.remove('fa-spin');

      if (!rawData || !Array.isArray(rawData.elements) || rawData.elements.length === 0) {
        if (forceRefresh) {
          showMapToast('Overpass live API busy. Verified local Tehsil coordinates active.', 'info');
        }
        return;
      }

      // Transform and Deduplicate against existing verified locations
      const newDiscoveredItems = [];
      rawData.elements.forEach((el, index) => {
        const lat = el.lat || (el.center && el.center.lat);
        const lng = el.lon || (el.center && el.center.lon);
        if (!lat || !lng) return;

        const tags = el.tags || {};
        const rawName = tags.name || tags['name:en'] || tags['name:ur'];
        if (!rawName) return;

        // Deduplication: check if within 80m of any verified item
        let isDuplicate = false;
        for (const loc of window.BASE_VERIFIED_LOCATIONS) {
          if (calculateDistanceKm(lat, lng, loc.lat, loc.lng) < 0.08) {
            isDuplicate = true;
            break;
          }
        }
        if (isDuplicate) return;

        // Category Classification
        let group = 'Village';
        let badge = 'OSM Live Data';
        const amenity = tags.amenity || '';
        const place = tags.place || '';

        if (place === 'suburb' || place === 'town') {
          group = 'Residential';
          badge = 'Live Suburb';
        } else if (place === 'village' || place === 'hamlet') {
          group = 'Village';
          badge = 'Live Chak / Village';
        } else if (amenity === 'school' || amenity === 'college') {
          group = 'Education';
          badge = 'Live School';
        } else if (amenity === 'hospital' || amenity === 'clinic') {
          group = 'Health';
          badge = 'Live Clinic/Hospital';
        } else if (amenity === 'bank') {
          group = 'Banking';
          badge = 'Live Bank Branch';
        } else if (amenity === 'townhall' || amenity === 'courthouse') {
          group = 'Government';
          badge = 'Govt Office';
        } else if (amenity === 'police') {
          group = 'Safety';
          badge = 'Emergency/Police';
        }

        newDiscoveredItems.push({
          id: `osm-${el.id || index}`,
          name: rawName,
          category: group,
          group: group,
          lat: lat,
          lng: lng,
          address: tags['addr:street'] ? `${tags['addr:street']}, Chichawatni` : 'Tehsil Chichawatni (OpenStreetMap GIS)',
          badge: badge,
          desc: `Live geospatial coordinate synchronized from OpenStreetMap GIS. Located in Tehsil Chichawatni sector.`,
          legal: 'Real-time OpenStreetMap Geospatial Verification',
          highlights: ['Live API Coordinate', 'OpenStreetMap Verified Point', 'Tehsil Chichawatni Mouza'],
          isVerified: true,
          source: 'OpenStreetMap Live API'
        });
      });

      // Save to sessionStorage
      try {
        sessionStorage.setItem(CACHE_STORAGE_KEY, JSON.stringify({
          timestamp: Date.now(),
          items: newDiscoveredItems
        }));
      } catch (e) {
        console.warn('Cache write failed:', e);
      }

      mergeOverpassItems(newDiscoveredItems, false);
    }

    function mergeOverpassItems(items, fromCache = false) {
      if (!items || items.length === 0) return;

      const existingIds = new Set(window.ALL_MAP_LOCATIONS.map(l => l.id));
      const filtered = items.filter(i => !existingIds.has(i.id));

      if (filtered.length > 0) {
        window.ALL_MAP_LOCATIONS = [...window.BASE_VERIFIED_LOCATIONS, ...filtered];
        renderAllLocationCardsAndMarkers();
        showMapToast(
          fromCache
            ? `Loaded ${filtered.length} live OpenStreetMap locations from cache.`
            : `Synchronized ${filtered.length} live amenities from OpenStreetMap!`,
          'success'
        );
      }
    }

    // Filter Logic
    function applyMapFilters() {
      const searchVal = (document.getElementById('mapLocalitySearch')?.value || '').toLowerCase().trim();
      const items = document.querySelectorAll('#localityListContainer .locality-list-item');
      let visibleCount = 0;

      items.forEach(item => {
        const cat = item.getAttribute('data-cat') || '';
        const name = (item.getAttribute('data-name') || '').toLowerCase();
        const addr = (item.getAttribute('data-address') || '').toLowerCase();

        const matchCat = activeMapCategory === 'all' || cat === activeMapCategory;
        const matchSearch = !searchVal || name.includes(searchVal) || addr.includes(searchVal);

        if (matchCat && matchSearch) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      // Update Map Marker Layer Visibility
      window.ALL_MAP_LOCATIONS.forEach(loc => {
        const marker = markersMap[loc.id];
        if (!marker) return;

        const matchCat = activeMapCategory === 'all' || loc.group === activeMapCategory;
        const matchSearch = !searchVal || loc.name.toLowerCase().includes(searchVal) || loc.address.toLowerCase().includes(searchVal);

        if (matchCat && matchSearch) {
          if (clusterGroup && !clusterGroup.hasLayer(marker)) clusterGroup.addLayer(marker);
          else if (markersLayerGroup && !markersLayerGroup.hasLayer(marker)) markersLayerGroup.addLayer(marker);
        } else {
          if (clusterGroup && clusterGroup.hasLayer(marker)) clusterGroup.removeLayer(marker);
          else if (markersLayerGroup && markersLayerGroup.hasLayer(marker)) markersLayerGroup.removeLayer(marker);
        }
      });

      const badgeEl = document.getElementById('mapLoadedBadge');
      if (badgeEl) badgeEl.textContent = visibleCount;
      const mobileCountEl = document.getElementById('mobileListCountLabel');
      if (mobileCountEl) mobileCountEl.textContent = visibleCount;
    }

    // Public Window Methods for UI Actions
    window.setMapCategory = function(cat, btn) {
      activeMapCategory = cat;
      document.querySelectorAll('#categoryChipsRow .chip-btn').forEach(b => b.classList.remove('active'));
      btn?.classList.add('active');
      applyMapFilters();

      // Smart Zoom Dynamics based on category selection:
      if (mapInstance) {
        if (cat === 'Village') {
          // Zoom out to show wider Tehsil rural expanse
          mapInstance.flyTo([CHICHAWATNI_CENTER.lat, CHICHAWATNI_CENTER.lng], 11.5, { duration: 1.0 });
        } else if (cat === 'Residential' || cat === 'Private') {
          // Zoom into urban center
          mapInstance.flyTo([CHICHAWATNI_CENTER.lat, CHICHAWATNI_CENTER.lng], 14, { duration: 1.0 });
        }
      }
    };

    window.handleMapSearchInput = function(val) {
      const clearBtn = document.getElementById('mapSearchClearBtn');
      if (clearBtn) clearBtn.style.display = val ? 'flex' : 'none';

      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(() => {
        applyMapFilters();
      }, 150);
    };

    window.clearMapSearch = function() {
      const input = document.getElementById('mapLocalitySearch');
      if (input) {
        input.value = '';
        window.handleMapSearchInput('');
        input.focus();
      }
    };

    window.scrollCategoryChips = function(offset) {
      const row = document.getElementById('categoryChipsRow');
      if (row) {
        row.scrollBy({ left: offset, behavior: 'smooth' });
      }
    };

    window.selectLocality = function(id) {
      const loc = window.ALL_MAP_LOCATIONS.find(l => l.id === id);
      if (!loc) return;

      activeMarkerId = id;

      // Pan & Zoom Map
      if (mapInstance) {
        mapInstance.flyTo([loc.lat, loc.lng], 15.5, { duration: 1.1 });
        mapInstance.invalidateSize();
      }

      // Open Marker Popup and Activate Halo
      Object.keys(markersMap).forEach(mId => {
        const m = markersMap[mId];
        m?._icon?.querySelector('.saas-pin-wrapper')?.classList.remove('active-pin');
      });

      const marker = markersMap[id];
      if (marker) {
        marker.openPopup();
        marker._icon?.querySelector('.saas-pin-wrapper')?.classList.add('active-pin');
      }

      // Highlight active card in sidebar
      document.querySelectorAll('#localityListContainer .locality-list-item').forEach(card => {
        if (card.getAttribute('data-id') === id) {
          card.classList.add('active-card');
          card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          card.classList.remove('active-card');
        }
      });

      // Show Details Panel in Sidebar
      const listWrap = document.getElementById('localityListContainer');
      const controls = document.getElementById('sidebarControls');
      const detailView = document.getElementById('localityDetailView');

      if (listWrap && controls && detailView) {
        listWrap.style.display = 'none';
        controls.style.display = 'none';
        detailView.style.display = 'flex';

        document.getElementById('detailTitle').textContent = loc.name;
        document.getElementById('detailCategoryTag').textContent = `${loc.group} • ${loc.badge || 'Verified'}`;
        document.getElementById('detailCategoryTag').className = `detail-category-tag cat-${loc.group.toLowerCase()}`;
        document.getElementById('detailDistanceBadge').textContent = loc._distanceStr || formatDistanceStr(loc.lat, loc.lng);
        document.getElementById('detailAddressText').textContent = loc.address;
        document.getElementById('detailCoordsMono').textContent = `${loc.lat.toFixed(4)}° N, ${loc.lng.toFixed(4)}° E`;
        document.getElementById('detailDesc').textContent = loc.desc || 'Verified locality in Tehsil Chichawatni.';
        document.getElementById('detailLegal').textContent = loc.legal || 'Registered under Tehsil Revenue and Arazi Record Center.';

        const gmapsBtn = document.getElementById('detailGmapsBtn');
        if (gmapsBtn) {
          gmapsBtn.href = `https://www.google.com/maps/dir/?api=1&destination=${loc.lat},${loc.lng}`;
        }

        const highlightsEl = document.getElementById('detailHighlights');
        if (highlightsEl) {
          const items = Array.isArray(loc.highlights) && loc.highlights.length > 0
            ? loc.highlights
            : ['Verified Road Access', 'Zoning Clearance', 'Arazi Record Registry Verified'];
          highlightsEl.innerHTML = items.map(h => `<li><i class="fa-solid fa-check highlight-gold"></i> <span>${h}</span></li>`).join('');
        }
      }

      // On mobile view, switch to map view tab automatically so user sees the pin
      if (window.innerWidth < 992) {
        window.switchMobileMapView('map');
      }
    };

    window.closeLocalityDetail = function() {
      activeMarkerId = null;
      const listWrap = document.getElementById('localityListContainer');
      const controls = document.getElementById('sidebarControls');
      const detailView = document.getElementById('localityDetailView');

      if (listWrap && controls && detailView) {
        detailView.style.display = 'none';
        listWrap.style.display = 'flex';
        controls.style.display = 'block';
      }

      Object.keys(markersMap).forEach(mId => {
        markersMap[mId]?._icon?.querySelector('.saas-pin-wrapper')?.classList.remove('active-pin');
      });

      document.querySelectorAll('#localityListContainer .locality-list-item').forEach(c => c.classList.remove('active-card'));

      if (mapInstance) {
        mapInstance.flyTo([CHICHAWATNI_CENTER.lat, CHICHAWATNI_CENTER.lng], 13, { duration: 1.0 });
        mapInstance.invalidateSize();
      }
    };

    window.flyToLoc = function(id) {
      window.selectLocality(id);
    };

    window.copyLocCoords = function(lat, lng, btn) {
      const text = `${lat}, ${lng}`;
      navigator.clipboard.writeText(text).then(() => {
        if (btn) {
          const original = btn.innerHTML;
          btn.innerHTML = `<i class="fa-solid fa-check" style="color: #059669;"></i> Copied!`;
          setTimeout(() => btn.innerHTML = original, 2000);
        }
        showMapToast(`Coordinates ${text} copied to clipboard!`, 'success');
      });
    };

    window.copyDetailCoords = function() {
      const coordsText = document.getElementById('detailCoordsMono')?.textContent || '';
      navigator.clipboard.writeText(coordsText).then(() => {
        const label = document.getElementById('copyCoordsLabel');
        if (label) {
          label.textContent = 'Copied!';
          setTimeout(() => label.textContent = 'Copy GPS', 2000);
        }
        showMapToast(`GPS coordinates copied!`, 'success');
      });
    };

    window.recenterMap = function() {
      window.closeLocalityDetail();
      if (mapInstance) {
        mapInstance.flyTo([CHICHAWATNI_CENTER.lat, CHICHAWATNI_CENTER.lng], 13, { duration: 1.0 });
        mapInstance.invalidateSize();
      }
      showMapToast('Map recentered on Tehsil Chichawatni.', 'info');
    };

    window.mapZoomIn = function() {
      if (mapInstance) mapInstance.zoomIn();
    };

    window.mapZoomOut = function() {
      if (mapInstance) mapInstance.zoomOut();
    };

    window.toggleSatelliteLayer = function() {
      if (!mapInstance || !streetTileLayer || !satelliteTileLayer) return;

      const indicator = document.getElementById('tileModeLabel');
      const toggleBtn = document.getElementById('btnToggleTileLayer');

      if (isSatelliteActive) {
        mapInstance.removeLayer(satelliteTileLayer);
        mapInstance.addLayer(streetTileLayer);
        isSatelliteActive = false;
        if (indicator) indicator.textContent = 'SaaS Street View';
        if (toggleBtn) toggleBtn.classList.remove('active-control');
        showMapToast('Switched to Clean Street Map view.', 'info');
      } else {
        mapInstance.removeLayer(streetTileLayer);
        mapInstance.addLayer(satelliteTileLayer);
        isSatelliteActive = true;
        if (indicator) indicator.textContent = 'Satellite Imagery';
        if (toggleBtn) toggleBtn.classList.add('active-control');
        showMapToast('Switched to High-Resolution Satellite Imagery.', 'info');
      }
    };

    window.locateUserGPS = function() {
      if (!navigator.geolocation) {
        showMapToast('Geolocation is not supported by your browser.', 'warning');
        return;
      }
      showMapToast('Detecting your GPS location...', 'info');

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const userLat = pos.coords.latitude;
          const userLng = pos.coords.longitude;
          const accuracy = pos.coords.accuracy;

          if (mapInstance) {
            if (userLocationMarker) mapInstance.removeLayer(userLocationMarker);
            if (userAccuracyCircle) mapInstance.removeLayer(userAccuracyCircle);

            userAccuracyCircle = L.circle([userLat, userLng], {
              radius: accuracy,
              color: '#2563EB',
              fillColor: '#2563EB',
              fillOpacity: 0.15,
              weight: 1
            }).addTo(mapInstance);

            const userIcon = L.divIcon({
              className: 'user-gps-pulse-beacon',
              html: `<div class="user-beacon-core"><div class="user-beacon-ring"></div></div>`,
              iconSize: [24, 24],
              iconAnchor: [12, 12]
            });

            userLocationMarker = L.marker([userLat, userLng], { icon: userIcon }).addTo(mapInstance);
            userLocationMarker.bindPopup(`
              <div class="saas-popup-card">
                <h4 class="popup-title">Your Current Position</h4>
                <p class="popup-address">${formatDistanceStr(userLat, userLng)}</p>
              </div>
            `).openPopup();

            mapInstance.flyTo([userLat, userLng], 15, { duration: 1.2 });
            showMapToast('Your GPS location detected!', 'success');
          }
        },
        (err) => {
          console.warn('Geolocation error:', err);
          showMapToast('Location permission denied or unavailable.', 'warning');
        },
        { enableHighAccuracy: true, timeout: 8000 }
      );
    };

    window.refreshOverpassApi = function(force) {
      showMapToast('Syncing real-time amenities via OpenStreetMap Overpass API...', 'info');
      fetchLiveOverpassAmenities(force);
    };

    window.switchMobileMapView = function(mode) {
      const sidebar = document.getElementById('mapPanelSidebar');
      const btnMap = document.getElementById('btnTabMap');
      const btnList = document.getElementById('btnTabList');

      if (mode === 'map') {
        sidebar?.classList.add('mobile-hidden');
        btnMap?.classList.add('active');
        btnList?.classList.remove('active');
        if (mapInstance) setTimeout(() => mapInstance.invalidateSize(), 200);
      } else {
        sidebar?.classList.remove('mobile-hidden');
        btnList?.classList.add('active');
        btnMap?.classList.remove('active');
      }
    };

    // Keyboard Shortcut Listener: / or Ctrl+K / Cmd+K
    document.addEventListener('keydown', (e) => {
      if ((e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') ||
          ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) {
        e.preventDefault();
        const searchInput = document.getElementById('mapLocalitySearch');
        if (searchInput) {
          searchInput.focus();
          searchInput.select();
        }
      }
      if (e.key === 'Escape') {
        const detailView = document.getElementById('localityDetailView');
        if (detailView && detailView.style.display !== 'none') {
          window.closeLocalityDetail();
        }
      }
    });

    // Check Leaflet Readiness and Bootstrap
    function checkAndInit() {
      if (typeof L === 'undefined') {
        let attempts = 0;
        const timer = setInterval(() => {
          attempts++;
          if (typeof L !== 'undefined') {
            clearInterval(timer);
            initSaaSMap();
          } else if (attempts > 50) {
            clearInterval(timer);
            console.warn('Leaflet script took too long to load.');
          }
        }, 100);
        return;
      }
      initSaaSMap();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', checkAndInit);
    } else {
      checkAndInit();
    }
  })();
</script>

