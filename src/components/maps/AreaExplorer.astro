---
import { localities } from '@/data/locations';
import { cityPlaces } from '@/data/cityIntelligence';
import { business } from '@/data/business';

// Deduplicate locations by id
const seenMapIds = new Set<string>();
const allMapLocations = [
  ...localities.map(loc => ({
    id: loc.id,
    name: loc.name,
    category: loc.category,
    group: 'Residential',
    lat: loc.lat,
    lng: loc.lng,
    address: loc.parentChak || 'Chichawatni',
    badge: loc.statusBadge,
    desc: loc.description,
    legal: loc.legalStatus,
    highlights: loc.highlights
  })),
  ...cityPlaces.map(p => ({
    id: p.id,
    name: p.name,
    category: p.category,
    group: p.category,
    lat: p.lat,
    lng: p.lng,
    address: `${p.locality} • ${p.roadAddress}`,
    badge: p.subCategory,
    desc: p.usefulness,
    legal: p.roadAddress,
    highlights: p.highlights
  }))
].filter(loc => {
  if (seenMapIds.has(loc.id)) return false;
  seenMapIds.add(loc.id);
  return true;
});
---

<section id="areas" class="map-section">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">
        <i class="fa-solid fa-map-location-dot highlight-gold"></i>
        <span>GEOGRAPHIC INTELLIGENCE & MAP</span>
      </span>
      <h2>
        Chichawatni <span class="editorial-italic highlight-gold">Interactive Property & Civic Map</span>
      </h2>
      <p>
        Explore verified residential colonies, road corridors, government revenue offices, hospitals, schools, and banks across Tehsil Chichawatni with live interactive GPS coordinates.
      </p>
    </div>

    <!-- Map Layout Container: Left Sidebar / Detail Panel + Right Map -->
    <div class="map-layout-grid">
      <!-- Left Panel: Locality Search & Detail View -->
      <aside class="map-panel-sidebar">
        <!-- Search & Filter Controls -->
        <div class="sidebar-top" id="sidebarControls">
          <div class="map-search-box">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input
              type="text"
              id="mapLocalitySearch"
              placeholder="Search colony, school, hospital, or office..."
              class="map-search-input"
              oninput="window.filterMapLocalities(this.value);"
            />
          </div>

          <!-- Category Chips -->
          <div class="category-chips-row">
            <button class="chip-btn active" data-cat="all" onclick="window.setMapCategory('all', this);">All</button>
            <button class="chip-btn" data-cat="Residential" onclick="window.setMapCategory('Residential', this);">Colonies</button>
            <button class="chip-btn" data-cat="Education" onclick="window.setMapCategory('Education', this);">Schools/Colleges</button>
            <button class="chip-btn" data-cat="Health" onclick="window.setMapCategory('Health', this);">Hospitals</button>
            <button class="chip-btn" data-cat="Government" onclick="window.setMapCategory('Government', this);">PLRA & Govt</button>
            <button class="chip-btn" data-cat="Banking" onclick="window.setMapCategory('Banking', this);">Banks</button>
            <button class="chip-btn" data-cat="Safety" onclick="window.setMapCategory('Safety', this);">Safety</button>
          </div>
        </div>

        <!-- Locality Items Scroll List -->
        <div class="locality-scroll-list" id="localityListContainer">
          {allMapLocations.map(loc => (
            <div
              class="locality-list-item"
              data-id={loc.id}
              data-cat={loc.group}
              data-name={loc.name}
              data-address={loc.address}
              onclick={`window.selectLocality('${loc.id}');`}
            >
              <div class="item-header">
                <h4 class="item-name">{loc.name}</h4>
                <span class="item-badge">
                  {loc.badge}
                </span>
              </div>
              <p class="item-category">
                <i class="fa-solid fa-location-dot highlight-gold"></i> {loc.address}
              </p>
              <p class="item-desc">{loc.desc.slice(0, 95)}...</p>
            </div>
          ))}
        </div>

        <!-- Detail View (Shown on Locality Click) -->
        <div class="locality-detail-view" id="localityDetailView" style="display: none;">
          <button class="back-to-list-btn" onclick="window.closeLocalityDetail();">
            <i class="fa-solid fa-arrow-left"></i> Back to all locations
          </button>

          <div class="detail-header">
            <span class="detail-badge" id="detailBadge">Verified</span>
            <h3 class="detail-title" id="detailTitle">Hayat Abad</h3>
            <span class="detail-category" id="detailCategory">Residential Locality</span>
          </div>

          <div class="detail-body">
            <p class="detail-description" id="detailDesc"></p>

            <div class="detail-legal-box">
              <strong><i class="fa-solid fa-shield-halved highlight-gold"></i> Location & Relevance:</strong>
              <p id="detailLegal"></p>
            </div>

            <div class="detail-highlights-wrap">
              <strong>Key Highlights:</strong>
              <ul class="detail-highlights-list" id="detailHighlights"></ul>
            </div>
          </div>

          <div class="detail-footer">
            <a id="detailGmapsBtn" href="https://maps.google.com" target="_blank" rel="noopener" class="btn-gmaps" style="width: 100%; justify-content: center; font-size: 0.88rem; margin-bottom: 8px;">
              <i class="fa-solid fa-diamond-turn-right"></i> Open Directions in Google Maps
            </a>
            <a href="tel:+923063996764" class="btn-primary" style="width: 100%; justify-content: center; font-size: 0.88rem;">
              <i class="fa-solid fa-phone"></i> Inquire About Property in This Area
            </a>
          </div>
        </div>
      </aside>

      <!-- Right Map View -->
      <div class="map-viewport-wrapper">
        <div id="osV4Map" class="leaflet-map-canvas"></div>
        <div class="map-attribution-note">
          <i class="fa-solid fa-circle-info highlight-gold"></i> Showing verified Tehsil Chichawatni GPS coordinates. Private home pins protected.
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ mapLocationsData: allMapLocations, officeCoords: business.coordinates }}>
  window.ALL_MAP_LOCATIONS = mapLocationsData;
  let activeMapCategory = 'all';
  let mapInstance = null;
  let activeMarker = null;
  const markersMap = {};

  function initV4Map() {
    const container = document.getElementById('osV4Map');
    if (!container || typeof L === 'undefined' || mapInstance) return;

    try {
      // Initialize Leaflet Map centered on central Chichawatni
      mapInstance = L.map('osV4Map', {
        center: [30.5345, 72.6900],
        zoom: 14,
        zoomControl: true,
        scrollWheelZoom: false
      });

      // Clean, crisp CARTO Voyager Map Tiles
      L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://carto.com/">CARTO</a> & OpenStreetMap | Siddhu Property Advisor',
        maxZoom: 19,
        subdomains: 'abcd'
      }).addTo(mapInstance);

      // Subtle Chichawatni Urban Boundary Ring
      L.circle([30.5350, 72.6900], {
        color: '#3F6B5B',
        fillColor: '#3F6B5B',
        fillOpacity: 0.04,
        radius: 2400,
        weight: 1.5,
        dashArray: '6, 6'
      }).addTo(mapInstance);

      // Force recalculation of container bounds after render
      setTimeout(() => {
        if (mapInstance) mapInstance.invalidateSize();
      }, 250);

      window.addEventListener('resize', () => {
        if (mapInstance) mapInstance.invalidateSize();
      });

      // Custom Icon Generator for Categories
      function createCategoryIcon(group, isOffice = false) {
        let iconClass = 'fa-solid fa-location-dot';
        let colorClass = 'pin-residential';

        if (isOffice) {
          iconClass = 'fa-solid fa-star';
          colorClass = 'pin-office';
        } else if (group === 'Residential') {
          iconClass = 'fa-solid fa-house-chimney';
          colorClass = 'pin-residential';
        } else if (group === 'Education') {
          iconClass = 'fa-solid fa-graduation-cap';
          colorClass = 'pin-education';
        } else if (group === 'Health') {
          iconClass = 'fa-solid fa-hospital';
          colorClass = 'pin-health';
        } else if (group === 'Government') {
          iconClass = 'fa-solid fa-landmark-dome';
          colorClass = 'pin-government';
        } else if (group === 'Banking') {
          iconClass = 'fa-solid fa-building-columns';
          colorClass = 'pin-banking';
        } else if (group === 'Safety') {
          iconClass = 'fa-solid fa-shield-halved';
          colorClass = 'pin-safety';
        } else {
          iconClass = 'fa-solid fa-landmark';
          colorClass = 'pin-gold';
        }

        return L.divIcon({
          className: 'custom-map-pin-wrapper',
          html: `<div class="map-pin ${colorClass}"><i class="${iconClass}"></i></div>`,
          iconSize: [32, 32],
          iconAnchor: [16, 32],
          popupAnchor: [0, -32]
        });
      }

      // Add Siddhu Property HQ Marker
      const hqMarker = L.marker([officeCoords.lat, officeCoords.lng], {
        icon: createCategoryIcon('HQ', true)
      }).addTo(mapInstance);
      hqMarker.bindPopup(`
        <div style="font-family: inherit; padding: 4px; min-width: 200px;">
          <strong style="color: #29473D; font-size: 0.95rem; display: block;">SIDDHU Property Advisor HQ</strong>
          <p style="margin: 4px 0 0; color: #4A5D55; font-size: 0.8rem;">Street 08, Tower Road Side, Hayat Abad</p>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 8px; border-top: 1px solid #ECEEEB; padding-top: 6px;">
            <span style="font-size: 0.72rem; color: #C8A96B; font-weight: 700;">★ Consultation Base</span>
            <a href="https://www.google.com/maps/dir/?api=1&destination=${officeCoords.lat},${officeCoords.lng}" target="_blank" rel="noopener" style="color: #29473D; font-size: 0.74rem; font-weight: 700; text-decoration: underline;">
              Directions ↗
            </a>
          </div>
        </div>
      `);

      // Add All Location Markers
      window.ALL_MAP_LOCATIONS.forEach(loc => {
        const marker = L.marker([loc.lat, loc.lng], {
          icon: createCategoryIcon(loc.group)
        }).addTo(mapInstance);

        marker.bindPopup(`
          <div style="font-family: inherit; padding: 4px; max-width: 210px;">
            <strong style="color: #29473D; font-size: 0.92rem; display: block; margin-bottom: 2px;">${loc.name}</strong>
            <p style="margin: 0; color: #4A5D55; font-size: 0.78rem;">${loc.address}</p>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 8px; border-top: 1px solid #ECEEEB; padding-top: 6px;">
              <span style="font-size: 0.7rem; color: #3F6B5B; font-weight: 600;">${loc.badge}</span>
              <a href="https://www.google.com/maps/dir/?api=1&destination=${loc.lat},${loc.lng}" target="_blank" rel="noopener" style="color: #C8A96B; font-size: 0.74rem; font-weight: 700; text-decoration: underline;">
                Google Maps ↗
              </a>
            </div>
          </div>
        `);

        marker.on('click', () => {
          window.selectLocality(loc.id);
        });

        markersMap[loc.id] = marker;
      });
    } catch (err) {
      console.error('Error initializing map:', err);
    }
  }

  // Locality Selection & Panel Switcher
  window.selectLocality = function(id) {
    const loc = window.ALL_MAP_LOCATIONS.find(l => l.id === id);
    if (!loc) return;

    // Pan & Fly map
    if (mapInstance) {
      mapInstance.flyTo([loc.lat, loc.lng], 16, { duration: 1.0 });
      mapInstance.invalidateSize();
    }

    // Update marker styling (pulse gold)
    if (activeMarker && activeMarker._icon) {
      activeMarker._icon.querySelector('.map-pin')?.classList.remove('pulse-active');
    }
    const marker = markersMap[id];
    if (marker) {
      marker.openPopup();
      if (marker._icon) {
        marker._icon.querySelector('.map-pin')?.classList.add('pulse-active');
        activeMarker = marker;
      }
    }

    // Show details in left panel
    const listWrap = document.getElementById('localityListContainer');
    const controls = document.getElementById('sidebarControls');
    const detailView = document.getElementById('localityDetailView');

    if (listWrap && controls && detailView) {
      listWrap.style.display = 'none';
      controls.style.display = 'none';
      detailView.style.display = 'flex';

      document.getElementById('detailTitle').textContent = loc.name;
      document.getElementById('detailCategory').textContent = `${loc.group} • ${loc.address}`;
      document.getElementById('detailBadge').textContent = loc.badge;
      document.getElementById('detailDesc').textContent = loc.desc;
      document.getElementById('detailLegal').textContent = loc.legal || loc.address;

      const gmapsBtn = document.getElementById('detailGmapsBtn');
      if (gmapsBtn) {
        gmapsBtn.href = `https://www.google.com/maps/dir/?api=1&destination=${loc.lat},${loc.lng}`;
      }

      const highlightsEl = document.getElementById('detailHighlights');
      if (highlightsEl) {
        highlightsEl.innerHTML = loc.highlights.map(h => `<li><i class="fa-solid fa-check highlight-gold"></i> ${h}</li>`).join('');
      }
    }
  };

  window.closeLocalityDetail = function() {
    const listWrap = document.getElementById('localityListContainer');
    const controls = document.getElementById('sidebarControls');
    const detailView = document.getElementById('localityDetailView');

    if (listWrap && controls && detailView) {
      detailView.style.display = 'none';
      listWrap.style.display = 'flex';
      controls.style.display = 'block';
    }

    if (activeMarker && activeMarker._icon) {
      activeMarker._icon.querySelector('.map-pin')?.classList.remove('pulse-active');
      activeMarker = null;
    }

    if (mapInstance) {
      mapInstance.flyTo([30.5345, 72.6900], 14, { duration: 1.0 });
      mapInstance.invalidateSize();
    }
  };

  window.setMapCategory = function(cat, btn) {
    activeMapCategory = cat;
    document.querySelectorAll('.category-chips-row .chip-btn').forEach(b => b.classList.remove('active'));
    btn?.classList.add('active');
    applyMapFilters();
  };

  window.filterMapLocalities = function() {
    applyMapFilters();
  };

  function applyMapFilters() {
    const searchVal = document.getElementById('mapLocalitySearch')?.value.toLowerCase().trim() || '';
    const items = document.querySelectorAll('#localityListContainer .locality-list-item');

    items.forEach(item => {
      const cat = item.getAttribute('data-cat') || '';
      const name = item.getAttribute('data-name')?.toLowerCase() || '';
      const addr = item.getAttribute('data-address')?.toLowerCase() || '';

      const matchCat = activeMapCategory === 'all' || cat === activeMapCategory;
      const matchSearch = !searchVal || name.includes(searchVal) || addr.includes(searchVal);

      if (matchCat && matchSearch) {
        item.style.display = 'block';
      } else {
        item.style.display = 'none';
      }
    });

    // Also update map markers visibility
    window.ALL_MAP_LOCATIONS.forEach(loc => {
      const marker = markersMap[loc.id];
      if (!marker) return;

      const matchCat = activeMapCategory === 'all' || loc.group === activeMapCategory;
      const matchSearch = !searchVal || loc.name.toLowerCase().includes(searchVal) || loc.address.toLowerCase().includes(searchVal);

      if (matchCat && matchSearch) {
        if (!mapInstance?.hasLayer(marker)) marker.addTo(mapInstance);
      } else {
        if (mapInstance?.hasLayer(marker)) mapInstance.removeLayer(marker);
      }
    });

    if (mapInstance) mapInstance.invalidateSize();
  }

  // Cross-component coordination: Focus any place from CityIntelligence
  window.flyToMapCoordinates = function(lat, lng, name, id) {
    if (mapInstance) {
      mapInstance.flyTo([lat, lng], 16, { duration: 1.2 });
      mapInstance.invalidateSize();
      if (markersMap[id]) {
        setTimeout(() => {
          window.selectLocality(id);
        }, 800);
      }
    }
  };

  function checkAndInitMap() {
    if (typeof L === 'undefined') {
      let attempts = 0;
      const timer = setInterval(() => {
        attempts++;
        if (typeof L !== 'undefined') {
          clearInterval(timer);
          initV4Map();
        } else if (attempts > 50) {
          clearInterval(timer);
          console.warn('Leaflet map script failed to load within 5 seconds.');
        }
      }, 100);
      return;
    }
    initV4Map();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkAndInitMap);
  } else {
    checkAndInitMap();
  }
</script>

<style>
  .map-section {
    padding: 90px 0;
    background: #EFEFE9;
    border-bottom: 1px solid var(--border-subtle);
  }

  .map-layout-grid {
    display: grid;
    grid-template-columns: 440px 1fr;
    height: 650px;
    background: #FFFFFF;
    border: 1px solid var(--border-card);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  /* Sidebar */
  .map-panel-sidebar {
    background: #FFFFFF;
    border-right: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .sidebar-top {
    padding: 20px 20px 14px;
    border-bottom: 1px solid var(--border-subtle);
    background: #FAFBF9;
  }

  .map-search-box {
    position: relative;
    margin-bottom: 12px;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.9rem;
    color: var(--color-matte-green);
  }

  .map-search-input {
    width: 100%;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    padding: 10px 14px 10px 38px;
    border-radius: var(--radius-full);
    font-size: 0.88rem;
    font-family: inherit;
    transition: var(--transition);
  }

  .map-search-input:focus {
    outline: none;
    border-color: var(--color-matte-green);
    box-shadow: 0 0 0 3px rgba(63, 107, 91, 0.12);
  }

  .category-chips-row {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 4px;
  }

  .chip-btn {
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 5px 12px;
    border-radius: var(--radius-full);
    font-size: 0.76rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: var(--transition);
  }

  .chip-btn:hover {
    border-color: var(--color-matte-green);
    color: var(--color-dark-green);
    background: #F3F7F5;
  }

  .chip-btn.active {
    background: var(--color-dark-green);
    color: #FFFFFF;
    border-color: var(--color-dark-green);
    font-weight: 600;
  }

  /* Scroll list */
  .locality-scroll-list {
    flex-grow: 1;
    overflow-y: auto;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #FFFFFF;
  }

  .locality-list-item {
    background: #FAFBF9;
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
    padding: 14px;
    cursor: pointer;
    transition: var(--transition);
  }

  .locality-list-item:hover {
    background: #F3F7F5;
    border-color: var(--color-matte-green);
    transform: translateX(3px);
  }

  .item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 5px;
  }

  .item-name {
    font-size: 0.98rem;
    color: var(--text-primary);
    font-weight: 700;
  }

  .item-badge {
    font-size: 0.68rem;
    padding: 2px 7px;
    border-radius: var(--radius-full);
    background: rgba(63, 107, 91, 0.1);
    color: var(--color-dark-green);
    font-weight: 600;
    white-space: nowrap;
  }

  .item-category {
    font-size: 0.78rem;
    color: var(--text-secondary);
    margin-bottom: 5px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .item-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  /* Detail View */
  .locality-detail-view {
    padding: 20px;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow-y: auto;
    gap: 16px;
    background: #FFFFFF;
  }

  .back-to-list-btn {
    background: #FAFBF9;
    border: 1px solid var(--border-subtle);
    color: var(--color-dark-green);
    padding: 7px 14px;
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    transition: var(--transition);
  }

  .back-to-list-btn:hover {
    background: var(--color-dark-green);
    color: #FFFFFF;
  }

  .detail-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .detail-badge {
    font-size: 0.72rem;
    color: var(--color-matte-green);
    font-weight: 700;
    text-transform: uppercase;
  }

  .detail-title {
    font-size: 1.35rem;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .detail-category {
    font-size: 0.82rem;
    color: var(--color-gold);
    font-weight: 600;
  }

  .detail-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex-grow: 1;
  }

  .detail-description {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .detail-legal-box {
    background: #F3F7F5;
    border-left: 3px solid var(--color-matte-green);
    padding: 10px 14px;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .detail-highlights-wrap {
    font-size: 0.85rem;
  }

  .detail-highlights-list {
    list-style: none;
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .detail-highlights-list li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .btn-gmaps {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #F3F7F5;
    border: 1px solid var(--color-matte-green);
    color: var(--color-dark-green);
    padding: 10px 16px;
    border-radius: var(--radius-full);
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition);
  }

  .btn-gmaps:hover {
    background: var(--color-dark-green);
    color: #FFFFFF;
  }

  /* Map Viewport */
  .map-viewport-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .leaflet-map-canvas {
    width: 100%;
    height: 100%;
    background: #EFEFE9;
  }

  .map-attribution-note {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-subtle);
    padding: 6px 12px;
    border-radius: var(--radius-full);
    font-size: 0.74rem;
    color: var(--text-secondary);
    z-index: 500;
    display: flex;
