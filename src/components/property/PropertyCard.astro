---
import type { PropertyItem } from '@/data/properties';
import { business } from '@/data/business';

interface Props {
  property: PropertyItem;
}

const { property } = Astro.props;
---

<article class="property-card v4-card" data-id={property.id} data-area={property.area} data-type={property.type} data-size={property.sizeMarla}>
  <!-- Card Image Container -->
  <div class="card-media">
    <img
      src={property.image}
      alt={property.title}
      loading="lazy"
      class="card-img"
    />
    <div class="card-badges">
      <span class="badge-tag">{property.badge}</span>
      {property.verified && (
        <span class="badge-verified">
          <i class="fa-solid fa-circle-check"></i> Verified
        </span>
      )}
    </div>
    <!-- Compare Checkbox -->
    <label class="compare-toggle-label" title="Select to compare">
      <input type="checkbox" class="compare-checkbox" data-property-id={property.id} onchange="window.togglePropertyCompare(this);" />
      <span>Compare</span>
    </label>
  </div>

  <!-- Card Body -->
  <div class="card-body">
    <div class="card-location">
      <i class="fa-solid fa-location-dot highlight-gold"></i>
      <span>{property.locationLabel}</span>
    </div>

    <h3 class="card-title">{property.title}</h3>

    <!-- Specs Pill Row -->
    <div class="card-specs">
      <div class="spec-item">
        <i class="fa-solid fa-ruler-combined highlight-teal"></i>
        <span>{property.sizeLabel}</span>
      </div>
      {property.bedrooms !== null && (
        <div class="spec-item">
          <i class="fa-solid fa-bed highlight-teal"></i>
          <span>{property.bedrooms} Beds</span>
        </div>
      )}
      {property.bathrooms !== null && (
        <div class="spec-item">
          <i class="fa-solid fa-bath highlight-teal"></i>
          <span>{property.bathrooms} Baths</span>
        </div>
      )}
      {property.garage && (
        <div class="spec-item">
          <i class="fa-solid fa-car highlight-teal"></i>
          <span>{property.garage}</span>
        </div>
      )}
    </div>

    <p class="card-desc">
      {property.description}
    </p>

    <!-- Facilities tags -->
    <div class="facilities-tags">
      {property.facilities.slice(0, 3).map(f => (
        <span class="facility-pill">{f}</span>
      ))}
      {property.facilities.length > 3 && (
        <span class="facility-pill more">+{property.facilities.length - 3} more</span>
      )}
    </div>

    <!-- Card Actions Footer -->
    <div class="card-footer">
      <a href={`tel:${business.phone}`} class="btn-primary card-action-btn">
        <i class="fa-solid fa-phone"></i>
        <span>Call Naeem</span>
      </a>
      <a
        href={`https://wa.me/923063996764?text=${encodeURIComponent(`Hello Naeem Siddhu, I am inquiring about: ${property.title} in ${property.locationLabel}`)}`}
        target="_blank"
        rel="noopener"
        class="btn-whatsapp card-action-btn"
      >
        <i class="fa-brands fa-whatsapp"></i>
        <span>WhatsApp</span>
      </a>
    </div>
  </div>
</article>

<style>
  .property-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
  }

  .card-media {
    position: relative;
    width: 100%;
    height: 240px;
    background: #000;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
  }

  .property-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-badges {
    position: absolute;
    top: 14px;
    left: 14px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    z-index: 2;
  }

  .badge-tag {
    background: rgba(13, 23, 35, 0.85);
    border: 1px solid var(--border-glass);
    color: var(--text-primary);
    font-size: 0.76rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    backdrop-filter: blur(8px);
  }

  .badge-verified {
    background: rgba(90, 148, 141, 0.88);
    color: #FFFFFF;
    font-size: 0.74rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .compare-toggle-label {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(13, 23, 35, 0.85);
    border: 1px solid var(--border-glass);
    color: var(--text-secondary);
    font-size: 0.78rem;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: var(--transition);
    z-index: 2;
  }

  .compare-toggle-label:hover {
    color: var(--accent-gold-light);
    border-color: var(--accent-gold);
  }

  .compare-checkbox {
    cursor: pointer;
    accent-color: var(--accent-gold);
  }

  .card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 14px;
  }

  .card-location {
    font-size: 0.82rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 500;
  }

  .card-title {
    font-size: 1.35rem;
    line-height: 1.3;
    color: var(--text-primary);
  }

  .card-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 10px 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .spec-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.84rem;
    color: var(--text-secondary);
  }

  .card-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-muted);
    flex-grow: 1;
  }

  .facilities-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .facility-pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    font-size: 0.75rem;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  .facility-pill.more {
    color: var(--accent-gold-light);
  }

  .card-footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 6px;
  }

  .card-action-btn {
    padding: 10px 14px;
    font-size: 0.85rem;
  }
</style>
