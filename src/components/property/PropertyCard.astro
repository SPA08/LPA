---
import type { PropertyItem } from '@/data/properties';
import { business } from '@/data/business';

interface Props {
  property: PropertyItem;
}

const { property } = Astro.props;
---

<article class="property-card v4-card" data-id={property.id} data-area={property.area} data-type={property.type} data-size={property.sizeMarla}>
  <!-- Card Image Container -->
  <div class="card-media">
    <img
      src={property.image}
      alt={property.title}
      loading="lazy"
      class="card-img"
    />
    <div class="card-badges">
      <span class="badge-tag">{property.badge}</span>
      {property.verified && (
        <span class="badge-verified">
          <i class="fa-solid fa-circle-check"></i> Verified
        </span>
      )}
    </div>
    <!-- Compare Checkbox -->
    <label class="compare-toggle-label" title="Select to compare">
      <input type="checkbox" class="compare-checkbox" data-property-id={property.id} onchange="window.togglePropertyCompare(this);" />
      <span>Compare</span>
    </label>
  </div>

  <!-- Card Body -->
  <div class="card-body">
    <div class="card-location">
      <i class="fa-solid fa-location-dot highlight-gold"></i>
      <span class="blurred-address-text" title="Exact Address Confidential for Owner Privacy">{property.locationLabel}</span>
      <span class="confidential-badge" title="Exact street address protected. Available on direct inquiry.">
        <i class="fa-solid fa-lock"></i> Protected
      </span>
    </div>

    <h3 class="card-title">{property.title}</h3>

    <!-- Specs Pill Row -->
    <div class="card-specs">
      <div class="spec-item">
        <i class="fa-solid fa-ruler-combined highlight-teal"></i>
        <span>{property.sizeLabel}</span>
      </div>
      {property.bedrooms !== null && (
        <div class="spec-item">
          <i class="fa-solid fa-bed highlight-teal"></i>
          <span>{property.bedrooms} Beds</span>
        </div>
      )}
      {property.bathrooms !== null && (
        <div class="spec-item">
          <i class="fa-solid fa-bath highlight-teal"></i>
          <span>{property.bathrooms} Baths</span>
        </div>
      )}
      {property.garage && (
        <div class="spec-item">
          <i class="fa-solid fa-car highlight-teal"></i>
          <span>{property.garage}</span>
        </div>
      )}
    </div>

    <p class="card-desc">
      {property.description}
    </p>

    <!-- Facilities tags -->
    <div class="facilities-tags">
      {property.facilities.slice(0, 3).map(f => (
        <span class="facility-pill">{f}</span>
      ))}
      {property.facilities.length > 3 && (
        <span class="facility-pill more">+{property.facilities.length - 3} more</span>
      )}
    </div>

    <!-- Card Actions Footer -->
    <div class="card-footer">
      <a href={`tel:${business.phone}`} class="btn-primary card-action-btn">
        <i class="fa-solid fa-phone"></i>
        <span>Call Naeem</span>
      </a>
      <a
        href={`https://wa.me/923063996764?text=${encodeURIComponent(`Hello Naeem Siddhu, I am inquiring about: ${property.title} in ${property.locationLabel}`)}`}
        target="_blank"
        rel="noopener"
        class="btn-whatsapp card-action-btn"
      >
        <i class="fa-brands fa-whatsapp"></i>
        <span>WhatsApp</span>
      </a>
    </div>
  </div>
</article>

<style>
  .property-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
    background: #FFFFFF;
    border: 1px solid var(--border-card);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    transition: var(--transition);
  }

  .property-card:hover {
    border-color: rgba(63, 107, 91, 0.4);
    box-shadow: 0 16px 32px -4px rgba(41, 71, 61, 0.1);
    transform: translateY(-4px);
  }

  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: #1F362E;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
  }

  .property-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-badges {
    position: absolute;
    top: 14px;
    left: 14px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    z-index: 2;
  }

  .badge-tag {
    background: rgba(41, 71, 61, 0.88);
    border: 1px solid rgba(200, 169, 107, 0.35);
    color: #FFFFFF;
    font-size: 0.76rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    backdrop-filter: blur(8px);
  }

  .badge-verified {
    background: var(--color-matte-green);
    color: #FFFFFF;
    font-size: 0.74rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: 5px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }

  .compare-toggle-label {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(41, 71, 61, 0.88);
    border: 1px solid rgba(200, 169, 107, 0.35);
    color: #FFFFFF;
    font-size: 0.78rem;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: var(--transition);
    z-index: 2;
  }

  .compare-toggle-label:hover {
    color: var(--color-gold);
    border-color: var(--color-gold);
  }

  .compare-checkbox {
    cursor: pointer;
    accent-color: var(--color-gold);
  }

  .card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 14px;
    background: #FFFFFF;
  }

  .card-location {
    font-size: 0.82rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.5px;
    font-weight: 500;
  }

  .blurred-address-text {
    filter: blur(4.5px);
    user-select: none;
    -webkit-user-select: none;
    opacity: 0.82;
    cursor: default;
    transition: filter 0.3s ease, opacity 0.3s ease;
  }

  .property-card:hover .blurred-address-text {
    filter: blur(2.5px);
    opacity: 0.95;
  }

  .confidential-badge {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 3px 8px;
    border-radius: 9999px;
    background: rgba(200, 169, 107, 0.12);
    color: var(--color-gold-hover);
    border: 1px solid rgba(200, 169, 107, 0.3);
    flex-shrink: 0;
  }

  .card-title {
    font-size: 1.35rem;
    line-height: 1.3;
    color: var(--text-primary);
    font-weight: 700;
  }

  .card-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding: 12px 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .spec-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .spec-item i {
    color: var(--color-matte-green);
  }

  .card-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
    flex-grow: 1;
  }

  .facilities-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .facility-pill {
    background: #F3F5F4;
    border: 1px solid #E6EAE8;
    color: var(--text-secondary);
    font-size: 0.75rem;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    font-weight: 500;
  }

  .facility-pill.more {
    color: var(--color-gold-hover);
    font-weight: 600;
  }

  .card-footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 6px;
  }

  .card-action-btn {
    padding: 10px 14px;
    font-size: 0.85rem;
  }

  @media (max-width: 400px) {
    .card-footer {
      gap: 8px;
    }
    .card-action-btn {
      padding: 10px 6px;
      font-size: 0.8rem;
      gap: 6px;
    }
  }
</style>
