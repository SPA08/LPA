---
import { properties } from '@/data/properties';
---

<div id="compareBar" class="compare-floating-bar" style="display: none;">
  <div class="container compare-bar-inner">
    <div class="compare-info">
      <span class="compare-count"><strong id="compareCount">0</strong> / 3 Properties Selected</span>
      <span class="compare-hint">Select up to 3 properties to compare side-by-side</span>
    </div>

    <div class="compare-actions">
      <button class="btn-primary" onclick="window.openComparisonModal();">
        <i class="fa-solid fa-code-compare"></i> Compare Now
      </button>
      <button class="btn-outline" onclick="window.clearComparison();">
        <i class="fa-solid fa-xmark"></i> Clear
      </button>
    </div>
  </div>
</div>

<!-- Comparison Modal -->
<div id="compareModal" class="compare-modal" aria-hidden="true" style="display: none;">
  <div class="modal-backdrop" onclick="window.closeComparisonModal();"></div>
  <div class="modal-content glass-panel">
    <div class="modal-header">
      <div class="modal-title-wrap">
        <span class="section-badge"><i class="fa-solid fa-code-compare"></i> PROPERTY COMPARISON</span>
        <h3 class="modal-title">Side-by-Side Property Comparison</h3>
      </div>
      <button class="modal-close-btn" onclick="window.closeComparisonModal();" aria-label="Close modal">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="comparison-table-wrapper" id="comparisonTableWrapper">
      <!-- Populated dynamically via JS -->
    </div>

    <div class="modal-footer">
      <button class="btn-outline" onclick="window.copyComparisonSummary();">
        <i class="fa-solid fa-copy highlight-gold"></i> Copy Comparison Summary
      </button>
      <a href="tel:+923063996764" class="btn-whatsapp">
        <i class="fa-solid fa-phone"></i> Discuss Comparison with Naeem
      </a>
    </div>
  </div>
</div>

<script is:inline define:vars={{ allProperties: properties }}>
  window.COMPARE_PROPERTIES_DATA = allProperties;
  let selectedPropertyIds = [];

  window.togglePropertyCompare = function(checkbox) {
    const id = checkbox.getAttribute('data-property-id');
    if (checkbox.checked) {
      if (selectedPropertyIds.length >= 3) {
        checkbox.checked = false;
        alert("You can compare up to 3 properties at a time.");
        return;
      }
      if (!selectedPropertyIds.includes(id)) selectedPropertyIds.push(id);
    } else {
      selectedPropertyIds = selectedPropertyIds.filter(p => p !== id);
    }
    updateCompareBar();
  };

  function updateCompareBar() {
    const bar = document.getElementById('compareBar');
    const countEl = document.getElementById('compareCount');
    if (!bar || !countEl) return;

    countEl.textContent = selectedPropertyIds.length;
    if (selectedPropertyIds.length > 0) {
      bar.style.display = 'block';
    } else {
      bar.style.display = 'none';
    }
  }

  window.clearComparison = function() {
    selectedPropertyIds = [];
    document.querySelectorAll('.compare-checkbox').forEach(cb => { cb.checked = false; });
    updateCompareBar();
  };

  window.openComparisonModal = function() {
    const modal = document.getElementById('compareModal');
    const tableWrap = document.getElementById('comparisonTableWrapper');
    if (!modal || !tableWrap) return;

    const matched = window.COMPARE_PROPERTIES_DATA.filter(p => selectedPropertyIds.includes(p.id));
    if (matched.length === 0) {
      alert("Please select at least one property to compare.");
      return;
    }

    let html = `
      <table class="v4-compare-table">
        <thead>
          <tr>
            <th class="spec-col">Feature</th>
            ${matched.map(p => `
              <th>
                <div class="table-prop-header">
                  <img src="${p.image}" alt="${p.title}" class="table-prop-thumb" />
                  <h4>${p.title}</h4>
                  <span class="badge-tag">${p.badge}</span>
                </div>
              </th>
            `).join('')}
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="spec-label">Location</td>
            ${matched.map(p => `<td><span class="blurred-compare-address" title="Exact address confidential for owner privacy">${p.locationLabel}</span> <span class="confidential-lock-tag"><i class="fa-solid fa-lock"></i> Protected</span></td>`).join('')}
          </tr>
          <tr>
            <td class="spec-label">Property Type</td>
            ${matched.map(p => `<td>${p.type === 'residential' ? 'Residential House' : p.type}</td>`).join('')}
          </tr>
          <tr>
            <td class="spec-label">Plot / Land Size</td>
            ${matched.map(p => `<td><span class="highlight-gold font-bold">${p.sizeLabel}</span></td>`).join('')}
          </tr>
          <tr>
            <td class="spec-label">Bedrooms / Baths</td>
            ${matched.map(p => `<td>${p.bedrooms ? `${p.bedrooms} Beds, ${p.bathrooms || 0} Baths` : 'Not provided'}</td>`).join('')}
          </tr>
          <tr>
            <td class="spec-label">Car Porch / Garage</td>
            ${matched.map(p => `<td>${p.garage || 'Not provided'}</td>`).join('')}
          </tr>
          <tr>
            <td class="spec-label">Documented Facilities</td>
            ${matched.map(p => `
              <td>
                <ul class="compare-facilities-list">
                  ${p.facilities.map(f => `<li><i class="fa-solid fa-check highlight-teal"></i> ${f}</li>`).join('')}
                </ul>
              </td>
            `).join('')}
          </tr>
          <tr>
            <td class="spec-label">Current Status</td>
            ${matched.map(p => `<td><span class="badge-status">${p.status}</span></td>`).join('')}
          </tr>
          <tr>
            <td class="spec-label">Site Visit / Action</td>
            ${matched.map(p => `
              <td>
                <a href="tel:+923063996764" class="btn-primary" style="padding: 8px 14px; font-size: 0.8rem; width: 100%; justify-content: center;">
                  <i class="fa-solid fa-phone"></i> Inquire
                </a>
              </td>
            `).join('')}
          </tr>
        </tbody>
      </table>
    `;

    tableWrap.innerHTML = html;
    modal.style.display = 'flex';
  };

  window.closeComparisonModal = function() {
    const modal = document.getElementById('compareModal');
    if (modal) modal.style.display = 'none';
  };

  window.copyComparisonSummary = function() {
    const matched = window.COMPARE_PROPERTIES_DATA.filter(p => selectedPropertyIds.includes(p.id));
    if (matched.length === 0) return;

    let text = `SIDDHU PROPERTY ADVISOR — Property Comparison Summary\nAdvisor: Naeem Siddhu (0306 3996764)\n\n`;
    matched.forEach((p, idx) => {
      text += `[Property ${idx + 1}]: ${p.title}\n`;
      text += `Location: ${p.locationLabel}\n`;
      text += `Size: ${p.sizeLabel}\n`;
      text += `Bedrooms: ${p.bedrooms || 'Not provided'}\n`;
      text += `Status: ${p.status}\n`;
      text += `Facilities: ${p.facilities.join(', ')}\n\n`;
    });

    navigator.clipboard.writeText(text).then(() => {
      alert("Comparison summary copied to clipboard! You can paste and share it on WhatsApp.");
    }).catch(() => {
      alert("Could not access clipboard.");
    });
  };
</script>

<style>
  .compare-floating-bar {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 900;
    width: 90%;
    max-width: 800px;
    background: rgba(20, 34, 48, 0.95);
    border: 1px solid var(--accent-gold);
    box-shadow: var(--shadow-elevated), 0 0 20px rgba(184, 138, 59, 0.3);
    border-radius: var(--radius-card);
    backdrop-filter: blur(12px);
    padding: 14px 24px;
    animation: slideUp 0.3s ease;
  }

  @keyframes slideUp {
    from { transform: translateX(-50%) translateY(30px); opacity: 0; }
    to { transform: translateX(-50%) translateY(0); opacity: 1; }
  }

  .compare-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .compare-info {
    display: flex;
    flex-direction: column;
  }

  .compare-count {
    color: var(--accent-gold-light);
    font-size: 0.95rem;
  }

  .compare-hint {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .compare-actions {
    display: flex;
    gap: 10px;
  }

  /* Modal */
  .compare-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(6px);
  }

  .modal-content {
    position: relative;
    z-index: 2;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-card);
    max-width: 980px;
    width: 100%;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-elevated);
    overflow: hidden;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .modal-title {
    font-size: 1.4rem;
  }

  .modal-close-btn {
    background: transparent;
    border: 1px solid var(--border-glass);
    color: var(--text-secondary);
    width: 36px;
    height: 36px;
    border-radius: var(--radius-control);
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
  }

  .modal-close-btn:hover {
    color: #fff;
    border-color: var(--accent-gold);
  }

  .comparison-table-wrapper {
    padding: 24px;
    overflow-x: auto;
    max-height: 60vh;
  }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    padding: 16px 24px;
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
  }

  /* Table */
  :global(.v4-compare-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  :global(.v4-compare-table th), :global(.v4-compare-table td) {
    padding: 14px 18px;
    border: 1px solid var(--border-subtle);
    text-align: left;
    vertical-align: top;
  }

  :global(.v4-compare-table th) {
    background: var(--bg-secondary);
    color: var(--text-primary);
  }

  :global(.table-prop-header) {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.table-prop-thumb) {
    width: 100%;
    height: 120px;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  :global(.spec-label) {
    font-weight: 600;
    color: var(--text-secondary);
    width: 180px;
    background: rgba(255, 255, 255, 0.02);
  }

  :global(.compare-facilities-list) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.84rem;
  }

  :global(.badge-status) {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(90, 148, 141, 0.2);
    color: var(--accent-teal-light);
    font-weight: 600;
    font-size: 0.78rem;
  }

  :global(.blurred-compare-address) {
    filter: blur(4px);
    user-select: none;
    -webkit-user-select: none;
    opacity: 0.85;
    display: inline-block;
  }

  :global(.confidential-lock-tag) {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 9999px;
    background: rgba(184, 138, 59, 0.12);
    color: #B88A3B;
    border: 1px solid rgba(184, 138, 59, 0.25);
    margin-left: 4px;
    vertical-align: middle;
  }

  @media (max-width: 640px) {
    .compare-floating-bar {
      width: calc(100% - 24px);
      bottom: 16px;
      padding: 12px 16px;
    }
    .compare-bar-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
      text-align: center;
    }
    .compare-actions {
      display: grid;
      grid-template-columns: 1fr auto;
    }
    .compare-modal {
      padding: 10px;
    }
    .modal-content {
      max-height: 94vh;
    }
    .modal-header {
      padding: 14px 18px;
    }
    .modal-title {
      font-size: 1.15rem;
    }
    .comparison-table-wrapper {
      padding: 14px;
    }
    .modal-footer {
      flex-direction: column;
      gap: 10px;
      padding: 14px 18px;
    }
    .modal-footer button, .modal-footer a {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }
</style>
