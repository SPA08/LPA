---
import Header from '@/components/global/Header.astro';
import Footer from '@/components/global/Footer.astro';
import { business } from '@/data/business';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  includeMap?: boolean;
}

const {
  title = "Siddhu Property Advisor | Chichawatni Real Estate & Property Advisory",
  description = "Looking for verified real estate in Chichawatni? SIDDHU Property Advisor, led by Naeem Siddhu, provides local property guidance, verified family homes, and PLRA land record assistance.",
  canonical = Astro.url.href,
  image = "https://siddhupropertyadvisor.com/assets/images/siddhu-logo-new.jpg",
  includeMap = false,
} = Astro.props;

const currentPath = Astro.url.pathname;

const schemaData = {
  "@context": "https://schema.org",
  "@type": ["RealEstateAgent", "LocalBusiness"],
  "name": business.name,
  "alternateName": [
    "Naeem Siddhu Property Advisor",
    "#1 Property Advisor in Chichawatni",
    "Top 1 Real Estate Consultant Chichawatni",
    "SIDDHU OS Real Estate Portal"
  ],
  "image": "https://siddhupropertyadvisor.com/assets/images/siddhu-logo-new.jpg",
  "description": description,
  "telephone": business.phone,
  "url": business.website,
  "priceRange": "PKR 2,000,000 - 50,000,000",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": business.address.street,
    "addressLocality": business.address.city,
    "addressRegion": business.address.province,
    "postalCode": business.address.postalCode,
    "addressCountry": "PK"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": business.coordinates.lat,
    "longitude": business.coordinates.lng
  },
  "areaServed": [
    { "@type": "Place", "name": "Chichawatni" },
    { "@type": "Place", "name": "Hayat Abad Chichawatni" },
    { "@type": "Place", "name": "Model Town Chichawatni" },
    { "@type": "Place", "name": "Housing Colony Chichawatni" },
    { "@type": "Place", "name": "Civil Lines Chichawatni" },
    { "@type": "Place", "name": "GT Road Chichawatni" },
    { "@type": "Place", "name": "Farid Town Sahiwal" },
    { "@type": "Place", "name": "Tariq Bin Ziyad Colony Sahiwal" },
    { "@type": "Place", "name": "Royal Orchard Sahiwal" },
    { "@type": "City", "name": "Sahiwal" },
    { "@type": "AdministrativeArea", "name": "Sahiwal Division" }
  ],
  "knowsAbout": [
    "Best Buy Property in Chichawatni",
    "Best Sale Deals in Chichawatni",
    "Residential Houses for Sale",
    "Arazi Record Center PLRA Verification",
    "Commercial Plazas on Burewala & GT Road",
    "Overseas Pakistani Property Investment"
  ],
  "founder": {
    "@type": "Person",
    "name": business.advisor,
    "jobTitle": business.role
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph / Social Meta -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content={business.name} />

  <!-- Twitter Meta -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Favicon -->
  <link rel="icon" type="image/jpeg" href="/assets/images/siddhu-logo-new.jpg" />

  <!-- Preconnect & Asynchronous Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" />
  <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" /></noscript>

  {includeMap && (
    <>
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" crossorigin="" media="print" onload="this.media='all'" />
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/MarkerCluster.css" crossorigin="" media="print" onload="this.media='all'" />
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/MarkerCluster.Default.css" crossorigin="" media="print" onload="this.media='all'" />
      <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js" crossorigin=""></script>
      <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/leaflet.markercluster.js" crossorigin=""></script>
    </>
  )}

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
</head>
<body>
  <Header currentPath={currentPath} />

  <main id="main-content" style="padding-top: 80px;">
    <slot />
  </main>

  <Footer />
</body>
</html>
