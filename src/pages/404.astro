---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { business } from '@/data/business';
---

<BaseLayout
  title="404 — Page Not Found | SIDDHU Property Advisor"
  description="The requested page could not be found. Explore verified residential properties and local property guides in Chichawatni."
>
  <div class="container not-found-page">
    <div class="not-found-card">
      <div class="error-badge highlight-gold">404 ERROR</div>
      <h1 class="error-title">Page Not Found</h1>
      <p class="error-text">
        The real estate listing or guide you are looking for may have been updated, relocated, or is temporarily unavailable.
      </p>

      <div class="quick-links">
        <a href="/" class="btn-primary">
          <i class="fa-solid fa-house"></i>
          <span>Return Home</span>
        </a>
        <a href="/#properties" class="btn-secondary">
          <i class="fa-solid fa-building"></i>
          <span>Browse Properties</span>
        </a>
        <a href={`tel:${business.phone}`} class="btn-secondary">
          <i class="fa-solid fa-phone"></i>
          <span>Contact Advisor</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-page {
    padding: 6rem 1rem 8rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .not-found-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 4rem 2.5rem;
    text-align: center;
    max-width: 600px;
    width: 100%;
  }
  .error-badge {
    font-size: 3.5rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }
  .error-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 1rem;
  }
  .error-text {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 2.5rem;
  }
  .quick-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
