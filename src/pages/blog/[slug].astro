---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { blogPosts, type BlogPostItem } from '@/data/blogs';
import { parseSimpleMarkdown } from '@/utils/markdown';
import { business } from '@/data/business';

export async function getStaticPaths() {
  const postsDir = path.resolve(process.cwd(), 'posts');

  return blogPosts.map(post => {
    let content = '';
    const filePath = path.join(postsDir, `${post.slug}.md`);
    if (fs.existsSync(filePath)) {
      content = fs.readFileSync(filePath, 'utf-8');
    }
    const htmlContent = parseSimpleMarkdown(content);

    return {
      params: { slug: post.slug },
      props: { post, htmlContent }
    };
  });
}

interface Props {
  post: BlogPostItem;
  htmlContent: string;
}

const { post, htmlContent } = Astro.props;
const relatedPosts = blogPosts.filter(p => p.slug !== post.slug && p.category === post.category).slice(0, 3);
---

<BaseLayout title={`${post.title} | SIDDHU Property Advisor`} description={post.excerpt} image={post.thumbnail}>
  <article class="article-page">
    <div class="container article-container">
      <!-- Breadcrumb -->
      <nav class="article-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <i class="fa-solid fa-chevron-right"></i>
        <a href="/blog/index.html">Property Blog</a>
        <i class="fa-solid fa-chevron-right"></i>
        <span>{post.category}</span>
      </nav>

      <!-- Article Header -->
      <header class="article-header">
        <span class="section-badge"><i class="fa-solid fa-tag highlight-gold"></i> {post.category}</span>
        <h1 class="article-main-title">{post.title}</h1>
        <div class="article-meta-bar">
          <div class="author-info">
            <img src="/assets/images/ceo-naseem-siddhu.jpg" alt={post.author} class="author-thumb" />
            <div>
              <strong>{post.author}</strong>
              <span>Verified Real Estate Advisor</span>
            </div>
          </div>
          <div class="article-timing">
            <span><i class="fa-solid fa-calendar highlight-gold"></i> {post.date}</span>
            <span><i class="fa-solid fa-clock highlight-teal"></i> {post.readTime}</span>
          </div>
        </div>
      </header>

      <!-- Featured Image -->
      <div class="article-hero-media glass-panel">
        <img src={post.thumbnail} alt={post.title} class="article-hero-img" />
      </div>

      <!-- Main Article Prose -->
      <div class="article-content-body" set:html={htmlContent} />

      <!-- Author Box & Direct Consultation -->
      <div class="article-author-box glass-panel">
        <div class="author-box-grid">
          <img src="/assets/images/ceo-naseem-siddhu.jpg" alt="Naeem Siddhu" class="author-box-img" />
          <div class="author-box-text">
            <span class="section-badge" style="margin-bottom: 6px;">LOCAL PROPERTY SPECIALIST</span>
            <h3>Need Local Advice on this Topic?</h3>
            <p>
              <strong>{business.advisor}</strong> is available for direct consultation regarding land registry verification, residential purchases, and construction budgeting in Chichawatni.
            </p>
            <div class="author-box-actions">
              <a href={`tel:${business.phone}`} class="btn-primary">
                <i class="fa-solid fa-phone"></i> Call {business.phoneFormatted}
              </a>
              <a href={business.whatsappUrl} target="_blank" rel="noopener" class="btn-whatsapp">
                <i class="fa-brands fa-whatsapp"></i> <span>WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Related Articles -->
      {relatedPosts.length > 0 && (
        <div class="related-articles-section">
          <h3 class="related-heading">Related Articles in {post.category}</h3>
          <div class="related-grid">
            {relatedPosts.map(rp => (
              <a href={`/blog/${rp.slug}.html`} class="related-card v4-card">
                <img src={rp.thumbnail} alt={rp.title} class="related-thumb" />
                <div class="related-card-body">
                  <span class="related-badge">{rp.category}</span>
                  <h4>{rp.title}</h4>
                  <span class="related-read">{rp.readTime}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .article-page {
    padding: 30px 0 90px;
    background: var(--bg-main);
  }

  .article-container {
    max-width: 860px;
  }

  .article-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .article-breadcrumb a:hover {
    color: var(--accent-gold-light);
  }

  .article-breadcrumb i {
    font-size: 0.65rem;
  }

  .article-header {
    margin-bottom: 30px;
  }

  .article-main-title {
    font-size: clamp(2rem, 3.8vw, 3rem);
    margin: 14px 0 20px;
    line-height: 1.25;
  }

  .article-meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    flex-wrap: wrap;
    gap: 16px;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .author-thumb {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--accent-gold);
  }

  .author-info div {
    display: flex;
    flex-direction: column;
    font-size: 0.85rem;
  }

  .author-info strong {
    color: var(--text-primary);
  }

  .author-info span {
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .article-timing {
    display: flex;
    gap: 14px;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .article-hero-media {
    width: 100%;
    height: 380px;
    overflow: hidden;
    margin-bottom: 40px;
    border: 1px solid var(--border-glass);
  }

  .article-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Article Content Body */
  :global(.article-content-body) {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  :global(.article-content-body p) {
    margin-bottom: 20px;
    font-size: 1.05rem;
  }

  :global(.article-content-body h2) {
    font-size: 1.85rem;
    margin: 40px 0 16px;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 10px;
  }

  :global(.article-content-body h3) {
    font-size: 1.4rem;
    margin: 28px 0 12px;
    color: var(--text-primary);
  }

  :global(.article-content-body strong) {
    color: var(--text-primary);
  }

  :global(.article-ul), :global(.article-ol) {
    margin: 0 0 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.article-li), :global(.article-oli) {
    line-height: 1.6;
  }

  :global(.article-blockquote) {
    border-left: 3px solid var(--accent-gold);
    padding: 16px 20px;
    background: rgba(184, 138, 59, 0.08);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin: 28px 0;
    font-style: italic;
    color: var(--accent-gold-light);
  }

  :global(.article-table-wrapper) {
    overflow-x: auto;
    margin: 30px 0;
  }

  :global(.article-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  :global(.article-table th), :global(.article-table td) {
    padding: 12px 16px;
    border: 1px solid var(--border-subtle);
    text-align: left;
  }

  :global(.article-table th) {
    background: var(--bg-card);
    color: var(--text-primary);
  }

  :global(.article-divider) {
    border: none;
    height: 1px;
    background: var(--border-subtle);
    margin: 40px 0;
  }

  /* Author Box */
  .article-author-box {
    margin-top: 50px;
    padding: 32px;
    border: 1px solid var(--border-card);
  }

  .author-box-grid {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 28px;
    align-items: center;
  }

  .author-box-img {
    width: 140px;
    height: 170px;
    object-fit: cover;
    border-radius: var(--radius-control);
    border: 2px solid var(--accent-gold);
  }

  .author-box-text h3 {
    font-size: 1.4rem;
    margin-bottom: 8px;
  }

  .author-box-text p {
    font-size: 0.92rem;
    margin-bottom: 18px;
    color: var(--text-secondary);
  }

  .author-box-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Related */
  .related-articles-section {
    margin-top: 60px;
  }

  .related-heading {
    font-size: 1.4rem;
    margin-bottom: 24px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .related-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .related-thumb {
    width: 100%;
    height: 130px;
    object-fit: cover;
  }

  .related-card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }

  .related-badge {
    font-size: 0.7rem;
    color: var(--accent-gold);
    font-weight: 600;
  }

  .related-card-body h4 {
    font-size: 0.95rem;
    line-height: 1.35;
    flex-grow: 1;
  }

  .related-read {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .author-box-grid {
      grid-template-columns: 1fr;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
