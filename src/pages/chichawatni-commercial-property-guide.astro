---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/global/Breadcrumbs.astro';
import { business } from '@/data/business';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'City & Guides', url: '/chichawatni-city-guide.html' },
  { name: 'Commercial Property', url: '/chichawatni-commercial-property-guide.html' }
];
---

<BaseLayout
  title="Chichawatni Commercial Property & Investment Guide | SIDDHU Property Advisor"
  description="Shops, commercial plazas, main road frontages, rental yields, and high-ROI business property investments across Tower Road, GT Road Bypass, and Ghalla Mandi Chichawatni."
  canonical="https://siddhupropertyadvisor.com/chichawatni-commercial-property-guide.html"
>
  <div class="container guide-page">
    <Breadcrumbs items={breadcrumbs} />

    <header class="guide-header-card">
      <div class="guide-badge">
        <i class="fa-solid fa-building-user"></i>
        <span>Commercial Real Estate Insights</span>
      </div>
      <h1 class="guide-title">Chichawatni Commercial Property & Investment Guide</h1>
      <p class="guide-subtitle">
        Shops, commercial plazas, main road frontages, rental yields, and high-ROI business property investments across Tower Road, Railway Road, GT Road Bypass, and Ghalla Mandi.
      </p>

      <div class="hubs-grid">
        <div class="hub-card">
          <i class="fa-solid fa-store highlight-gold"></i>
          <h3 class="hub-title">Tower Road Financial Hub</h3>
          <p class="hub-desc">High footfall commercial avenue housing top commercial banks, corporate offices, mobile markets, and luxury retail shops. Home to Siddhu Property Advisor office.</p>
        </div>
        <div class="hub-card">
          <i class="fa-solid fa-wheat-awn highlight-teal"></i>
          <h3 class="hub-title">Ghalla Mandi Commodity Exchange</h3>
          <p class="hub-desc">One of Punjab's busiest agricultural trading markets. Prime commercial shops and godowns with steady commercial lease income from grain and cotton merchants.</p>
        </div>
        <div class="hub-card">
          <i class="fa-solid fa-road highlight-gold"></i>
          <h3 class="hub-title">GT Road Bypass Belt</h3>
          <p class="hub-desc">Ideal for fuel stations, marriage halls, hotel plazas, warehouses, automobile showrooms, and large-scale commercial plots along National Highway N-5.</p>
        </div>
        <div class="hub-card">
          <i class="fa-solid fa-shop highlight-teal"></i>
          <h3 class="hub-title">Railway Road & Circular Market</h3>
          <p class="hub-desc">Traditional retail shopping hub for gold jewelry, fashion, footwear, electronics, and general consumer goods with high daily customer density.</p>
        </div>
      </div>
    </header>

    <!-- Opportunities Grid -->
    <section class="content-section">
      <h2 class="section-heading">Commercial Investment Opportunities</h2>
      <div class="opportunities-grid">
        <div class="opportunity-card">
          <h3 class="opportunity-title highlight-gold">Commercial Frontage Plots</h3>
          <p class="opportunity-desc">2 Marla, 4 Marla & 8 Marla commercial plots suitable for multi-story plaza development on major avenues.</p>
        </div>
        <div class="opportunity-card">
          <h3 class="opportunity-title highlight-teal">Ready Rented Shops</h3>
          <p class="opportunity-desc">Pre-leased retail shops generating immediate monthly rental yield for passive investors.</p>
        </div>
        <div class="opportunity-card">
          <h3 class="opportunity-title highlight-gold">Plaza Floors & Offices</h3>
          <p class="opportunity-desc">First & second floor corporate office spaces for clinics, IT firms, and professional agencies.</p>
        </div>
      </div>
    </section>

    <!-- CTA Banner -->
    <section class="guide-cta-banner">
      <h3 class="cta-title">Interested in Commercial Property Investment?</h3>
      <p class="cta-subtitle">Consult directly with Naeem Siddhu for verified high-ROI shops, plots, and plaza opportunities in Chichawatni.</p>
      <div class="cta-actions">
        <a href={`tel:${business.phone}`} class="btn-primary">
          <i class="fa-solid fa-phone"></i>
          <span>Call Naeem Siddhu</span>
        </a>
        <a href={`https://wa.me/${business.phone.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener" class="btn-whatsapp">
          <i class="fa-brands fa-whatsapp"></i>
          <span>WhatsApp</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .guide-page {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }
  .guide-header-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 2.75rem 2rem;
    margin-bottom: 2rem;
    text-align: center;
  }
  .guide-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(184, 138, 59, 0.15);
    border: 1px solid rgba(184, 138, 59, 0.3);
    color: var(--accent-gold);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .guide-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }
  .guide-subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 780px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }
  .hubs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
    text-align: left;
  }
  .hub-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-control);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .hub-card i {
    font-size: 1.75rem;
    margin-bottom: 0.25rem;
  }
  .hub-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }
  .hub-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }
  .content-section {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 2.25rem;
    margin-bottom: 2rem;
  }
  .section-heading {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1.5rem;
  }
  .opportunities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .opportunity-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-control);
    padding: 1.5rem;
  }
  .opportunity-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
  }
  .opportunity-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
  }
  .guide-cta-banner {
    background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-elevated) 100%);
    border: 1px solid rgba(184, 138, 59, 0.3);
    border-radius: var(--radius-card);
    padding: 3rem 2rem;
    text-align: center;
  }
  .cta-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
  }
  .cta-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 650px;
    margin: 0 auto 1.75rem;
  }
  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
