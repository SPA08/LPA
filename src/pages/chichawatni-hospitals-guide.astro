---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/global/Breadcrumbs.astro';
import { business } from '@/data/business';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'City & Guides', url: '/chichawatni-city-guide.html' },
  { name: 'Hospitals & Clinics', url: '/chichawatni-hospitals-guide.html' }
];
---

<BaseLayout
  title="Hospitals & Healthcare in Chichawatni | Emergency Facilities Guide"
  description="Verified guide to primary hospitals, government health facilities, THQ Hospital Chichawatni, private medical complexes, and emergency response access."
  canonical="https://siddhupropertyadvisor.com/chichawatni-hospitals-guide.html"
>
  <div class="container guide-page">
    <Breadcrumbs items={breadcrumbs} />

    <header class="guide-header-card">
      <div class="guide-badge">
        <i class="fa-solid fa-hospital-user"></i>
        <span>Healthcare & Emergency Directory</span>
      </div>
      <h1 class="guide-title">Hospitals & Healthcare in Chichawatni</h1>
      <p class="guide-subtitle">
        Verified guide to primary hospitals, government health facilities, private medical complexes, and emergency response access across Chichawatni.
      </p>
    </header>

    <!-- Hospitals Grid -->
    <section class="content-section">
      <h2 class="section-heading">Key Medical Centers & Facilities</h2>
      <div class="hospitals-grid">
        <div class="hospital-card">
          <span class="card-badge highlight-teal">Official Government Facility</span>
          <h3 class="hospital-name highlight-gold">THQ Hospital Chichawatni</h3>
          <p class="hospital-desc">
            Tehsil Headquarter Hospital is the flagship government medical institution in Chichawatni, offering 24/7 emergency care, OPD, surgery, pediatric, and maternity services.
          </p>
          <ul class="hospital-list">
            <li><strong>Emergency:</strong> 24/7 Response Center</li>
            <li><strong>Location:</strong> Civil Lines Area, Chichawatni</li>
            <li><strong>Nearby Colonies:</strong> Civil Lines, Model Town, Hayat Abad</li>
          </ul>
        </div>

        <div class="hospital-card">
          <span class="card-badge highlight-teal">Public Health Center</span>
          <h3 class="hospital-name highlight-gold">Civil Hospital & Dispensaries</h3>
          <p class="hospital-desc">
            Government dispensaries and primary outpatient facilities serving urban residential sectors with basic healthcare, vaccination, and diagnostic labs.
          </p>
          <ul class="hospital-list">
            <li><strong>Services:</strong> OPD, Vaccination, Basic Diagnostic</li>
            <li><strong>Location:</strong> Station Road / Municipal Sector</li>
            <li><strong>Nearby Colonies:</strong> Housing Colony, Block 1-4</li>
          </ul>
        </div>

        <div class="hospital-card">
          <span class="card-badge highlight-gold">Private Healthcare</span>
          <h3 class="hospital-name highlight-gold">Private Clinics & Medical Complexes</h3>
          <p class="hospital-desc">
            Private specialist clinics, eye care centers, and diagnostic laboratories concentrated along Tower Road and GT Road access points.
          </p>
          <ul class="hospital-list">
            <li><strong>Specialties:</strong> Cardiology, Gynaecology, Ophthalmology</li>
            <li><strong>Location:</strong> Tower Road Commercial Strip</li>
            <li><strong>Nearby Colonies:</strong> Hayat Abad, Ghaffor Town</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- CTA Banner -->
    <section class="guide-cta-banner">
      <h3 class="cta-title">Buying a Family Residence Near Healthcare Facilities?</h3>
      <p class="cta-subtitle">Naeem Siddhu helps buyers locate quiet family homes within 5–10 minutes drive of THQ Hospital and emergency medical access.</p>
      <div class="cta-actions">
        <a href={`tel:${business.phone}`} class="btn-primary">
          <i class="fa-solid fa-phone"></i>
          <span>Call Naeem Siddhu</span>
        </a>
        <a href={`https://wa.me/${business.phone.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener" class="btn-secondary">
          <i class="fa-brands fa-whatsapp"></i>
          <span>WhatsApp Consultation</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .guide-page {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }
  .guide-header-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 2.75rem 2rem;
    margin-bottom: 2rem;
    text-align: center;
  }
  .guide-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(184, 138, 59, 0.15);
    border: 1px solid rgba(184, 138, 59, 0.3);
    color: var(--accent-gold);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .guide-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }
  .guide-subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 780px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .content-section {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 2.25rem;
    margin-bottom: 2rem;
  }
  .section-heading {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1.5rem;
  }
  .hospitals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .hospital-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-control);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .card-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .hospital-name {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
  }
  .hospital-desc {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0 0 0.5rem;
  }
  .hospital-list {
    list-style: none;
    padding: 0;
    margin: auto 0 0 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }
  .hospital-list li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .hospital-list li:last-child {
    border-bottom: none;
  }
  .guide-cta-banner {
    background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-elevated) 100%);
    border: 1px solid rgba(184, 138, 59, 0.3);
    border-radius: var(--radius-card);
    padding: 3rem 2rem;
    text-align: center;
  }
  .cta-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
  }
  .cta-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 650px;
    margin: 0 auto 1.75rem;
  }
  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
