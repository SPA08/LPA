---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/global/Breadcrumbs.astro';
import { business } from '@/data/business';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'City & Guides', url: '/chichawatni-city-guide.html' },
  { name: 'PLRA & Land Records', url: '/chichawatni-land-records-plra-guide.html' }
];
---

<BaseLayout
  title="Chichawatni PLRA Land Records & Legal Transfer Guide | SIDDHU Property Advisor"
  description="Step-by-step guide to Arazi Record Center (ARC) Chichawatni, computerized Fard Malkiat, Khewat & Khasra verification, Sub-Registrar Registry, and Biometric Intiqal."
  canonical="https://siddhupropertyadvisor.com/chichawatni-land-records-plra-guide.html"
>
  <div class="container guide-page">
    <Breadcrumbs items={breadcrumbs} />

    <header class="guide-header-card">
      <div class="guide-badge">
        <i class="fa-solid fa-file-signature"></i>
        <span>Official Revenue & Land Verification</span>
      </div>
      <h1 class="guide-title">Chichawatni PLRA Land Records & Legal Transfer Guide</h1>
      <p class="guide-subtitle">
        Everything you need to know about Arazi Record Center (ARC) Chichawatni, computerized Fard Malkiat, Khewat & Khatooni verification, Sub-Registrar Registry, and FBR tax status.
      </p>

      <div class="terms-grid">
        <div class="term-card">
          <i class="fa-solid fa-file-contract highlight-gold"></i>
          <h3 class="term-title">Fard Malkiat (فرد ملکیت)</h3>
          <p class="term-desc">The official computerized title deed issued by Punjab Land Records Authority (PLRA) verifying exact land ownership, share size, and mortgaged status.</p>
        </div>
        <div class="term-card">
          <i class="fa-solid fa-fingerprint highlight-teal"></i>
          <h3 class="term-title">Biometric Intiqal (انتقال)</h3>
          <p class="term-desc">Biometric mutation process at Arazi Record Center Chichawatni where buyer and seller verify thumb impressions on the official Punjab land database.</p>
        </div>
        <div class="term-card">
          <i class="fa-solid fa-map-location highlight-gold"></i>
          <h3 class="term-title">Khewat & Khasra (کھیوٹ، خسرہ)</h3>
          <p class="term-desc">Official revenue survey block numbers specifying exact land location within Chak 40/12-L, Chak 39/12-L, or parent revenue estate.</p>
        </div>
        <div class="term-card">
          <i class="fa-solid fa-stamp highlight-teal"></i>
          <h3 class="term-title">E-Stamp & Sale Deed</h3>
          <p class="term-desc">Judicial stamp paper generated online via Punjab e-Stamping portal, executed at Sub-Registrar Tehsil Chichawatni office.</p>
        </div>
      </div>
    </header>

    <!-- ARC Center Info Card -->
    <section class="content-section">
      <h2 class="section-heading">Arazi Record Center (ARC) Chichawatni Information</h2>
      <div class="arc-info-grid">
        <div class="info-box">
          <span class="info-label">ARC Center Location</span>
          <span class="info-val">Near Judicial Complex / Bypass Road</span>
        </div>
        <div class="info-box">
          <span class="info-label">Tehsil Revenue Authority</span>
          <span class="info-val">Sub-Registrar Tehsil Chichawatni</span>
        </div>
        <div class="info-box">
          <span class="info-label">Official Portal Link</span>
          <span class="info-val highlight-gold">punjab-zameen.gov.pk</span>
        </div>
      </div>
    </section>

    <!-- Step by Step Transfer Process -->
    <section class="content-section">
      <h2 class="section-heading">5-Step Legal Property Transfer Procedure</h2>
      <div class="steps-flow">
        <div class="flow-step">
          <div class="step-num">1</div>
          <div class="step-content">
            <h3 class="step-title">Fard Baraye Bae (فرد برائے بیع) Issuance</h3>
            <p class="step-text">Seller visits Arazi Record Center Chichawatni to obtain computerized Fard for sale purposes. The revenue officer locks the record to prevent dual sales.</p>
          </div>
        </div>
        <div class="flow-step">
          <div class="step-num">2</div>
          <div class="step-content">
            <h3 class="step-title">Punjab e-Stamp Generation</h3>
            <p class="step-text">Calculated via official FBR and DC valuation tables. Generated from National Bank or Bank of Punjab Chichawatni branches.</p>
          </div>
        </div>
        <div class="flow-step">
          <div class="step-num">3</div>
          <div class="step-content">
            <h3 class="step-title">Sale Deed Draft (Baye Nama)</h3>
            <p class="step-text">Prepared with exact property boundaries, square footage, agreed price, and witnesses by licensed document writers.</p>
          </div>
        </div>
        <div class="flow-step">
          <div class="step-num">4</div>
          <div class="step-content">
            <h3 class="step-title">Sub-Registrar Execution</h3>
            <p class="step-text">Buyer and seller appear before the Sub-Registrar Chichawatni with official CNICs and photos for legal deed endorsement.</p>
          </div>
        </div>
        <div class="flow-step">
          <div class="step-num">5</div>
          <div class="step-content">
            <h3 class="step-title">Biometric Intiqal (Mutation)</h3>
            <p class="step-text">Deed is submitted back to PLRA Arazi Record Center for computerized biometric mutation, transferring title permanently in government records.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Banner -->
    <section class="guide-cta-banner">
      <h3 class="cta-title">Need Land Record Verification Assistance?</h3>
      <p class="cta-subtitle">Consult directly with Naeem Siddhu for official Fard, Khasra, and Registry checks before buying.</p>
      <div class="cta-actions">
        <a href={`tel:${business.phone}`} class="btn-primary">
          <i class="fa-solid fa-phone"></i>
          <span>Call Naeem Siddhu</span>
        </a>
        <a href={`https://wa.me/${business.phone.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener" class="btn-secondary">
          <i class="fa-brands fa-whatsapp"></i>
          <span>WhatsApp Consultation</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .guide-page {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }
  .guide-header-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 2.75rem 2rem;
    margin-bottom: 2rem;
    text-align: center;
  }
  .guide-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(184, 138, 59, 0.15);
    border: 1px solid rgba(184, 138, 59, 0.3);
    color: var(--accent-gold);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .guide-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }
  .guide-subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 780px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }
  .terms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    text-align: left;
  }
  .term-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-control);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .term-card i {
    font-size: 1.75rem;
    margin-bottom: 0.25rem;
  }
  .term-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }
  .term-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }
  .content-section {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 2.25rem;
    margin-bottom: 2rem;
  }
  .section-heading {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1.5rem;
  }
  .arc-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .info-box {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-control);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .info-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .info-val {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .steps-flow {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .flow-step {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-control);
    padding: 1.25rem;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .step-num {
    background: var(--accent-gold);
    color: var(--bg-main);
    font-weight: 800;
    font-size: 1.2rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .step-content {
    flex: 1;
  }
  .step-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.4rem;
  }
  .step-text {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }
  .guide-cta-banner {
    background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-elevated) 100%);
    border: 1px solid rgba(184, 138, 59, 0.3);
    border-radius: var(--radius-card);
    padding: 3rem 2rem;
    text-align: center;
  }
  .cta-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
  }
  .cta-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 650px;
    margin: 0 auto 1.75rem;
  }
  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
