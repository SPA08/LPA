---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/global/Breadcrumbs.astro';
import { business } from '@/data/business';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'City & Guides', url: '/chichawatni-city-guide.html' },
  { name: 'Markets & Bazaars', url: '/chichawatni-markets-guide.html' }
];
---

<BaseLayout
  title="Markets & Bazaars in Chichawatni | Commercial Directory Guide"
  description="Guide to Chichawatni’s agricultural trading hubs, historical British-era 12 bazaars, Galla Mandi, Tower Road shopping strip, and wholesale centers."
  canonical="https://siddhupropertyadvisor.com/chichawatni-markets-guide.html"
>
  <div class="container guide-page">
    <Breadcrumbs items={breadcrumbs} />

    <header class="guide-header-card">
      <div class="guide-badge">
        <i class="fa-solid fa-store"></i>
        <span>Commercial Bazaars & Markets</span>
      </div>
      <h1 class="guide-title">Markets & Bazaars in Chichawatni</h1>
      <p class="guide-subtitle">
        Guide to Chichawatni’s agricultural trading hubs, historical British-era grid bazaars, wholesale centers, and modern commercial shopping strips.
      </p>
    </header>

    <!-- Markets Grid -->
    <section class="content-section">
      <h2 class="section-heading">Key Commercial & Wholesale Bazaars</h2>
      <div class="markets-grid">
        <div class="market-card">
          <span class="card-badge highlight-teal">Agricultural Trading Hub</span>
          <h3 class="market-name highlight-gold">Grain Market (Galla Mandi)</h3>
          <p class="market-desc">
            One of the largest grain markets in Sahiwal division, established during the British canal colony expansion. Major trading point for wheat, cotton, corn, and oilseeds.
          </p>
          <ul class="market-list">
            <li><strong>Primary Trade:</strong> Wheat, Cotton, Corn, Fertilizer</li>
            <li><strong>Property Type:</strong> Commercial shops, commission shops, godowns</li>
            <li><strong>Location:</strong> Railway Station Road Corridor</li>
          </ul>
        </div>

        <div class="market-card">
          <span class="card-badge highlight-teal">Retail & Apparel Center</span>
          <h3 class="market-name highlight-gold">Rail Bazaar & Saddar Market</h3>
          <p class="market-desc">
            The traditional 12-bazaar planned grid center of Chichawatni city, housing clothing boutiques, footwear, gold markets, and household goods.
          </p>
          <ul class="market-list">
            <li><strong>Layout:</strong> Historical Grid Bazaars (1 to 12)</li>
            <li><strong>Products:</strong> Textiles, Jewelry, Footwear, Crockery</li>
            <li><strong>Footfall:</strong> High daily consumer density</li>
          </ul>
        </div>

        <div class="market-card">
          <span class="card-badge highlight-gold">Modern Commercial Strip</span>
          <h3 class="market-name highlight-gold">Tower Road Shopping Strip</h3>
          <p class="market-desc">
            Modern commercial sector featuring banks (HBL, UBL, Meezan), pharmaceutical centers, corporate offices, and property advisory firms in Hayat Abad.
          </p>
          <ul class="market-list">
            <li><strong>Key Anchor:</strong> Siddhu Property Advisor (Street 08)</li>
            <li><strong>Tenants:</strong> Commercial Banks, Clinics, Agencies</li>
            <li><strong>Access:</strong> Direct link to GT Road & Hayat Abad</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- CTA Banner -->
    <section class="guide-cta-banner">
      <h3 class="cta-title">Interested in Commercial Shop or Plaza Investment in Chichawatni?</h3>
      <p class="cta-subtitle">Naeem Siddhu provides verified rental yield estimations, commercial FBR tax valuation guidance, and title verification across Chichawatni bazaars.</p>
      <div class="cta-actions">
        <a href={`tel:${business.phone}`} class="btn-primary">
          <i class="fa-solid fa-phone"></i>
          <span>Call Naeem Siddhu</span>
        </a>
        <a href={`https://wa.me/${business.phone.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener" class="btn-secondary">
          <i class="fa-brands fa-whatsapp"></i>
          <span>WhatsApp Consultation</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .guide-page {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }
  .guide-header-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 2.75rem 2rem;
    margin-bottom: 2rem;
    text-align: center;
  }
  .guide-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(184, 138, 59, 0.15);
    border: 1px solid rgba(184, 138, 59, 0.3);
    color: var(--accent-gold);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .guide-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }
  .guide-subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 780px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .content-section {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 2.25rem;
    margin-bottom: 2rem;
  }
  .section-heading {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1.5rem;
  }
  .markets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .market-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-control);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .card-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .market-name {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
  }
  .market-desc {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0 0 0.5rem;
  }
  .market-list {
    list-style: none;
    padding: 0;
    margin: auto 0 0 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }
  .market-list li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .market-list li:last-child {
    border-bottom: none;
  }
  .guide-cta-banner {
    background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-elevated) 100%);
    border: 1px solid rgba(184, 138, 59, 0.3);
    border-radius: var(--radius-card);
    padding: 3rem 2rem;
    text-align: center;
  }
  .cta-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
  }
  .cta-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 650px;
    margin: 0 auto 1.75rem;
  }
  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
