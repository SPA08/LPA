---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/global/Breadcrumbs.astro';
import { business } from '@/data/business';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'City & Guides', url: '/chichawatni-city-guide.html' },
  { name: 'Overseas Investor Guide', url: '/chichawatni-overseas-investor-guide.html' }
];
---

<BaseLayout
  title="Overseas Pakistanis Property Advisory in Chichawatni | SIDDHU Property Advisor"
  description="Secure, transparent, and fraud-free property purchases for overseas Pakistanis in Saudi Arabia, UAE, UK, USA, Europe, and Gulf region with Naeem Siddhu."
  canonical="https://siddhupropertyadvisor.com/chichawatni-overseas-investor-guide.html"
>
  <div class="container guide-page">
    <Breadcrumbs items={breadcrumbs} />

    <header class="guide-header-card">
      <div class="guide-badge">
        <i class="fa-solid fa-globe"></i>
        <span>Dedicated Overseas Pakistani Portal</span>
      </div>
      <h1 class="guide-title">Overseas Pakistanis Property Advisory in Chichawatni</h1>
      <p class="guide-subtitle">
        Secure, transparent, and hassle-free property purchases for overseas Pakistanis in Saudi Arabia, UAE, UK, USA, Europe, and Gulf region with Naeem Siddhu.
      </p>

      <div class="services-grid">
        <div class="service-card">
          <i class="fa-solid fa-video highlight-gold"></i>
          <h3 class="service-title">Live Video Site Walkthroughs</h3>
          <p class="service-desc">HD video tours showing street surroundings, construction quality, elevation, and utility connections before you commit.</p>
        </div>
        <div class="service-card">
          <i class="fa-solid fa-stamp highlight-teal"></i>
          <h3 class="service-title">Power of Attorney (PoA) Guidance</h3>
          <p class="service-desc">Complete assistance for executing legal Power of Attorney attested by the Pakistan Embassy/Consulate in your country of residence.</p>
        </div>
        <div class="service-card">
          <i class="fa-solid fa-shield-halved highlight-gold"></i>
          <h3 class="service-title">Pre-Purchase Record Audit</h3>
          <p class="service-desc">Thorough verification at Arazi Record Center (PLRA) Chichawatni and Sub-Registrar office to guarantee fraud-free ownership documents.</p>
        </div>
        <div class="service-card">
          <i class="fa-solid fa-building-columns highlight-teal"></i>
          <h3 class="service-title">Roshan Digital Account (RDA)</h3>
          <p class="service-desc">Guidance on transferring payments legally through official banking channels, State Bank of Pakistan RDA, and tax compliance.</p>
        </div>
      </div>
    </header>

    <!-- Overseas Steps -->
    <section class="content-section">
      <h2 class="section-heading">How Remote Property Purchase Works</h2>
      <div class="steps-flow">
        <div class="flow-step">
          <div class="step-num">1</div>
          <div class="step-content">
            <h3 class="step-title">Initial Consultation & Shortlisting</h3>
            <p class="step-text">Share your exact budget, preferred locality (e.g., Hayat Abad, Model Town), and size requirements via WhatsApp direct call.</p>
          </div>
        </div>
        <div class="flow-step">
          <div class="step-num">2</div>
          <div class="step-content">
            <h3 class="step-title">Physical Ground Audit & Video Tour</h3>
            <p class="step-text">Naeem Siddhu visits the property, records full footage, verifies water/gas connections, and checks neighbor credentials.</p>
          </div>
        </div>
        <div class="flow-step">
          <div class="step-num">3</div>
          <div class="step-content">
            <h3 class="step-title">Government Land Record Verification</h3>
            <p class="step-text">Arazi Record Center Chichawatni records are audited to confirm 100% clean title and clear seller identity.</p>
          </div>
        </div>
        <div class="flow-step">
          <div class="step-num">4</div>
          <div class="step-content">
            <h3 class="step-title">Secure Banking Transfer & Registration</h3>
            <p class="step-text">Payments are routed through official banking channels with formal legal agreements executed in your or your representative's name.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Banner -->
    <section class="guide-cta-banner">
      <h3 class="cta-title">Living Abroad & Planning to Invest in Chichawatni?</h3>
      <p class="cta-subtitle">Connect directly with CEO Naeem Siddhu via WhatsApp call or message for confidential advisory.</p>
      <div class="cta-actions">
        <a href={`tel:${business.phone}`} class="btn-primary">
          <i class="fa-solid fa-phone"></i>
          <span>Call Naeem Siddhu</span>
        </a>
        <a href={`https://wa.me/${business.phone.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener" class="btn-whatsapp">
          <i class="fa-brands fa-whatsapp"></i>
          <span>WhatsApp</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .guide-page {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }
  .guide-header-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 2.75rem 2rem;
    margin-bottom: 2rem;
    text-align: center;
  }
  .guide-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(184, 138, 59, 0.15);
    border: 1px solid rgba(184, 138, 59, 0.3);
    color: var(--accent-gold);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .guide-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }
  .guide-subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 780px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    text-align: left;
  }
  .service-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-control);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .service-card i {
    font-size: 1.75rem;
    margin-bottom: 0.25rem;
  }
  .service-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }
  .service-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }
  .content-section {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 2.25rem;
    margin-bottom: 2rem;
  }
  .section-heading {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1.5rem;
  }
  .steps-flow {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .flow-step {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-control);
    padding: 1.5rem;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .step-num {
    background: var(--accent-gold);
    color: var(--bg-main);
    font-weight: 800;
    font-size: 1.25rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .step-content {
    flex: 1;
  }
  .step-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
  }
  .step-text {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0;
  }
  .guide-cta-banner {
    background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-elevated) 100%);
    border: 1px solid rgba(184, 138, 59, 0.3);
    border-radius: var(--radius-card);
    padding: 3rem 2rem;
    text-align: center;
  }
  .cta-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
  }
  .cta-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 650px;
    margin: 0 auto 1.75rem;
  }
  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
