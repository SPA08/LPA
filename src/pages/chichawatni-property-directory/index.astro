<!-- Serialize complete dataset for client JS -->
<script is:inline define:vars={{ serializedEntries: allEntries }}>
  window.directoryDataset = serializedEntries;
</script>

<script is:inline>
  // Global State
  let activeCategory = 'all';
  let activeSearchTerm = '';
  let activeViewMode = 'cards';
  let currentPage = 1;
  const pageSize = 12;

  // 1. Punjab Land Rakba Calculator Mechanics
  window.convertRakba = function(sourceUnit, value) {
    const val = parseFloat(value);
    if (isNaN(val) || val <= 0) {
      if (value === '' || val === 0) {
        document.getElementById('resSqFt').textContent = '0';
        document.getElementById('resSqFtUrban').textContent = '0';
        document.getElementById('resSqYards').textContent = '0';
      }
      return;
    }

    let murabbas = 0;
    let acres = 0;
    let kanals = 0;
    let marlas = 0;

    // Base unit conversion (Revenue standard: 1 Murabba = 25 Acres = 200 Kanals = 4,000 Marlas)
    if (sourceUnit === 'murabba') {
      murabbas = val;
      acres = murabbas * 25;
      kanals = acres * 8;
      marlas = kanals * 20;
    } else if (sourceUnit === 'acre') {
      acres = val;
      murabbas = acres / 25;
      kanals = acres * 8;
      marlas = kanals * 20;
    } else if (sourceUnit === 'kanal') {
      kanals = val;
      marlas = kanals * 20;
      acres = kanals / 8;
      murabbas = acres / 25;
    } else if (sourceUnit === 'marla') {
      marlas = val;
      kanals = marlas / 20;
      acres = kanals / 8;
      murabbas = acres / 25;
    }

    // Update input boxes (except active input)
    if (sourceUnit !== 'murabba') {
      const el = document.getElementById('calcMurabba');
      if (el) el.value = murabbas ? (murabbas < 0.01 ? murabbas.toFixed(4) : murabbas.toFixed(2)) : '';
    }
    if (sourceUnit !== 'acre') {
      const el = document.getElementById('calcAcre');
      if (el) el.value = acres ? (acres < 0.1 ? acres.toFixed(3) : acres.toFixed(2)) : '';
    }
    if (sourceUnit !== 'kanal') {
      const el = document.getElementById('calcKanal');
      if (el) el.value = kanals ? kanals.toFixed(2) : '';
    }
    if (sourceUnit !== 'marla') {
      const el = document.getElementById('calcMarla');
      if (el) el.value = marlas ? marlas.toFixed(1) : '';
    }

    // Revenue standard: 272.25 sq ft / marla, Urban standard: 225 sq ft / marla
    const sqFtRev = marlas * 272.25;
    const sqFtUrban = marlas * 225.0;
    const sqYards = sqFtRev / 9.0;

    document.getElementById('resSqFt').textContent = Math.round(sqFtRev).toLocaleString();
    document.getElementById('resSqFtUrban').textContent = Math.round(sqFtUrban).toLocaleString();
    document.getElementById('resSqYards').textContent = Math.round(sqYards).toLocaleString();
  };

  window.resetRakbaCalc = function() {
    ['calcMurabba', 'calcAcre', 'calcKanal', 'calcMarla'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = '';
    });
    document.getElementById('resSqFt').textContent = '0';
    document.getElementById('resSqFtUrban').textContent = '0';
    document.getElementById('resSqYards').textContent = '0';
  };

  // 2. Filter & Pagination Engine
  function applyFiltersAndPagination(shouldScroll = false) {
    const cards = Array.from(document.querySelectorAll('#cadastralCardsContainer .cad-card'));
    const rows = Array.from(document.querySelectorAll('#cadastralTableBody .table-entry-row'));

    // Filter matching
    const matchingCards = [];
    const matchingRows = [];

    cards.forEach((card, index) => {
      const cat = card.getAttribute('data-category') || '';
      const search = card.getAttribute('data-search') || '';

      const matchCat = activeCategory === 'all' || cat === activeCategory;
      const matchSearch = !activeSearchTerm || search.includes(activeSearchTerm);

      if (matchCat && matchSearch) {
        matchingCards.push(card);
        if (rows[index]) matchingRows.push(rows[index]);
      } else {
        card.style.display = 'none';
        if (rows[index]) rows[index].style.display = 'none';
      }
    });

    const totalMatching = matchingCards.length;
    const totalPages = Math.ceil(totalMatching / pageSize) || 1;

    // Clamp current page
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    // Slice to current 12 items
    const startIndex = (currentPage - 1) * pageSize;
    const endIndex = startIndex + pageSize;

    matchingCards.forEach((card, i) => {
      if (i >= startIndex && i < endIndex) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });

    matchingRows.forEach((row, i) => {
      if (i >= startIndex && i < endIndex) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });

    // Update Counts & Meta
    const countLabel = document.getElementById('visibleCountLabel');
    if (countLabel) countLabel.textContent = totalMatching;

    const pageSummaryText = document.getElementById('paginationSummaryText');
    if (pageSummaryText) pageSummaryText.textContent = `(Page ${currentPage} of ${totalPages})`;

    const rangeStart = totalMatching === 0 ? 0 : startIndex + 1;
    const rangeEnd = Math.min(endIndex, totalMatching);
    const rangeStartEl = document.getElementById('pageRangeStart');
    const rangeEndEl = document.getElementById('pageRangeEnd');
    const totalMatchingCountEl = document.getElementById('totalMatchingCount');

    if (rangeStartEl) rangeStartEl.textContent = rangeStart;
    if (rangeEndEl) rangeEndEl.textContent = rangeEnd;
    if (totalMatchingCountEl) totalMatchingCountEl.textContent = totalMatching;

    // Prev / Next button states
    const btnPrev = document.getElementById('btnPrevPage');
    const btnNext = document.getElementById('btnNextPage');
    if (btnPrev) btnPrev.disabled = currentPage <= 1;
    if (btnNext) btnNext.disabled = currentPage >= totalPages;

    // Build Page Number Buttons
    renderPageNumbers(totalPages);

    // Empty state
    const emptyState = document.getElementById('dirEmptyState');
    const paginationBar = document.getElementById('paginationBar');
    if (emptyState) emptyState.style.display = totalMatching === 0 ? 'flex' : 'none';
    if (paginationBar) paginationBar.style.display = totalMatching === 0 ? 'none' : 'flex';

    if (shouldScroll) {
      const target = document.getElementById('directoryToolbar');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  }

  function renderPageNumbers(totalPages) {
    const wrap = document.getElementById('pageNumbersWrap');
    if (!wrap) return;
    wrap.innerHTML = '';

    if (totalPages <= 1) return;

    for (let p = 1; p <= totalPages; p++) {
      // In large page counts, collapse middle pages
      if (totalPages > 6) {
        if (p > 2 && p < totalPages - 1 && Math.abs(p - currentPage) > 1) {
          if (p === 3 || p === totalPages - 2) {
            const ellipsis = document.createElement('span');
            ellipsis.className = 'page-ellipsis';
            ellipsis.textContent = '...';
            wrap.appendChild(ellipsis);
          }
          continue;
        }
      }

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `page-num-btn ${p === currentPage ? 'active' : ''}`;
      btn.textContent = p;
      btn.onclick = () => window.goToPage(p);
      wrap.appendChild(btn);
    }
  }

  // 3. User Controls
  window.changePage = function(delta) {
    currentPage += delta;
    applyFiltersAndPagination(true);
  };

  window.goToPage = function(page) {
    currentPage = page;
    applyFiltersAndPagination(true);
  };

  window.selectCadastralCategory = function(cat, btn) {
    activeCategory = cat;
    currentPage = 1;
    document.querySelectorAll('.cat-tab-btn').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    applyFiltersAndPagination(false);
  };

  window.handleCadastralSearch = function(val) {
    activeSearchTerm = (val || '').toLowerCase().trim();
    currentPage = 1;
    const clearBtn = document.getElementById('dirSearchClearBtn');
    if (clearBtn) clearBtn.style.display = activeSearchTerm ? 'flex' : 'none';
    applyFiltersAndPagination(false);
  };

  window.clearCadastralSearch = function() {
    activeSearchTerm = '';
    activeCategory = 'all';
    currentPage = 1;
    const input = document.getElementById('cadastralSearchInput');
    if (input) input.value = '';
    const clearBtn = document.getElementById('dirSearchClearBtn');
    if (clearBtn) clearBtn.style.display = 'none';

    document.querySelectorAll('.cat-tab-btn').forEach(b => {
      b.classList.toggle('active', b.getAttribute('data-cat') === 'all');
    });

    applyFiltersAndPagination(false);
  };

  window.switchDirectoryView = function(mode) {
    activeViewMode = mode;
    const cardsEl = document.getElementById('cadastralCardsContainer');
    const tableEl = document.getElementById('cadastralTableContainer');
    const btnCards = document.getElementById('btnViewCards');
    const btnTable = document.getElementById('btnViewTable');

    if (mode === 'table') {
      if (cardsEl) cardsEl.style.display = 'none';
      if (tableEl) tableEl.style.display = 'block';
      btnCards?.classList.remove('active');
      btnTable?.classList.add('active');
    } else {
      if (cardsEl) cardsEl.style.display = 'grid';
      if (tableEl) tableEl.style.display = 'none';
      btnTable?.classList.remove('active');
      btnCards?.classList.add('active');
    }
    applyFiltersAndPagination(false);
  };

  // 4. Modal / Side Drawer Details Engine
  window.openAreaModal = function(id) {
    const dataset = window.directoryDataset || [];
    const entry = dataset.find(e => e.id === id);
    if (!entry) return;

    // Populate Fields
    document.getElementById('modalAreaTitle').textContent = entry.name;
    document.getElementById('modalAreaSub').textContent = `${entry.parentChak} • Tehsil Chichawatni`;

    const statusBadgeEl = document.getElementById('modalStatusBadge');
    if (statusBadgeEl) {
      statusBadgeEl.className = `status-pill ${entry.statusClass}`;
      statusBadgeEl.innerHTML = `<i class="${entry.statusIcon}"></i> <span>${entry.statusBadge}</span>`;
    }

    document.getElementById('modalCategoryTag').textContent = entry.categoryLabel;
    document.getElementById('modalRakbaVal').textContent = entry.rakbaPrimary;
    document.getElementById('modalRakbaSub').textContent = entry.rakbaSub;
    document.getElementById('modalRateVal').textContent = entry.rate;
    document.getElementById('modalStreetsVal').textContent = entry.streets;
    document.getElementById('modalCanalVal').textContent = entry.canal || 'Municipal / Sub-Surface Belt';
    document.getElementById('modalWaterVal').textContent = entry.water;
    document.getElementById('modalSoilVal').textContent = entry.soil;
    document.getElementById('modalLegalText').textContent = entry.legalDetails || 'Verified PLRA & TMA Municipal records on file.';
    document.getElementById('modalDescText').textContent = entry.description;

    // Highlights
    const hlWrap = document.getElementById('modalHighlightsWrap');
    if (hlWrap) {
      hlWrap.innerHTML = '';
      if (entry.highlights && entry.highlights.length > 0) {
        entry.highlights.forEach(h => {
          const chip = document.createElement('span');
          chip.className = 'm-chip';
          chip.innerHTML = `<i class="fa-solid fa-check" style="color: #10B981 !important;"></i> ${h}`;
          hlWrap.appendChild(chip);
        });
      }
    }

    // GPS & Links
    const coordsText = `${entry.lat.toFixed(4)}°N, ${entry.lng.toFixed(4)}°E`;
    document.getElementById('modalCoordsText').textContent = coordsText;

    const mapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${entry.lat},${entry.lng}`;
    document.getElementById('modalMapsLink').setAttribute('href', mapsUrl);

    const waMsg = encodeURIComponent(`Assalam-o-Alaikum Naeem Sahab, I am viewing the cadastral record for "${entry.name}" (${entry.statusBadge}) on SIDDHU Property Advisor. Please share available plots, registry status, and 2026 valuation details.`);
    const waUrl = `https://wa.me/923063996764?text=${waMsg}`;
    document.getElementById('modalWaBtn').setAttribute('href', waUrl);

    // Show Modal
    const backdrop = document.getElementById('areaModalBackdrop');
    if (backdrop) {
      backdrop.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
  };

  window.closeAreaModal = function() {
    const backdrop = document.getElementById('areaModalBackdrop');
    if (backdrop) {
      backdrop.style.display = 'none';
      document.body.style.overflow = '';
    }
  };

  // Keyboard accessibility
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      window.closeAreaModal();
    }
  });

  // Initialize on load
  document.addEventListener('DOMContentLoaded', () => {
    applyFiltersAndPagination(false);
  });
  // Instant fallback for Astro view transitions
  applyFiltersAndPagination(false);
</script>

