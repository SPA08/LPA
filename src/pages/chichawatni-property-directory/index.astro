  }

  .cat-tab-btn:hover {
    border-color: #CBD5E1;
    color: #0F172A;
    background: #FFFFFF;
    transform: translateY(-1px);
  }

  .cat-tab-btn.active {
    background: #0F172A;
    border-color: #0F172A;
    color: #FFFFFF;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
  }

  .tab-count-badge {
    font-size: 0.72rem;
    font-weight: 800;
    background: #F1F5F9;
    color: #334155;
    padding: 2px 8px;
    border-radius: 999px;
    transition: all 0.2s ease;
  }

  .cat-tab-btn.active .tab-count-badge {
    background: rgba(255, 255, 255, 0.22);
    color: #FFFFFF;
  }

  /* ========================================================
     6. TOOLBAR (SEARCH + VIEW SWITCHER)
     ======================================================== */
  .directory-toolbar-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    padding: 14px 18px;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .toolbar-search-col {
    position: relative;
    flex: 1;
    max-width: 600px;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    font-size: 0.95rem;
    color: #059669;
    pointer-events: none;
  }

  .toolbar-search-col input {
    width: 100%;
    height: 44px;
    background: #F8FAFC;
    border: 1.5px solid #E2E8F0;
    border-radius: 10px;
    padding: 0 40px 0 42px;
    font-size: 0.92rem;
    font-weight: 500;
    color: #0F172A;
    transition: all 0.2s ease;
  }

  .toolbar-search-col input:focus {
    background: #FFFFFF;
    border-color: #059669;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
    outline: none;
  }

  .dir-clear-btn {
    position: absolute;
    right: 12px;
    background: none;
    border: none;
    color: #94A3B8;
    font-size: 0.95rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
  }

  .dir-clear-btn:hover {
    color: #0F172A;
  }

  .toolbar-actions-col {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .view-mode-toggle {
    display: inline-flex;
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 3px;
    gap: 2px;
  }

  .view-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: #64748B;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .view-btn.active {
    background: #0F172A;
    color: #FFFFFF;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.15);
  }

  .btn-toolbar-map {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 10px;
    background: #F8FAFC;
    border: 1px solid #CBD5E1;
    color: #1E293B;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-toolbar-map:hover {
    background: #0F172A;
    color: #FFFFFF;
    border-color: #0F172A;
  }

  /* Results Meta Summary */
  .results-meta-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: #64748B;
    margin-bottom: 20px;
    padding: 0 4px;
  }

  .results-meta-strip strong {
    color: #0F172A;
  }

  /* ========================================================
     7. ULTRA-CLEAN 3-PART SAAS CARD (MAX 12 AT A TIME)
     ======================================================== */
  .cadastral-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }

  .cad-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 22px 20px 18px;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s ease;
  }

  .cad-card:hover {
    transform: translateY(-3px);
    border-color: #CBD5E1;
    box-shadow: 0 12px 24px -4px rgba(15, 23, 42, 0.08);
  }

  /* 1. TOP: Name + 1 Clear Status Badge */
  .card-top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
  }

  .card-title-group {
    flex: 1;
  }

  .card-area-name {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0F172A;
    line-height: 1.3;
    margin: 0 0 4px;
    letter-spacing: -0.01em;
  }

  .card-parent-tag {
    font-size: 0.74rem;
    color: #64748B;
    font-weight: 600;
  }

  /* Status Badges */
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .pill-tma {
    background: #ECFDF5;
    color: #065F46;
    border: 1px solid #A7F3D0;
  }

  .pill-intiqal {
    background: #EFF6FF;
    color: #1E40AF;
    border: 1px solid #BFDBFE;
  }

  .pill-private {
    background: #FDF4FF;
    color: #86198F;
    border: 1px solid #F5D0FE;
  }

  .pill-village {
    background: #FEFCE8;
    color: #854D0E;
    border: 1px solid #FEF08A;
  }

  .pill-block {
    background: #FFFBEB;
    color: #92400E;
    border: 1px solid #FDE68A;
  }

  .pill-commercial {
    background: #F8FAFC;
    color: #334155;
    border: 1px solid #E2E8F0;
  }

  /* 2. MIDDLE: 2 Clean Boxes Side-by-Side */
  .card-boxes-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 16px;
  }

  .mini-spec-box {
    border-radius: 10px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
  }

  .rakba-box {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
  }

  .rate-box {
    background: rgba(16, 185, 129, 0.06);
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .box-label {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #64748B;
    margin-bottom: 4px;
  }

  .rate-box .box-label {
    color: #059669;
  }

  .box-val {
    font-size: 0.98rem;
    font-weight: 800;
    color: #0F172A;
    line-height: 1.25;
  }

  .text-emerald {
    color: #059669 !important;
  }

  .box-sub {
    font-size: 0.72rem;
    color: #64748B;
    font-weight: 500;
    margin-top: 3px;
    line-height: 1.25;
  }

  .rate-box .box-sub {
    color: #059669;
    font-weight: 600;
  }

  /* 3. BOTTOM: Summary Line + Prominent Button */
  .card-bottom-row {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid #F1F5F9;
  }

  .card-summary-line {
    font-size: 0.8rem;
    color: #64748B;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .icon-gray {
    color: #94A3B8;
    font-size: 0.85rem;
  }

  .btn-card-details {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #F8FAFC;
    border: 1.5px solid #CBD5E1;
    color: #0F172A;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 10px 16px;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-card-details:hover {
    background: #0F172A;
    color: #FFFFFF;
    border-color: #0F172A;
  }

  .btn-card-details:hover i {
    transform: translateX(3px);
  }

  .btn-card-details i {
    font-size: 0.8rem;
    transition: transform 0.2s ease;
  }

  /* ========================================================
     8. SIMPLE COMPARISON TABLE VIEW
     ======================================================== */
  .cadastral-table-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    overflow: hidden;
    margin-bottom: 32px;
  }

  .table-responsive {
    width: 100%;
    overflow-x: auto;
  }

  .cadastral-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.88rem;
  }

  .cadastral-table th {
    background: #F8FAFC;
    color: #475569;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 14px 18px;
    border-bottom: 2px solid #E2E8F0;
  }

  .cadastral-table td {
    padding: 16px 18px;
    border-bottom: 1px solid #F1F5F9;
    vertical-align: middle;
  }

  .cadastral-table tr:hover td {
    background: #F8FAFC;
  }

  .table-area-title {
    display: block;
    font-size: 0.94rem;
    font-weight: 700;
    color: #0F172A;
  }

  .table-area-sub {
    font-size: 0.74rem;
    color: #64748B;
  }

  .table-cat-badge {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 600;
    color: #334155;
    background: #F1F5F9;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .status-pill-sm {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .table-rakba-val {
    display: block;
    color: #0F172A;
  }

  .table-rakba-sub {
    font-size: 0.72rem;
    color: #64748B;
  }

  .btn-table-details {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 8px;
    background: #F1F5F9;
    border: 1px solid #CBD5E1;
    color: #0F172A;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-table-details:hover {
    background: #0F172A;
    color: #FFFFFF;
    border-color: #0F172A;
  }

  /* ========================================================
     9. CLEAN SAAS PAGINATION BAR
     ======================================================== */
  .pagination-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    padding: 14px 20px;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.03);
    margin-bottom: 36px;
  }

  .pagination-info {
    font-size: 0.85rem;
    color: #475569;
  }

  .pagination-info strong {
    color: #0F172A;
  }

  .pagination-controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .btn-page-nav {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 8px;
    background: #F8FAFC;
    border: 1.5px solid #CBD5E1;
    color: #0F172A;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-page-nav:hover:not(:disabled) {
    background: #0F172A;
    color: #FFFFFF;
    border-color: #0F172A;
  }

  .btn-page-nav:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    border-color: #E2E8F0;
  }

  .page-numbers-wrap {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  :global(.page-num-btn) {
    min-width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: 1px solid #E2E8F0;
    background: #FFFFFF;
    color: #0F172A;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  :global(.page-num-btn:hover) {
    border-color: #CBD5E1;
    background: #F8FAFC;
  }

  :global(.page-num-btn.active) {
    background: #0F172A;
    border-color: #0F172A;
    color: #FFFFFF;
  }

  :global(.page-ellipsis) {
    padding: 0 4px;
    color: #94A3B8;
    font-size: 0.85rem;
  }

  /* Empty State */
  .dir-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    border: 1px dashed #CBD5E1;
    border-radius: 16px;
    padding: 50px 24px;
    text-align: center;
    margin-bottom: 36px;
  }

  .empty-icon-box {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #F1F5F9;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    color: #94A3B8;
    margin-bottom: 16px;
  }

  .dir-empty-state h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0F172A;
    margin: 0 0 8px;
  }

  .dir-empty-state p {
    font-size: 0.9rem;
    color: #64748B;
    max-width: 480px;
    margin: 0 0 20px;
    line-height: 1.5;
  }

  .btn-empty-reset {
    background: #0F172A;
    color: #FFFFFF;
    border: none;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-empty-reset:hover {
    background: #1E293B;
  }

  /* ========================================================
     10. BOTTOM CONSULTATION BANNER
     ======================================================== */
  .cadastral-consult-banner {
    background: #132A1F;
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 20px;
    padding: 34px 38px;
    color: #FFFFFF;
    box-shadow: 0 10px 30px -5px rgba(19, 42, 31, 0.35);
  }

  .banner-body {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 28px;
    align-items: center;
  }

  .banner-icon-side {
    width: 60px;
    height: 60px;
    border-radius: 14px;
    background: rgba(212, 175, 55, 0.15);
    border: 1px solid rgba(212, 175, 55, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    color: #FDE68A;
  }

  .banner-text-side h3 {
    font-size: 1.35rem;
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 8px;
  }

  .banner-text-side p {
    font-size: 0.9rem;
    color: #CBD5E1;
    margin: 0;
    line-height: 1.55;
    max-width: 620px;
  }

  .banner-cta-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }

  .btn-banner-wa {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #25D366;
    color: #FFFFFF;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 12px 22px;
    border-radius: 10px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
    transition: all 0.2s ease;
  }

  .btn-banner-wa:hover {
    background: #1EBE5D;
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  .office-hint {
    font-size: 0.74rem;
    color: #94A3B8;
  }

  /* ========================================================
     11. MODAL / SIDE DRAWER POPUP FOR DEEPER DETAILS
     ======================================================== */
  .area-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(5px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    animation: fadeInModal 0.2s ease-out;
  }

  @keyframes fadeInModal {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .area-modal-dialog {
    background: #FFFFFF;
    border-radius: 20px;
    width: 100%;
    max-width: 640px;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25);
    overflow: hidden;
    animation: slideUpModal 0.25s ease-out;
  }

  @keyframes slideUpModal {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .modal-close-btn {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #F1F5F9;
    border: none;
    color: #475569;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 10;
  }

  .modal-close-btn:hover {
    background: #0F172A;
    color: #FFFFFF;
  }

  .modal-header {
    padding: 26px 28px 18px;
    border-bottom: 1px solid #F1F5F9;
  }

  .modal-badges-strip {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .modal-cat-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: #475569;
    background: #F1F5F9;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .modal-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0F172A;
    margin: 0 0 4px;
    line-height: 1.25;
  }

  .modal-sub {
    font-size: 0.84rem;
    color: #64748B;
    margin: 0;
  }

  .modal-body {
    padding: 22px 28px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* Modal Specs Grid */
  .modal-specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .m-spec-card {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
  }

  .m-spec-label {
    font-size: 0.7rem;
    font-weight: 700;
    color: #64748B;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .m-spec-value {
    font-size: 1rem;
    font-weight: 800;
    color: #0F172A;
    line-height: 1.3;
  }

  .m-spec-sub {
    font-size: 0.72rem;
    color: #64748B;
    margin-top: 3px;
  }

  /* Legal Card */
  .modal-legal-card {
    background: #F0F9FF;
    border: 1px solid #BAE6FD;
    border-radius: 12px;
    padding: 14px 16px;
  }

  .legal-card-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  .legal-card-header h4 {
    font-size: 0.85rem;
    font-weight: 800;
    color: #0369A1;
    margin: 0;
  }

  .modal-legal-card p {
    font-size: 0.82rem;
    color: #0C4A6E;
    margin: 0;
    line-height: 1.45;
  }

  /* Description & Highlights */
  .modal-desc-box h4 {
    font-size: 0.88rem;
    font-weight: 800;
    color: #0F172A;
    margin: 0 0 6px;
  }

  .modal-desc-box p {
    font-size: 0.86rem;
    color: #475569;
    line-height: 1.5;
    margin: 0 0 12px;
  }

  .modal-highlights-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .m-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    color: #334155;
    font-size: 0.76rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
  }

  /* GPS Strip */
  .modal-gps-strip {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
