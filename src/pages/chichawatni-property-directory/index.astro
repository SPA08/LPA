---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { cadastralDataset } from '@/data/cadastralDataset';
import { localities } from '@/data/locations';
import { business } from '@/data/business';

const pageTitle = "Chichawatni Land Records, Rakba & Area Directory | SIDDHU Property Advisor";
const pageDesc = "Official cadastral dataset for Tehsil Chichawatni: 16 Municipal Blocks, TMA approved schemes, private towns, commercial bazaars, and rural agricultural chaks with live Rakba converter.";

// Helper to format plot sizes and property configuration display cleanly
function formatRakbaDisplay(entry: any) {
  if (entry.plotSizes) {
    return {
      primary: entry.plotSizes,
      sub: entry.configSub || entry.streets || 'Verified Real-Estate Cut'
    };
  }
  if (entry.rakba && entry.rakba.includes('(')) {
    const parts = entry.rakba.split('(');
    const primary = parts[0].trim();
    const sub = parts[1].replace(')', '').trim();
    return { primary, sub };
  }
  return {
    primary: entry.rakba || '3, 5, 7 & 10 Marla Cuts',
    sub: 'Verified Real-Estate Configuration'
  };
}

// Helper to determine status badge display
function getStatusBadgeInfo(catKey: string, statusBadge: string = '') {
  const sb = statusBadge.toLowerCase();
  if (catKey === 'tma' || sb.includes('tma') || sb.includes('phata')) {
    return { label: 'TMA Approved', icon: 'fa-solid fa-circle-check', class: 'pill-tma' };
  }
  if (sb.includes('intiqal') || sb.includes('plra')) {
    return { label: 'PLRA Intiqal', icon: 'fa-solid fa-file-contract', class: 'pill-intiqal' };
  }
  if (catKey === 'block' || sb.includes('municipal')) {
    return { label: 'Municipal Block', icon: 'fa-solid fa-landmark', class: 'pill-block' };
  }
  if (catKey === 'village' || sb.includes('mouza') || sb.includes('chak') || sb.includes('zari')) {
    return { label: 'Zari Village', icon: 'fa-solid fa-wheat-awn', class: 'pill-village' };
  }
  if (catKey === 'commercial' || sb.includes('commercial') || sb.includes('road') || sb.includes('bazaar')) {
    return { label: 'Commercial Corridor', icon: 'fa-solid fa-road', class: 'pill-commercial' };
  }
  return { label: 'Private Scheme', icon: 'fa-solid fa-city', class: 'pill-private' };
}

// Combine Cadastral entries with verified localities
const allEntries = [
  ...cadastralDataset.map(c => {
    const catKey = c.categoryGroup === 'City Block' ? 'block' :
                   c.categoryGroup === 'TMA Colony' ? 'tma' :
                   c.categoryGroup === 'Private Scheme' ? 'private' :
                   c.categoryGroup === 'Zari Mouza' ? 'village' : 'commercial';

    const catLabel = c.categoryGroup || c.category;
    const badgeInfo = getStatusBadgeInfo(catKey, c.statusBadge);
    const rakbaInfo = formatRakbaDisplay(c);

    return {
      id: c.id,
      name: c.name,
      categoryKey: catKey,
      categoryLabel: catLabel,
      statusBadge: badgeInfo.label,
      statusClass: badgeInfo.class,
      statusIcon: badgeInfo.icon,
      rakbaPrimary: rakbaInfo.primary,
      rakbaSub: rakbaInfo.sub,
      rakbaRaw: c.rakba,
      plotSizes: c.plotSizes,
      configSub: c.configSub,
      streets: c.streets || '20ft–30ft paved roads',
      rate: c.rate || 'Competitive Market Rate',
      canal: c.canal || (catKey === 'village' ? '12-L Lower Bari Doab Canal' : undefined),
      water: c.water || 'Sweet Potable Tap Water (80-120ft)',
      soil: catKey === 'village' ? 'Fertile Agricultural Loam (زرخیز میرا)' : 'Urban Compact Ground',
      parentChak: c.parentChak || 'Tehsil Chichawatni',
      lat: c.lat,
      lng: c.lng,
      description: c.description,
      legalDetails: c.legalStatus,
      highlights: c.highlights || []
    };
  }),
  ...localities.map(l => {
    const isTMA = l.statusBadge === 'TMA Approved' || l.subType === 'Registered Colony';
    const isPrivate = l.category === 'Private Housing Scheme' || l.subType === 'Private Society';
    const isVillage = l.category === 'Village & Chak' || l.subType === 'Revenue Village';
    const isRoad = l.category === 'Road & Highway' || l.category === 'Commercial & Bazaar';

    const catKey = isTMA ? 'tma' : isPrivate ? 'private' : isVillage ? 'village' : isRoad ? 'commercial' : 'tma';
    const catLabel = isTMA ? 'TMA Colony' : isPrivate ? 'Private Scheme' : isVillage ? 'Zari Mouza' : isRoad ? 'Commercial Corridor' : 'Residential Scheme';
    const badgeInfo = getStatusBadgeInfo(catKey, l.statusBadge);
    const defaultCut = isRoad ? 'Commercial Shops & Frontage' : isVillage ? 'Zari Zameen & Abadi Deh' : '3, 5, 7 & 10 Marla Plots';
    const rakbaInfo = formatRakbaDisplay({ plotSizes: defaultCut, configSub: l.subType || 'Verified Scheme' });

    return {
      id: l.id,
      name: l.name,
      categoryKey: catKey,
      categoryLabel: catLabel,
      statusBadge: badgeInfo.label,
      statusClass: badgeInfo.class,
      statusIcon: badgeInfo.icon,
      rakbaPrimary: rakbaInfo.primary,
      rakbaSub: rakbaInfo.sub,
      rakbaRaw: defaultCut,
      plotSizes: defaultCut,
      configSub: l.subType || 'Verified Scheme',
      streets: '20ft - 40ft Planned Streets',
      rate: l.perMarlaRate || 'Competitive Market Value',
      canal: isVillage ? 'Lower Bari Doab Canal (LBDC)' : undefined,
      water: 'Sweet Potable Tap Water',
      soil: isVillage ? 'Rich Alluvial Agricultural Soil' : 'Urban Development Ground',
      parentChak: l.parentChak || 'Tehsil Chichawatni',
      lat: l.lat,
      lng: l.lng,
      description: l.description,
      legalDetails: l.legalStatus,
      highlights: l.highlights || ['Sub-Registrar Registry', 'Verified Civic Hub']
    };
  })
];

const categoryTabs = [
  { key: 'all', label: 'All Areas', icon: 'fa-solid fa-list-check', count: allEntries.length },
  { key: 'tma', label: '🟢 TMA Approved Colonies', icon: 'fa-solid fa-circle-check', count: allEntries.filter(e => e.categoryKey === 'tma').length },
  { key: 'private', label: '🔵 Private & Intiqal Towns', icon: 'fa-solid fa-city', count: allEntries.filter(e => e.categoryKey === 'private').length },
  { key: 'block', label: '🧱 City Blocks (1–16)', icon: 'fa-solid fa-landmark', count: allEntries.filter(e => e.categoryKey === 'block').length },
  { key: 'village', label: '🌾 Villages & Zari Chaks', icon: 'fa-solid fa-wheat-awn', count: allEntries.filter(e => e.categoryKey === 'village').length },
  { key: 'commercial', label: '🛣️ Roads & Bazaars', icon: 'fa-solid fa-road', count: allEntries.filter(e => e.categoryKey === 'commercial').length }
];
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <div class="cadastral-directory-page">
    
    <!-- Top Hero Banner (Retained Deep Forest Emerald) -->
    <header class="directory-hero">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge-pill">
            <i class="fa-solid fa-stamp highlight-gold"></i>
            <span>OFFICIAL TEHSIL CHICHAWATNI CADASTRAL ARCHIVE</span>
          </div>
          <h1>
            Chichawatni <span class="editorial-italic highlight-gold">Land Records &amp; Rakba Directory</span>
          </h1>
          <p class="hero-subtitle">
            Executive cadastral intelligence across all 16 Municipal Blocks, TMA Sanctioned Housing Schemes, Private PLRA Intiqal Towns, Commercial Corridors, and Agricultural Mouzas (12-L, 11-L, 14-L &amp; 7-R Belts).
          </p>

          <div class="hero-stats-strip">
            <div class="h-stat-card">
              <span class="h-stat-num">16</span>
              <span class="h-stat-label">Municipal Blocks</span>
            </div>
            <div class="h-stat-card">
              <span class="h-stat-num">35+</span>
              <span class="h-stat-label">Towns &amp; Schemes</span>
            </div>
            <div class="h-stat-card">
              <span class="h-stat-num">3 to 20M</span>
              <span class="h-stat-label">Standard Plot Cuts</span>
            </div>
            <div class="h-stat-card">
              <span class="h-stat-num">100%</span>
              <span class="h-stat-label">PLRA &amp; TMA Cross-Checked</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Wrap: Clean Bright Light SaaS Background (#F8FAFC) -->
    <main class="directory-main-section">
      <div class="container">
        
        <!-- Punjab Land Rakba Calculator (Clean Light White Theme with Dark Bold Values) -->
        <section class="rakba-calculator-card" id="rakbaCalculator">
          <div class="calc-header">
            <div class="calc-title-wrap">
              <div class="calc-badge-icon">
                <i class="fa-solid fa-calculator highlight-emerald"></i>
              </div>
              <div>
                <h3>Punjab Standard Rakba &amp; Land Measurement Converter</h3>
                <p>Instant two-way conversion for agricultural &amp; urban property across Chichawatni (1 Murabba = 25 Acres = 200 Kanals = 4,000 Marlas).</p>
              </div>
            </div>
            <button type="button" class="btn-calc-reset" onclick="window.resetRakbaCalc();">
              <i class="fa-solid fa-rotate-left"></i> Reset
            </button>
          </div>

          <div class="calculator-inputs-grid">
            <!-- Murabba -->
            <div class="calc-box">
              <label for="calcMurabba">
                <span class="calc-label-title">Murabba (مربع)</span>
                <span class="calc-label-sub">= 25 Acres / قلعہ</span>
              </label>
              <div class="calc-input-wrap">
                <input type="number" id="calcMurabba" placeholder="0" min="0" step="0.1" oninput="window.convertRakba('murabba', this.value);" />
                <span class="calc-unit-pill">Murabba</span>
              </div>
            </div>

            <!-- Acre -->
            <div class="calc-box">
              <label for="calcAcre">
                <span class="calc-label-title">Acre / Qila (ایکڑ)</span>
                <span class="calc-label-sub">= 8 Kanals / کنال</span>
              </label>
              <div class="calc-input-wrap">
                <input type="number" id="calcAcre" placeholder="0" min="0" step="0.25" oninput="window.convertRakba('acre', this.value);" />
                <span class="calc-unit-pill">Acre</span>
              </div>
            </div>

            <!-- Kanal -->
            <div class="calc-box">
              <label for="calcKanal">
                <span class="calc-label-title">Kanal (کنال)</span>
                <span class="calc-label-sub">= 20 Marlas / مرلہ</span>
              </label>
              <div class="calc-input-wrap">
                <input type="number" id="calcKanal" placeholder="0" min="0" step="1" oninput="window.convertRakba('kanal', this.value);" />
                <span class="calc-unit-pill">Kanal</span>
              </div>
            </div>

            <!-- Marla -->
            <div class="calc-box">
              <label for="calcMarla">
                <span class="calc-label-title">Marla (مرلہ)</span>
                <span class="calc-label-sub">= 272.25 Sq Ft / فٹ</span>
              </label>
              <div class="calc-input-wrap">
                <input type="number" id="calcMarla" placeholder="0" min="0" step="1" oninput="window.convertRakba('marla', this.value);" />
                <span class="calc-unit-pill">Marla</span>
              </div>
            </div>
          </div>

          <!-- Calculated Foot & Yard Breakdown -->
          <div class="calc-results-row">
            <div class="calc-pill">
              <i class="fa-solid fa-ruler-combined" style="color: #F59E0B !important;"></i>
              <span>Revenue Sq Ft (272.25/M): <strong id="resSqFt">0</strong> sq ft</span>
            </div>
            <div class="calc-pill">
              <i class="fa-solid fa-layer-group" style="color: #3B82F6 !important;"></i>
              <span>Urban Standard (225/M): <strong id="resSqFtUrban">0</strong> sq ft</span>
            </div>
            <div class="calc-pill">
              <i class="fa-solid fa-vector-square" style="color: #10B981 !important;"></i>
              <span>Sq Yards (Gazz): <strong id="resSqYards">0</strong> yards</span>
            </div>
          </div>
        </section>

        <!-- Category Tabs -->
        <div class="category-tabs-container" id="categoryTabsContainer">
          {categoryTabs.map((tab, idx) => (
            <button
              type="button"
              class:list={['cat-tab-btn', { active: idx === 0 }]}
              data-cat={tab.key}
              onclick="window.selectCadastralCategory(this.getAttribute('data-cat'), this);"
            >
              <i class={tab.icon}></i>
              <span>{tab.label}</span>
              <span class="tab-count-badge">{tab.count}</span>
            </button>
          ))}
        </div>

        <!-- Directory Controls: Search & View Switcher -->
        <div class="directory-toolbar-card" id="directoryToolbar">
          <div class="toolbar-search-col">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input
              type="text"
              id="cadastralSearchInput"
              placeholder="Search by area name, Chak (e.g. 39/12-L), block, or road..."
              autocomplete="off"
              spellcheck="false"
              oninput="window.handleCadastralSearch(this.value);"
            />
            <button type="button" id="dirSearchClearBtn" class="dir-clear-btn" style="display: none;" onclick="window.clearCadastralSearch();">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>

          <div class="toolbar-actions-col">
            <!-- View Mode Switcher -->
            <div class="view-mode-toggle">
              <button type="button" class="view-btn active" id="btnViewCards" onclick="window.switchDirectoryView('cards');" title="Grid Card View">
                <i class="fa-solid fa-grip"></i>
                <span>Cards</span>
              </button>
              <button type="button" class="view-btn" id="btnViewTable" onclick="window.switchDirectoryView('table');" title="Simple Comparison Table">
                <i class="fa-solid fa-table-list"></i>
                <span>Table</span>
              </button>
            </div>

            <!-- Map Link -->
            <a href="/#areas" class="btn-toolbar-map" title="View Full Interactive Map">
              <i class="fa-solid fa-map-location-dot"></i>
              <span class="hide-mobile">Map View</span>
            </a>
          </div>
        </div>

        <!-- Showing Meta Summary Strip -->
        <div class="results-meta-strip">
          <span class="results-count-text">
            Showing <strong id="visibleCountLabel">{allEntries.length}</strong> of {allEntries.length} verified records
          </span>
          <span class="pagination-subtext" id="paginationSummaryText">
            (Page 1 of {Math.ceil(allEntries.length / 12)})
          </span>
        </div>

        <!-- VIEW 1: Clean Minimalist 3-Part Cards Grid -->
        <div class="cadastral-cards-grid" id="cadastralCardsContainer">
          {allEntries.map(entry => {
            const searchData = `${entry.name} ${entry.statusBadge} ${entry.categoryLabel} ${entry.parentChak} ${entry.rakbaPrimary} ${entry.streets}`.toLowerCase();

            return (
              <article
                class="cad-card"
                data-id={entry.id}
                data-category={entry.categoryKey}
                data-search={searchData}
              >
                <!-- 1. TOP: Area Name (Big & Bold) + 1 Clear Status Badge -->
                <div class="card-top-row">
                  <div class="card-title-group">
                    <h3 class="card-area-name">{entry.name}</h3>
                    <span class="card-parent-tag">{entry.parentChak}</span>
                  </div>
                  <span class:list={['status-pill', entry.statusClass]}>
                    <i class={entry.statusIcon}></i>
                    <span>{entry.statusBadge}</span>
                  </span>
                </div>

                <!-- 2. MIDDLE: 2 Clean Boxes Side-by-Side (Total Rakba & 2026 Market Rate) -->
                <div class="card-boxes-grid">
                  <!-- Box 1: Plot Sizes & Configuration -->
                  <div class="mini-spec-box rakba-box">
                    <span class="box-label">PLOT SIZES &amp; CONFIG</span>
                    <strong class="box-val">{entry.rakbaPrimary}</strong>
                    <span class="box-sub">{entry.rakbaSub}</span>
                  </div>

                  <!-- Box 2: 2026 Market Rate -->
                  <div class="mini-spec-box rate-box">
                    <span class="box-label">2026 MARKET RATE</span>
                    <strong class="box-val text-emerald">{entry.rate}</strong>
                    <span class="box-sub text-emerald">Verified Valuation</span>
                  </div>
                </div>

                <!-- 3. BOTTOM: 1 Simple Summary Line + "View Full Details & Map →" Button -->
                <div class="card-bottom-row">
                  <div class="card-summary-line">
                    <i class="fa-solid fa-road icon-gray"></i>
                    <span>{entry.streets}</span>
                  </div>

                  <button
                    type="button"
                    class="btn-card-details"
                    onclick={`window.openAreaModal('${entry.id}')`}
                  >
                    <span>View Full Details &amp; Map</span>
                    <i class="fa-solid fa-arrow-right"></i>
                  </button>
                </div>
              </article>
            );
          })}
        </div>

        <!-- VIEW 2: Clean Simple Table View (Toggleable) -->
        <div class="cadastral-table-card" id="cadastralTableContainer" style="display: none;">
          <div class="table-responsive">
            <table class="cadastral-table">
              <thead>
                <tr>
                  <th>Area / Scheme Name</th>
                  <th>Category</th>
                  <th>Legal Status</th>
                  <th>Plot Sizes &amp; Cuts</th>
                  <th>2026 Market Rate</th>
                  <th>Streets / Access</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="cadastralTableBody">
                {allEntries.map(entry => {
                  const searchData = `${entry.name} ${entry.statusBadge} ${entry.categoryLabel} ${entry.parentChak} ${entry.rakbaPrimary} ${entry.streets}`.toLowerCase();

                  return (
                    <tr
                      class="table-entry-row"
                      data-id={entry.id}
                      data-category={entry.categoryKey}
                      data-search={searchData}
                    >
                      <td class="col-name">
                        <strong class="table-area-title">{entry.name}</strong>
                        <span class="table-area-sub">{entry.parentChak}</span>
                      </td>
                      <td>
                        <span class="table-cat-badge">{entry.categoryLabel}</span>
                      </td>
                      <td>
                        <span class:list={['status-pill-sm', entry.statusClass]}>
                          <i class={entry.statusIcon}></i>
                          <span>{entry.statusBadge}</span>
                        </span>
                      </td>
                      <td class="col-rakba">
                        <strong class="table-rakba-val">{entry.rakbaPrimary}</strong>
                        <span class="table-rakba-sub">{entry.rakbaSub}</span>
                      </td>
                      <td class="col-rate text-emerald">
                        <strong>{entry.rate}</strong>
                      </td>
                      <td class="col-streets">
                        <span>{entry.streets}</span>
                      </td>
                      <td class="col-action">
                        <button
                          type="button"
                          class="btn-table-details"
                          onclick={`window.openAreaModal('${entry.id}')`}
                        >
                          <span>Details</span>
                          <i class="fa-solid fa-arrow-right"></i>
                        </button>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Clean Pagination Bar (12 Cards / Rows Per Page) -->
        <div class="pagination-bar" id="paginationBar">
          <div class="pagination-info">
            Showing <strong id="pageRangeStart">1</strong>–<strong id="pageRangeEnd">12</strong> of <strong id="totalMatchingCount">{allEntries.length}</strong> records
          </div>
          <div class="pagination-controls">
            <button type="button" class="btn-page-nav" id="btnPrevPage" onclick="window.changePage(-1);" disabled>
              <i class="fa-solid fa-chevron-left"></i> Previous
            </button>
            <div class="page-numbers-wrap" id="pageNumbersWrap">
              <!-- Dynamically populated via JS -->
            </div>
            <button type="button" class="btn-page-nav" id="btnNextPage" onclick="window.changePage(1);">
              Next <i class="fa-solid fa-chevron-right"></i>
            </button>
          </div>
        </div>

        <!-- Empty State -->
        <div id="dirEmptyState" class="dir-empty-state" style="display: none;">
          <div class="empty-icon-box">
            <i class="fa-solid fa-magnifying-glass"></i>
          </div>
          <h3>No Records Found Matching Filter</h3>
          <p>We couldn't find any colony, block, or village matching your search criteria. Try resetting the filter to explore all areas.</p>
          <button type="button" class="btn-empty-reset" onclick="window.clearCadastralSearch();">
            Reset All Filters &amp; View All Areas
          </button>
        </div>

        <!-- Executive Consultation Banner at Bottom -->
        <section class="cadastral-consult-banner">
          <div class="banner-body">
            <div class="banner-icon-side">
              <i class="fa-solid fa-file-shield"></i>
            </div>
            <div class="banner-text-side">
              <h3>Need Official Revenue Fard or Mutation (Intiqal) Verification?</h3>
              <p>
                Naeem Siddhu provides direct, on-ground verification through Sub-Registrar Office, Punjab Land Records Authority (PLRA Arazi Record Center Chichawatni), and TMA Sanction archives. Protect your family's life savings before paying token money.
              </p>
            </div>
            <div class="banner-cta-side">
              <a
                href="https://wa.me/923063996764?text=Assalam-o-Alaikum%20Naeem%20Sahab%2C%20I%20need%20on-ground%20Fard%20and%20Registry%20verification%20for%20a%20property%20in%20Chichawatni."
                target="_blank"
                rel="noopener"
                class="btn-banner-wa"
              >
                <i class="fa-brands fa-whatsapp"></i>
                <span>Consult Naeem Siddhu</span>
              </a>
              <span class="office-hint"><i class="fa-solid fa-location-dot" style="color: #EF4444 !important;"></i> Street 08, Tower Road Side, Hayat Abad</span>
            </div>
          </div>
        </section>

      </div>
    </main>

    <!-- CLEAN MODAL / SIDE DRAWER POPUP FOR DEEPER DETAILS -->
    <div class="area-modal-backdrop" id="areaModalBackdrop" style="display: none;" onclick="if(event.target === this) window.closeAreaModal();">
      <div class="area-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modalAreaTitle">
        
        <!-- Close Button -->
        <button type="button" class="modal-close-btn" onclick="window.closeAreaModal();" aria-label="Close modal">
          <i class="fa-solid fa-xmark"></i>
        </button>

        <!-- Header -->
        <div class="modal-header">
          <div class="modal-badges-strip">
            <span id="modalStatusBadge" class="status-pill pill-tma">
              <i class="fa-solid fa-circle-check"></i>
              <span>Status</span>
            </span>
            <span id="modalCategoryTag" class="modal-cat-tag">Category</span>
          </div>
          <h2 id="modalAreaTitle" class="modal-title">Area Name</h2>
          <p id="modalAreaSub" class="modal-sub">Parent Chak • Geographic Hub</p>
        </div>

        <!-- Body -->
        <div class="modal-body">
          
          <!-- Key Metrics Grid -->
          <div class="modal-specs-grid">
            <!-- Plot Sizes & Config -->
            <div class="m-spec-card">
              <span class="m-spec-label"><i class="fa-solid fa-shapes" style="color: #F59E0B !important;"></i> Plot Sizes &amp; Configuration</span>
              <strong id="modalRakbaVal" class="m-spec-value">Standard Plot Cuts</strong>
              <span id="modalRakbaSub" class="m-spec-sub">Verified Real-Estate Configuration</span>
            </div>

            <!-- 2026 Rate -->
            <div class="m-spec-card">
              <span class="m-spec-label"><i class="fa-solid fa-tag" style="color: #10B981 !important;"></i> 2026 Market Rate</span>
              <strong id="modalRateVal" class="m-spec-value text-emerald">Market Rate</strong>
              <span class="m-spec-sub text-emerald">Verified On-Ground Valuation</span>
            </div>

            <!-- Streets -->
            <div class="m-spec-card">
              <span class="m-spec-label"><i class="fa-solid fa-road" style="color: #64748B !important;"></i> Street / Road Width</span>
              <strong id="modalStreetsVal" class="m-spec-value">30ft Roads</strong>
              <span class="m-spec-sub">Paved Internal Streets</span>
