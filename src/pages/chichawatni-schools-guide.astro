---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/global/Breadcrumbs.astro';
import { business } from '@/data/business';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'City & Guides', url: '/chichawatni-city-guide.html' },
  { name: 'Schools & Colleges', url: '/chichawatni-schools-guide.html' }
];
---

<BaseLayout
  title="Schools & Colleges in Chichawatni | Educational Directory Guide"
  description="Verified directory of premier public schools, degree colleges, DPS, Superior College, Punjab College, and educational proximity for residential home buyers."
  canonical="https://siddhupropertyadvisor.com/chichawatni-schools-guide.html"
>
  <div class="container guide-page">
    <Breadcrumbs items={breadcrumbs} />

    <header class="guide-header-card">
      <div class="guide-badge">
        <i class="fa-solid fa-graduation-cap"></i>
        <span>Educational Directory</span>
      </div>
      <h1 class="guide-title">Schools & Colleges in Chichawatni</h1>
      <p class="guide-subtitle">
        Verified directory of premier public schools, degree colleges, private institutions, and educational proximity for residential home buyers in Chichawatni.
      </p>
    </header>

    <!-- Schools Grid -->
    <section class="content-section">
      <h2 class="section-heading">Key Educational Institutions</h2>
      <div class="schools-grid">
        <div class="school-card">
          <span class="card-badge highlight-teal">Public Higher Education</span>
          <h3 class="school-name highlight-gold">Govt Degree College (Boys & Girls)</h3>
          <p class="school-desc">
            The primary public higher education institutions offering Intermediate, FSc, FA, and Bachelor degree programs with historic campuses and sports grounds.
          </p>
          <ul class="school-list">
            <li><strong>Location:</strong> College Road Corridor</li>
            <li><strong>Programs:</strong> FSc Pre-Med/Engineering, ICS, FA, BA/BSc</li>
            <li><strong>Nearby Colonies:</strong> Model Town, Civil Lines, Block 2</li>
          </ul>
        </div>

        <div class="school-card">
          <span class="card-badge highlight-teal">Public & Semi-Govt Secondary</span>
          <h3 class="school-name highlight-gold">DPS & Govt High School No. 1</h3>
          <p class="school-desc">
            Divisional Public School (DPS) and historic Govt High Schools providing matriculation and intermediate science education to local students.
          </p>
          <ul class="school-list">
            <li><strong>Level:</strong> Primary to Higher Secondary</li>
            <li><strong>Location:</strong> GT Road & Civil Lines Sector</li>
            <li><strong>Nearby Colonies:</strong> Housing Colony, Hayat Abad</li>
          </ul>
        </div>

        <div class="school-card">
          <span class="card-badge highlight-gold">Private Educational Groups</span>
          <h3 class="school-name highlight-gold">Superior & Punjab Colleges</h3>
          <p class="school-desc">
            Modern private college campuses offering FSc, ICS, I.Com, and undergraduate degree programs with purpose-built facilities and transport buses.
          </p>
          <ul class="school-list">
            <li><strong>Facilities:</strong> Science Labs, Transport, AC Classrooms</li>
            <li><strong>Location:</strong> GT Road Bypass / College Road</li>
            <li><strong>Nearby Colonies:</strong> Chak 39/12-L, Garden Town</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- CTA Banner -->
    <section class="guide-cta-banner">
      <h3 class="cta-title">Looking for Family Houses Near Top Schools?</h3>
      <p class="cta-subtitle">Naeem Siddhu specializes in 5 Marla and 10 Marla family residences located within walking distance of leading schools and colleges in Chichawatni.</p>
      <div class="cta-actions">
        <a href={`tel:${business.phone}`} class="btn-primary">
          <i class="fa-solid fa-phone"></i>
          <span>Call Naeem Siddhu</span>
        </a>
        <a href={`https://wa.me/${business.phone.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener" class="btn-whatsapp">
          <i class="fa-brands fa-whatsapp"></i>
          <span>WhatsApp</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .guide-page {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }
  .guide-header-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 2.75rem 2rem;
    margin-bottom: 2rem;
    text-align: center;
  }
  .guide-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(184, 138, 59, 0.15);
    border: 1px solid rgba(184, 138, 59, 0.3);
    color: var(--accent-gold);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .guide-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }
  .guide-subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 780px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .content-section {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 2.25rem;
    margin-bottom: 2rem;
  }
  .section-heading {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1.5rem;
  }
  .schools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .school-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-control);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .card-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .school-name {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
  }
  .school-desc {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0 0 0.5rem;
  }
  .school-list {
    list-style: none;
    padding: 0;
    margin: auto 0 0 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }
  .school-list li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .school-list li:last-child {
    border-bottom: none;
  }
  .guide-cta-banner {
    background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-elevated) 100%);
    border: 1px solid rgba(184, 138, 59, 0.3);
    border-radius: var(--radius-card);
    padding: 3rem 2rem;
    text-align: center;
  }
  .cta-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
  }
  .cta-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 650px;
    margin: 0 auto 1.75rem;
  }
  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
